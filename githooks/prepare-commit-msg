#!/usr/bin/env python3
"""prepare-commit-msg — stamp the resumable session id onto every agent commit.

INSTALLED PER-CLONE into the repo's COMMON `.git/hooks/`, by
`scripts/install-session-stamp.sh`. It is NOT installed by `githooks/install.sh`
and that is deliberate: 🔴 that installer sets `core.hooksPath` GLOBALLY and, by
its own header, arms the devrc pre-push TEST GATE by default — the devrc#322
shape, where a pre-push hook that ran the suite in the worktree it was pushing
rewrote the branch. Stamping a trailer must not drag a test gate onto the box
with it.

WHAT IT ADDS. `Claude-Session-Id: <id>` — the runtime's own session handle, i.e.
what `claude --resume` takes. That is the half a future reader needs to go from
`git blame` to a live session.

🔴 WHAT IT DELIBERATELY DOES NOT ADD, AND WHY. The existing
`Claude-Session: https://claude.ai/code/session_01…` trailer is NOT emitted here,
because the hook layer never receives that token — MEASURED 2026-08-30, 69 of 69
per-session hook state dirs are uuid-shaped and ZERO are `session_…` tokens. The
two id spaces are disjoint and only the agent knows the claude.ai one. So the
split is: this hook makes the RESUMABLE id deterministic on every agent commit;
the claude.ai URL stays best-effort prose. Do not "fix" this by having the hook
synthesise a URL from the id — the resulting link would not resolve.

NO-OPS FOR HUMANS. A `git commit` typed in a terminal has no Claude ancestor, so
`lookup()` returns None and the message is left byte-identical. This hook adds
nothing to a human's commit.

🔴 FAILS OPEN. Any error leaves the message untouched and exits 0. A hook that
can refuse a commit is a worse defect than a missing trailer.
"""
from __future__ import annotations

import os
import sys


def _repo_lib_dir() -> str:
    """`scripts/lib/` of the DEVRC checkout that owns this hook.

    🔴 TWO DIFFERENT QUESTIONS, TWO DIFFERENT RESOLUTIONS — conflating them is a
    real bug this file shipped once and the seam test caught:

      * WHERE THE STATE LIVES is a property of the repo being committed to, so it
        is derived from this hook's INSTALLED path (`abspath`, symlink NOT
        followed) — see `main()`.
      * WHERE THE CODE LIVES is a property of devrc, so it is derived from the
        symlink TARGET (`realpath`, symlink followed).

    They coincide only when the repo being committed to IS devrc. Installed into
    any other repo, `abspath` arithmetic looks for `scripts/lib/` inside THAT
    repo, finds nothing, and the hook silently stamps nothing — green unit tests,
    dead feature. Installing as a symlink is what makes `realpath` able to answer
    the second question at all.
    """
    override = os.environ.get("DEVRC_SESSION_TRAILER_LIB")
    if override:
        return override
    # realpath: follow the install symlink back into the devrc checkout.
    source = os.path.realpath(__file__)
    devrc_root = os.path.dirname(os.path.dirname(source))
    return os.path.join(devrc_root, "scripts", "lib")


def main(argv) -> int:
    if len(argv) < 2:
        return 0
    msg_path = argv[1]

    sys.path.insert(0, _repo_lib_dir())
    try:
        import session_trailer as st
    except Exception:
        return 0

    # The common git dir is this hook's own grandparent — the same directory the
    # recording hook wrote into, for every worktree of this clone.
    common = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

    # 🔴 TEST-ONLY INJECTION, and it is what makes the SEAM testable in BOTH
    # gate tiers. Without it this hook's end-to-end behaviour could only be
    # exercised where a real Claude ancestor happens to exist — i.e. green on
    # this box and vacuously skipped in the nix sandbox, which is exactly the
    # config-blind suite RULES.md warns about. It selects WHICH state file is
    # read; it cannot supply or forge an id, since the id still comes from a
    # file that only the recording hook writes.
    injected = os.environ.get("DEVRC_SESSION_TRAILER_PID")
    try:
        pid = int(injected) if injected else None
    except ValueError:
        pid = None

    session_id = st.lookup(common, pid=pid)
    if not session_id:
        return 0

    try:
        with open(msg_path, "r") as fh:
            message = fh.read()
    except Exception:
        return 0

    stamped = st.append_trailer(message, session_id)
    if stamped == message:
        return 0

    try:
        with open(msg_path, "w") as fh:
            fh.write(stamped)
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception:
        sys.exit(0)
