# Managed skills ship as read-only store symlinks (see nix/home.nix). Keep this
# tree pure skill CONTENT — never commit installed-project cruft or secrets.
node_modules/
*.env
accounts.json
*.key
*.pem
.git/

# clickup skill state. It normally lives in $XDG_STATE_HOME/clickup (see
# clickup/lib/paths.mjs) — these entries exist so a LEGACY copy, or a stray
# `add-account`/listener run from inside the checkout, can never be staged into
# a PUBLIC repo. watchers.json carries each webhook's HMAC secret and .cache/
# the session JWTs; accounts.json (a live `pk_` token) is covered above.
watchers.json
.cache/
webhook-url.txt
webhooks.jsonl
webhook-latest.json
last-seen.txt
