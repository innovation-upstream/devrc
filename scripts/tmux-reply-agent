#!/usr/bin/env python3
"""tmux-reply-agent — the host half of clawgate's terminal WRITE surface.

WHAT THIS IS
------------
clawgate runs in a pod on the workbench cluster. tmux sockets are unix sockets on
the workbench and laptop HOSTS, and the deployment has no hostPath, no
hostNetwork, no hostPID and no nodeName, so the pod structurally cannot see them.
The read model solved that by PUSHING outbound (`tmux-snapshot-push.sh`); this is
the other direction, and it solves it the same way rather than by opening a port:
the agent holds an OUTBOUND short poll, claims work, executes it locally, and
reports back. No inbound access to either machine, and no credential for either
machine inside a pod on an unauthenticated LAN surface.

🔴 WHAT ONE DELIVERY ACTUALLY DOES: `tmux send-keys` into a named pane, followed
by Enter — OR, when the pane is showing a Claude Code `AskUserQuestion` menu, a
single DIGIT keypress for the row whose label the reply names, read off a
`capture-pane` of that pane rather than assumed (see "the AskUserQuestion menu
surface"). Both shapes are arbitrary command execution as the operator on this
host, and the second exists because the first delivered OPTION 1 for every
option the operator tapped: a menu discards typed characters and the Enter then
selects whatever row is highlighted. The
operator took that decision explicitly, with the blast radius stated — free text
into ANY pane, and clawgate presses Enter, because type-only makes remote
answering pointless. Everything defensive below exists because of that, not
instead of it.

🔴 IT IS ARMED, AND IT DOES EXECUTE WHAT THE QUEUE HANDS IT. It was inert until
BOTH of two independent switches were set, and both now are: the server's write
routes sit behind a FAIL-CLOSED wrapper that answers 503 until
CLAWGATE_TERMINAL_TOKEN is set on the POD (provisioned), and this unit is wired
into the user manager's default target only while `enableTmuxReplyAgent` is true
in `nix/home.nix` (true). Neither implies the other; both were deliberately off
in the change that introduced them.

🔴 DISARMING THE HOST HALF IS TWO STEPS. Flipping `enableTmuxReplyAgent` false
and shipping does NOT stop a running agent: the unit definition is emitted
unconditionally, so the flag only drops the `[Install]` block, and `sd-switch`
reads a CHANGED unit and plans Stop/Start — it restarts the process. Follow the
ship with `systemctl --user stop tmux-reply-agent` on BOTH hosts. Removing the
pod's secret is the other lever, and that one is immediate for every host.

A 503 is therefore no longer this agent's ordinary state. Since arming it means
the pod's secret was REMOVED — a change on the server, not the shipped state —
and it is logged once and backed off from rather than exited on.

🔴 AT MOST ONCE, NEVER AT LEAST ONCE. A retried `send-keys` runs a command twice.
The server's claim moves a row out of `pending` permanently, so a write this agent
claims and then fails to execute is LOST rather than repeated — and this agent
never retries a send, never re-claims, and never replays. That direction is
chosen: a lost reply is visible in the audit log (as `abandoned`, whose meaning is
"delivery UNKNOWN"), a duplicated command is not undoable.

🔴 THE REPLY TEXT IS CREDENTIAL-GRADE AND IS NEVER LOGGED HERE. A reply may
contain a secret the operator typed. It is passed to tmux as a single argv
element and reported to nobody; the audit log lives in the server's table, behind
the terminal token. `tests/test_tmux_reply_agent.py` pins that behaviourally.

Exit codes (distinct on purpose — "something went wrong" would not tell an
operator whether to look at credentials, at tmux, or at the server):
  0  clean shutdown on SIGTERM/SIGINT
  2  no usable credentials — a configuration error that cannot self-heal
  3  tmux is not usable on this host

Everything else — an unreachable server, a 503, a 401, a malformed body — is
BACKED OFF FROM RATHER THAN EXITED ON. This is a long-running unit, and a restart
loop against a transient condition is worse than a quiet one: it would fill the
journal and, once a failure toast is wired to it, defeat do-not-disturb 720 times
a day. The compensating control is that every one of those states is logged with
its reason and its backoff.
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request

_HERE = os.path.dirname(os.path.abspath(__file__))


def _load_tmux_text_policy(path: str = None):
    """Load `scripts/lib/tmux_text_policy.py` by EXPLICIT PATH.

    🔴 IT RAISES RATHER THAN FALLING BACK, and that is the whole point. A
    fallback would leave this program with a weaker check — which is exactly
    what shipped here before: a DENYLIST (`ord(ch) < 0x20 or ord(ch) == 0x7F`)
    that passed every C1 control and U+0085 NEL. `session-write` had already
    fixed that class and written down why; this file had its own copy and was
    wrong at the one site reachable from the network. The rule now lives in one
    module and a missing module stops the agent.
    """
    path = path or os.path.join(_HERE, "lib", "tmux_text_policy.py")
    loader = importlib.machinery.SourceFileLoader("_tra_tmux_text_policy", path)
    spec = importlib.util.spec_from_loader("_tra_tmux_text_policy", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


TEXT_POLICY = _load_tmux_text_policy()


def _load_transcript_stream(path: str = None):
    """Load `scripts/lib/transcript_stream.py` by EXPLICIT PATH.

    🔴 IT RETURNS None RATHER THAN RAISING, WHICH IS THE OPPOSITE OF THE POLICY
    LOADER ABOVE, AND THE ASYMMETRY IS THE POINT. The text policy is a SAFETY
    rule on the path that executes commands; a missing copy must stop the agent,
    because the alternative is running with a weaker check. Transcript streaming
    is a READ-MODEL nicety: it types nothing, runs nothing, and its absence costs
    freshness that the five-minute bulk push restores anyway. Letting it stop the
    write agent would trade a real capability for a cosmetic one.
    """
    path = path or os.path.join(_HERE, "lib", "transcript_stream.py")
    try:
        loader = importlib.machinery.SourceFileLoader("_tra_transcript_stream", path)
        spec = importlib.util.spec_from_loader("_tra_transcript_stream", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except Exception:  # noqa: BLE001 — see the docstring: never fatal
        return None


TRANSCRIPT_STREAM = _load_transcript_stream()


def _load_host_label(path: str = None):
    """Load `scripts/lib/host_label.py` by EXPLICIT PATH.

    🔴 IT RAISES RATHER THAN FALLING BACK, like the text policy and unlike the
    transcript tailer. The label decides which host's writes this agent claims: a
    fallback that guessed would make it deliver another machine's commands, or
    none at all. A missing module must stop the agent.
    """
    path = path or os.path.join(_HERE, "lib", "host_label.py")
    loader = importlib.machinery.SourceFileLoader("_tra_host_label", path)
    spec = importlib.util.spec_from_loader("_tra_host_label", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


HOST_LABEL = _load_host_label()

# Where the transcripts live. Overridable so the tests never touch the real one,
# and spelled the same way transcript-push.sh spells it so the two feeders agree
# about which files exist.
PROJECTS_DIR = os.environ.get("CLAUDE_PROJECTS_DIR") or os.path.expanduser("~/.claude/projects")

API_DEFAULT = "http://192.168.50.250:30302"
CONF_FILE = os.environ.get("CLAWGATE_CONF_FILE") or os.path.expanduser("~/.claude/clawgate.env")
# 🔴 THE PATH COMES FROM THE SHARED MODULE TOO, NOT JUST THE VOCABULARY. The
# consolidation re-exported HOST_NAMES and DEFAULT_LOCAL_HOST "rather than
# restating two literals" and left the THIRD literal — this path — restated. The
# consequence was measured: because local_host_label passes it as the default
# `env_file`, host_label.ACTIVITY_ENV (and HOST_LABEL_ENV_FILE with it) was DEAD
# for the agent, and pointing the module at a different file changed nothing here
# — 203/203 still passed. That is the exact axis that produced the round-2
# blocker: two feeders reading two files.
ACTIVITY_ENV = HOST_LABEL.ACTIVITY_ENV

# The host vocabulary the read model and the queue both use. `hostname` is
# "nixos" on BOTH machines, so it cannot be the source of truth; ACTIVITY_HOST is.
# 🔴 RE-EXPORTED FROM THE SHARED MODULE, NOT RESTATED. Two literals here and one
# rule there is the same drift this consolidation exists to end; the tests below
# read these names, so they must BE the module's values, not equal to them.
HOST_NAMES = HOST_LABEL.HOST_NAMES
# 🔴 THERE IS NO `DEFAULT_LOCAL_HOST` ANY MORE, AND ITS ABSENCE IS THE FIX.
# It was the literal `"workbench"`, returned whenever neither ACTIVITY_HOST nor
# the collector env file supplied a label — so on the LAPTOP this agent would
# have claimed the workbench's queue, polled a host nobody enqueues to, and
# delivered nothing, silently. `local_host_label()` now derives the label from an
# address this machine holds and RAISES when nothing does. See host_label.py.
HostLabelError = HOST_LABEL.HostLabelError

# The poll cadence. The server's write TTL is 90s, so this is ~18 polls inside a
# write's whole deliverable life: a reply typed on a phone lands within seconds,
# and an agent that misses a few ticks still has plenty of margin. Tighter buys
# nothing a human can perceive and multiplies the request count against a pod
# that is idle almost all the time.
POLL_SECONDS = float(os.environ.get("TMUX_REPLY_POLL_SECONDS", "5"))
# The backoff for every state that is not "a healthy empty queue": unreachable,
# 503 (the server's surface not armed — since arming, that means the pod's
# secret was REMOVED, i.e. somebody disarmed it), 401, a malformed body. Long
# enough that a pod being redeployed costs almost nothing.
BACKOFF_SECONDS = float(os.environ.get("TMUX_REPLY_BACKOFF_SECONDS", "60"))
HTTP_TIMEOUT = float(os.environ.get("TMUX_REPLY_HTTP_TIMEOUT", "20"))
# Bounds one `tmux send-keys`. It is a local unix-socket call that returns in
# milliseconds; anything near this means the tmux server is wedged.
TMUX_TIMEOUT = float(os.environ.get("TMUX_REPLY_TMUX_TIMEOUT", "10"))

# 🔴 THE TMUX SERVER IDENTITY, SPELLED THE SAME WAY THE COLLECTOR SPELLS IT.
# `session-manager` builds its `tmux_server_id` as "<pid>:<start_time>" from
# `#{pid}` and `#{start_time}` — both server-level tmux formats — and the enqueuer
# takes the expectation it sends us from that read model. Two spellings of one
# token would make this guard compare a value against a differently-shaped one
# and refuse EVERY write, which reads exactly like "the feature does not work".
# `test_tmux_reply_agent.py::test_the_server_id_format_matches_the_collectors`
# pins the two together against the collector's own source.
#
# It answers ONE question: did the tmux server restart since the enqueuer looked?
# It is NOT a timestamp — one host's start_time was measured 5.6 years wrong
# because tmux started before NTP sync — so equality is the only operation.
TMUX_SERVER_ID_FORMAT = "#{pid}:#{start_time}"


def log(msg: str) -> None:
    """One log line.

    🔴 NOTHING PASSED HERE MAY CONTAIN A WRITE'S TEXT. See the module header:
    the reply is credential-grade and the journal is not the audit log.
    """
    print(f"tmux-reply-agent: {msg}", flush=True)


# ── credentials ──────────────────────────────────────────────────────────────
def read_conf_key(key: str, path: str) -> str:
    """Read one KEY= value out of a sourceable env file.

    🔴 THE ANCHOR ACCEPTS THE TWO SPELLINGS A SOURCEABLE FILE ACTUALLY CARRIES —
    a leading `export ` and leading whitespace — and takes the LAST assignment,
    as sourcing would. `tmux-snapshot-push.sh` reads the same file and learned
    this the hard way: it anchored on a bare `^KEY=` while claiming to match
    shell sourcing, so adding `export ` to the file would have made that reader
    return empty forever while the hooks kept working. One file, several readers,
    silently disagreeing.

    Deliberate divergence from sourcing, same as the sibling's: a value is taken
    literally, so no `$VAR` expansion and no `#` comment stripping. Both would
    need a real parser, and this file holds a URL and opaque tokens.
    """
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return ""
    pattern = re.compile(r"^[ \t]*(?:export[ \t]+)?" + re.escape(key) + r"=(.*)$")
    value = ""
    for line in text.splitlines():
        m = pattern.match(line)
        if m:
            value = m.group(1).strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        value = value[1:-1]
    return value


def resolve(key: str, conf_file: str, env=None) -> str:
    """Environment first, then the file.

    🔴 THE ENVIRONMENT WINS, and that direction is load-bearing.
    `clawgate-stop-hook.sh` sources this same file with `set -a`, which makes the
    FILE beat the environment — the opposite of the documented precedence. The
    measured consequence over there: exporting CLAWGATE_API_URL to aim a probe
    somewhere harmless did nothing and the probe silently POSTed to PRODUCTION.
    On THIS surface the equivalent mistake would send a reply into a live pane.
    """
    e = os.environ if env is None else env
    v = (e.get(key) or "").strip()
    if v:
        return v
    return read_conf_key(key, conf_file)


def local_host_label(env=None, env_file: str = ACTIVITY_ENV) -> str:
    """This machine's ACTIVITY_HOST label — DELEGATED, not re-derived.

    🔴 THIS USED TO BE A SECOND COPY OF THE RULE, AND transcript-push.sh HELD A
    THIRD (in shell, falling through to `uname -n`, which is "nixos" on BOTH
    machines).

    ⚠ THEY NEVER AGREED — an earlier version of this sentence said "the three
    agreed while `host` was display-only". They did not: every stored transcript
    row said `host: nixos` while this agent called the same machine `workbench`,
    measured on the deployed server. What changed when the delta stream made
    `host` a correctness predicate was the COST of the disagreement, not its
    existence. host_label.py carries the measurement. `scripts/lib/
    host_label.py` carries the rule and the measurement; this wrapper stays only
    so the name and the tests that use it keep working.

    The server's termwrite queue is keyed on this label, so an agent computing a
    different one would poll for a host nobody enqueues to and deliver nothing,
    silently — which is why a wrapper is acceptable here and a fourth copy is not.
    """
    return HOST_LABEL.local_host_label(env=env, env_file=env_file)


# ── tmux ─────────────────────────────────────────────────────────────────────
def tmux_bin() -> str:
    return os.environ.get("TMUX_REPLY_TMUX_BIN", "tmux")


def run_tmux(args: list[str], env: dict[str, str] | None = None) -> tuple[int, str, str]:
    """Run one tmux command with an ARGV LIST and no shell.

    🔴 NO SHELL, EVER, AND THIS IS THE SINGLE MOST IMPORTANT LINE IN THE FILE.
    The text being delivered is arbitrary operator input. Interpolating it into a
    shell string — which is what `subprocess.run(..., shell=True)` or any
    `f"tmux send-keys ... {text}"` would do — turns `$(…)`, backticks, `;` and
    quotes into code that runs on THIS host with the operator's privileges,
    before tmux ever sees them. An argv list is passed to execve verbatim: there
    is no parser between this process and tmux.
    """
    try:
        p = subprocess.run([tmux_bin()] + args, capture_output=True, text=True,
                           timeout=TMUX_TIMEOUT, check=False, env=env)
    except subprocess.TimeoutExpired:
        return 124, "", f"tmux timed out after {TMUX_TIMEOUT}s"
    except OSError as exc:
        return 127, "", f"could not execute tmux: {exc}"
    return p.returncode, p.stdout, p.stderr


def tmux_server_id() -> str:
    """This host's live tmux server identity, or "" if it cannot be measured.

    An unmeasurable identity is NOT treated as a match — see should_refuse.
    """
    rc, out, _ = run_tmux(["display-message", "-p", TMUX_SERVER_ID_FORMAT])
    if rc != 0:
        return ""
    out = out.strip()
    # tmux renders an unknown format verbatim; a lone ":" means this tmux does
    # not know one of the two fields, which is "cannot measure", not an identity.
    return "" if out in ("", ":") else out


def should_refuse(expected: str, live: str) -> tuple[bool, str]:
    """The WRITE-TIME GUARD. Returns (refuse, reason).

    🔴 WHAT IT CLOSES, EXACTLY. Within one tmux server a pane id `%N` is never
    reused, so a stale one simply does not resolve and the send fails harmlessly.
    The dangerous case is a tmux server RESTART: ids are minted again from %0, so
    a `%12` the enqueuer saw an hour ago now names a completely different pane —
    and a submitted reply would execute there. Comparing the server identity the
    enqueuer recorded against the one running now refuses exactly that.

    🔴 AN ABSENT EXPECTATION IS NOT A MATCH, IT IS "NOT CHECKED", AND THAT IS
    DELIBERATE RATHER THAN LAX. The collector reports its `tmux_server_id` as
    UNMEASURED in real conditions (an older tmux, rows that disagree), so
    refusing every write that carries no expectation would make the feature fail
    exactly when the read model is degraded — while protecting against nothing,
    since a caller that cannot measure the id cannot supply a right one either.
    The audit row records the empty expectation, so "was this write guarded" is
    answerable after the fact rather than assumed.

    ⚠ WHAT IT DOES NOT CLOSE, stated because it is the residual the operator was
    told about: a pane that simply MOVED ON — same tmux server, same pane, the
    question already answered or the prompt gone. Nothing HERE can see that. The
    server's TTL bounds enqueue-to-delivery at 90s, and the attention queue
    retires stale questions off a 2-minute snapshot, so the exposed window is one
    snapshot interval of display staleness.

    ⚠ AND THAT PARAGRAPH USED TO END "closing it would need either a content
    fingerprint (brittle …) or type-only writes, which the operator declined" —
    which is now only half true, so it is corrected rather than left standing. A
    content read DOES happen, immediately before the send: `capture_pane` plus
    `classify_pane` answer one narrow question — is this pane a question MENU, and
    of which shape — because the answer decides which keys are correct at all.
    What was rejected is still rejected: no fingerprint decides whether the pane
    is "the same screen the enqueuer saw", precisely because its failure direction
    is refusing legitimate replies. So the MOVED-ON residual above stands
    unchanged for a text prompt; for a menu it is narrowed to the window between
    the capture and the keypress.
    """
    if not expected:
        return False, ""
    if not live:
        return True, "the tmux server identity could not be measured on this host"
    if expected != live:
        # 🔴 The reason names neither identity's provenance beyond the two opaque
        # tokens, and carries no pane content — it goes into the audit log and
        # into a log line.
        return True, f"tmux server identity moved (expected {expected}, live {live})"
    return False, ""


# ── HTTP ─────────────────────────────────────────────────────────────────────
class Refused(Exception):
    """A server answer that means "back off", carrying its reason."""


def post_json(url: str, token: str, payload: dict) -> dict:
    body = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=body, method="POST")
    req.add_header("Content-Type", "application/json")
    # 🔴 The token goes in a HEADER, never in the URL or in argv. Everything on
    # this box can read /proc/<pid>/cmdline, and a URL lands in access logs.
    req.add_header("Authorization", "Bearer " + token)
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            # 🔴 BOUNDED. A bare .read() takes whatever the peer sends, into the
            # memory of a process running on the operator's workstation.
            raw = resp.read(MAX_RESPONSE_BYTES)
    except urllib.error.HTTPError as exc:
        if exc.code == 503:
            # 🔴 THIS TEXT CHANGED MEANING WHEN THE SURFACE WAS ARMED. While the
            # feature shipped disabled a 503 was the ordinary state and the message
            # said so. It is now a STATE CHANGE: the pod's secret has been removed,
            # which is exactly how the server half is disarmed. Do not restore the
            # reassuring wording — an operator reading "normal" over a disarm is the
            # failure this line exists to prevent.
            raise Refused("the terminal write surface is NOT ARMED on the server "
                          "(HTTP 503) — CLAWGATE_TERMINAL_TOKEN is unset there. "
                          "This host IS armed, so that is a CHANGE on the server, "
                          "not the shipped state: the pod's secret was removed or "
                          "the deployment lost it.") from exc
        if exc.code == 401:
            raise Refused("the server rejected this agent's terminal token (HTTP 401)") from exc
        if exc.code == 404:
            raise Refused("the server has no terminal write route (HTTP 404) — it "
                          "predates the write surface, or has no database wired") from exc
        raise Refused(f"the server answered HTTP {exc.code}") from exc
    except urllib.error.URLError as exc:
        raise Refused(f"could not reach the server: {exc.reason}") from exc
    try:
        return json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as exc:
        raise Refused(f"the server's answer was not JSON: {exc}") from exc


def get_json(url: str, token: str) -> dict:
    """A bounded, bearer-authenticated GET.

    🔴 IT IS A SEPARATE FUNCTION RATHER THAN A `method=` ARGUMENT TO post_json,
    because post_json's HTTPError branches are written about the TERMINAL write
    surface — its 503 text asserts that the pod's terminal secret was removed.
    Reusing it for a read on the HOOK tier would make an ordinary hook-token
    problem report a disarmed write surface, which is the one message in this file
    that must never fire wrongly.
    """
    req = urllib.request.Request(url, method="GET")
    req.add_header("Accept", "application/json")
    req.add_header("Authorization", "Bearer " + token)
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            raw = resp.read(MAX_RESPONSE_BYTES)
    except urllib.error.HTTPError as exc:
        raise Refused(f"the server answered HTTP {exc.code} to a read") from exc
    except urllib.error.URLError as exc:
        raise Refused(f"could not reach the server: {exc.reason}") from exc
    try:
        return json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as exc:
        raise Refused(f"the server's answer was not JSON: {exc}") from exc


# ── delivery ─────────────────────────────────────────────────────────────────
# 🔴 THE HOST RE-VALIDATES EVERYTHING THE SERVER ALREADY VALIDATED, AND THAT IS
# NOT REDUNDANCY — IT IS THE TRUST BOUNDARY. The server is a pod on a cluster,
# reachable from an unauthenticated LAN NodePort; THIS process is the thing that
# actually runs commands as the operator. "One rule, one place" applies to two
# copies of a rule on the same side of a boundary; here the two sides fail
# independently, and the side that executes is the one that must refuse.
#
# The concrete cases, each of which the server also refuses:
#   * a pane that is not `%N` — tmux resolves a name-shaped target FUZZILY, so a
#     `scratch:1` would not fail, it would land in some other pane and run there.
#   * a control character in the text — `send-keys -l` writes a newline as a
#     newline, so one write becomes TWO submissions.
#   * a relative cwd — resolves against THIS process's directory, which differs
#     per host and per restart.
#   * an over-long batch — the server caps a claim at 4; a batch of a thousand
#     from a server that is wrong, compromised or simply newer is a thousand
#     commands, and nothing downstream would stop them.
PANE_ID_RE = re.compile(r"^%[0-9]{1,12}$")
#: A write id is minted by the server as base64url of 16 random bytes, and this
#: agent INTERPOLATES IT INTO A URL. Bounding and shaping it here is what stops a
#: server-supplied id from steering the request somewhere else (`../`, a query
#: string, a scheme) or from being unbounded text in a log line.
WRITE_ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
#: A tmux SESSION name, and deliberately narrower than tmux itself allows.
#: 🔴 tmux TARGET SYNTAX IS COMPOUND (`session:window.pane`), so a name carrying
#: `:` or `.` is a DIFFERENT ADDRESS and tmux resolves it somewhere the caller
#: did not choose rather than failing — the wrong-place class the pane rule
#: exists for, one level up: a whole WINDOW instead of a keystroke.
TMUX_SESSION_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_-]{0,63}$")
#: What `new-window -P -F` prints so the caller can check WHERE tmux actually
#: put the window. Tab-separated: none of the three fields can contain a tab
#: (a pane id is `%N`, a session name is checked against TMUX_SESSION_RE, and a
#: path containing a tab is refused by validate()).
NEW_WINDOW_FORMAT = "#{pane_id}\t#{session_name}\t#{pane_current_path}"
MAX_TEXT_BYTES = 2048
MAX_BATCH = 4
# Bounds the response body this agent will read. urlopen().read() with no
# argument reads whatever the peer sends.
MAX_RESPONSE_BYTES = 1 << 20


def validate(write: dict) -> str:
    """Return a refusal reason, or "" when this write is safe to execute here.

    🔴 THE TEXT GATE IS `tmux_text_policy`'s ALLOWLIST, NOT A LOCAL CHECK. See
    that module: the set of characters bound to an accept-line variant is a
    property of the OPERATOR'S shell config, which this process cannot read, so
    "is this character safe to deliver" is the only answerable question.
    """
    kind = write.get("kind") or KIND_SEND_KEYS
    # 🔴 TYPE BEFORE SHAPE, ON EVERY FIELD. Every value here comes off the wire
    # and none is guaranteed to be a string. Calling .strip() first raised
    # AttributeError out of validate -> out of deliver -> out of the whole round,
    # so neither this write NOR ANY LATER ONE in the batch got a result POSTed and
    # they all landed `abandoned` ("delivery UNKNOWN") when the truthful answer is
    # `refused`, nothing ran.
    if not isinstance(kind, str):
        return "the write kind is not a string"
    kind = kind.strip() or KIND_SEND_KEYS
    if kind not in (KIND_SEND_KEYS, KIND_NEW_SESSION):
        return f"unknown write kind {kind!r}"

    wid = write.get("id")
    if not isinstance(wid, str) or not WRITE_ID_RE.match(wid):
        # It goes into a URL this agent constructs; an id it cannot vouch for
        # could steer the request elsewhere.
        return "the write id is not the shape this agent will put in a URL"

    expect = write.get("expectTmuxServerId") or ""
    if not isinstance(expect, str):
        return "the expected tmux server id is not a string"
    text = write.get("text") or ""
    if not isinstance(text, str):
        return "the text is not a string"
    if len(text.encode("utf-8", "replace")) > MAX_TEXT_BYTES:
        return "the text is over the size limit"
    # 🔴 TAB IS REFUSED ON THIS SURFACE, THOUGH THE SHARED POLICY PERMITS IT, and
    # the divergence is deliberate rather than drift. `send-keys -l` delivers a
    # tab literally and a bash/zsh pane runs COMPLETION on it: `rm -rf ~/pro` plus
    # TAB becomes `rm -rf ~/projects/` in the buffer, and the Enter this path
    # presses submits THAT — while the clawgate audit row still says
    # `rm -rf ~/pro`. The server refuses it for the same reason; this is the
    # host-side half, so a server that has not been upgraded cannot deliver one.
    #
    # `session-write` keeps the tab, and that asymmetry is the point: it is
    # invoked by the operator AT THEIR OWN KEYBOARD, where the buffer is visible
    # before anything runs. Here the audit row IS the compensating control — it is
    # what answers "what did that write actually do" for a reply sent from a phone
    # — so a character that makes the row lie costs more than the typography is
    # worth. The shared policy stays as it is; this surface is stricter, which is
    # the safe direction for a divergence.
    if "\t" in text:
        return ("the text carries a tab, which shell completion would expand after the audit "
                "row was written")
    bad = TEXT_POLICY.first_disallowed(text)
    if bad is not None:
        return "the text carries " + TEXT_POLICY.describe_disallowed(*bad)
    if TEXT_POLICY.ends_with_separator(text):
        # tmux EATS a trailing separator off an argv token, so the pane would
        # receive something other than what the audit log records.
        return (f"the text ends with {TEXT_POLICY.TMUX_ARGV_SEPARATOR!r}, which tmux "
                "eats off the token — the pane would get something other than what "
                "the audit log records")

    if kind == KIND_SEND_KEYS:
        pane = write.get("pane") or ""
        if not isinstance(pane, str) or not PANE_ID_RE.match(pane):
            return "the target is not a tmux pane id of the form %N"
        if not text:
            return "the write carries no text"
    else:
        cwd = write.get("cwd") or ""
        if not isinstance(cwd, str) or not cwd.startswith("/"):
            return "the working directory is not an absolute path"
        if TEXT_POLICY.first_disallowed(cwd) is not None:
            return "the working directory carries a character that is not printable"
        if any(seg == ".." for seg in cwd.split("/")):
            return "the working directory contains `..`"
        # 🔴 A TRAILING SEPARATOR IS REFUSED HERE TOO. tmux eats it off the `-c`
        # word exactly as it does off a send-keys token, so a path ending in one
        # becomes a different path -- and if that does not exist, the window opens
        # in the home directory. The text path already refused this character; the
        # cwd path did not, which was the same character getting opposite
        # treatment in one file.
        if TEXT_POLICY.ends_with_separator(cwd) or cwd != cwd.strip():
            return ("the working directory ends with "
                    f"{TEXT_POLICY.TMUX_ARGV_SEPARATOR!r} or whitespace, which tmux eats "
                    "off the token")
        # 🔴 IT MUST EXIST ON THIS HOST. `new-window -c <missing path>` does NOT
        # fail -- measured rc 0, with the window opened in the home directory -- so
        # a build or a recursive delete would run there and be reported
        # `delivered`. The queue is host-keyed, so a path that exists on the
        # workbench and not the laptop is an ordinary mistake. open_window
        # re-checks where tmux ACTUALLY landed; this is the early, legible refusal.
        if not os.path.isdir(cwd):
            return "the working directory does not exist on this host"
        # 🔴 RE-VALIDATED HERE, NOT TRUSTED. The server checks it too; this
        # process is the one that hands the value to tmux as a target, and the
        # two sides of the boundary fail independently. Absent is fine — it means
        # "wherever this server considers current", which is the behaviour when
        # nobody expressed a preference.
        tmux_session = write.get("tmuxSessionName") or ""
        if not isinstance(tmux_session, str):
            return "the tmux session name is not a string"
        if tmux_session and not TMUX_SESSION_RE.match(tmux_session):
            return ("the tmux session name is not a bare session name — `:` and `.` make it "
                    "a compound tmux target, which resolves somewhere nobody chose")
    return ""


# The two things a write can ask for. Enumerated rather than pattern-matched: an
# unknown kind arriving from the server must be REFUSED, not guessed at — a
# guessed kind is a command nobody reviewed running on this host.
KIND_SEND_KEYS = "send-keys"
KIND_NEW_SESSION = "new-session"

#: See deliver(): a new-session's text is always submitted, whatever the row's
#: `submit` field says. Named so the behaviour is assertable rather than implied
#: by a bare literal in the middle of a function.
NEW_SESSION_ALWAYS_SUBMITS = True


def pane_path_env() -> str:
    """The PATH a LAUNCHED pane should run with, taken from the tmux server.

    🔴 WHY THE PANE CANNOT JUST INHERIT OURS. `new-window` runs the new pane with
    the environment of the process that asked for it — this agent — and under
    systemd that is the unit's deliberately minimal `Environment=PATH=` (coreutils
    + python3 + tmux). Measured on workbench 2026-09-07: a launched window ran
    `claude` and got `command not found`, its PATH exactly the unit's three
    entries, while `tmux show-environment -g PATH` on the same server was the
    operator's complete PATH. tmux was never the source; the caller was.

    🔴 THE SERVER'S GLOBAL ENVIRONMENT IS THE RIGHT SOURCE, AND THAT IS A
    DELIBERATE CHOICE OVER TWO ALTERNATIVES. Widening the unit's own PATH would
    grant this agent — which spawns shells as the operator — a larger environment
    for every purpose, to fix one. Spawning a login shell would run the
    operator's whole rc chain for a value we can read directly. The server's
    global PATH is what every window the operator opens by hand already gets, so
    a launched window becomes indistinguishable from a hand-opened one, which is
    the actual requirement.

    Returns "" when the server has no PATH to report — tmux prints `-PATH` for an
    unset variable — in which case the caller passes no `-e` and the pane behaves
    exactly as it did before this function existed. That is the pre-existing
    behaviour, not a new failure mode, and it stays diagnosable: the window opens
    and sits on `command not found` rather than vanishing.
    """
    rc, out, _ = run_tmux(["show-environment", "-g", "PATH"])
    if rc != 0:
        return ""
    line = out.splitlines()[0].strip() if out.strip() else ""
    # `-PATH` is tmux's spelling for "this variable is unset".
    if not line.startswith("PATH=") or len(line) == len("PATH="):
        return ""
    return line[len("PATH="):]


def open_window(cwd: str, tmux_session: str = "") -> tuple[str, str]:
    """Open a new tmux window at cwd, in tmux_session when one is named.

    🔴 WITHOUT `-t` THE TARGET IS DECIDED BY tmux, NOT BY THE CALLER. `new-window`
    with no target joins whatever session this server considers CURRENT — which
    depends on what the operator last looked at — so a launched window lands
    somewhere nobody chose.

    🔴 THE `=` PREFIX IS LOAD-BEARING: tmux PREFIX-MATCHES A SESSION NAME. An
    earlier revision passed `-t "<name>:"` and this docstring asserted that a
    missing session would make tmux FAIL. Measured on tmux 3.7c against the
    operator's live server — which holds `scratch`, `scratch2` ... `scratch20`
    and `datapacket-talos`, `datapacket-talos-2` — it does not fail. It
    prefix-matches and returns rc 0:

        -t scratch2:         (scratch2 absent, scratch20 live) -> rc 0, lands in scratch20
        -t datapacket-talos: (only ...-2 live)                 -> rc 0, lands in ...-2
        -t =scratch2:                                          -> rc 1, can't find session

    End to end that opened a window in the WRONG session, typed the command,
    pressed Enter and reported `delivered`. `=` forces an exact match, which is
    the only spelling that makes the sentence above true.

    🔴 AND WHERE IT LANDED IS READ BACK, NOT ASSUMED. `-c <path>` with a path that
    does not exist does not fail either: measured rc 0 with
    `pane_current_path=/home/zach`, i.e. the window silently opens in the home
    directory and a build or a recursive delete runs there. Three shape-valid
    inputs reach it — a path absent on THIS host (the queue is host-keyed, so a
    workbench path can be enqueued for the laptop), a trailing space, and a
    trailing separator, which tmux eats off the `-c` word.

    So the single `-P -F` prints the session and the working directory tmux
    ACTUALLY chose and the caller compares them. One call, no extra round trip,
    and it catches both classes — including any resolution rule nobody here has
    thought of.

    🔴 A TRANSPORT PRIMITIVE, NOT A FEATURE. "Start a Claude Code session" is
    entirely a question of what the caller's TEXT says; this only makes a window
    in the right directory and hands back its pane so the text can be typed there.
    Nothing about an agent session is encoded here, deliberately.

    `-P -F '#{pane_id}'` makes tmux PRINT the new pane's id, which is what lets
    the text be sent to THAT pane by id rather than to "the active pane" — the
    difference matters because between these two calls the operator may have
    switched windows, and a relative target would type into whatever they moved to.
    """
    argv = ["new-window", "-P", "-F", NEW_WINDOW_FORMAT, "-c", cwd]

    if tmux_session:
        # `=` forces an EXACT session match; the trailing colon means "this
        # session, next free index". Both are required — see the docstring.
        argv += ["-t", "=" + tmux_session + ":"]
    # 🔴 THE NEW PANE INHERITS THE ENVIRONMENT OF THE PROCESS THAT ASKS FOR IT,
    # WHICH IS THIS AGENT — and under systemd that is the unit's deliberately
    # minimal `Environment=PATH=` (coreutils + python3 + tmux). Measured on
    # workbench 2026-09-07: a launched window ran `claude` and got `command not
    # found`, its PATH exactly those three entries, while the same server's
    # `show-environment -g PATH` was the operator's complete PATH. tmux was never
    # the source; this caller was. See pane_path_env for why the server's global
    # PATH is the right value and why `new-window -e` is NOT the mechanism (it
    # does not reach the pane's environment on tmux 3.7c — measured).
    # 🔴 THE SERVER'S PATH FIRST, THIS UNIT'S APPENDED — and the order is the
    # whole design, not a style choice. Server-first is what makes a launched
    # window resolve `claude` the way a hand-opened one does. Appending our own
    # is what keeps `tmux` itself executable: this very process re-execs tmux
    # with this environment, so replacing PATH outright breaks the agent the
    # moment the operator's PATH happens not to carry tmux. Caught by
    # test_a_launched_pane_gets_a_PATH_THAT_CAN_FIND_claude, which uses a server
    # PATH that deliberately does not contain tmux.
    launch_env = None
    pane_path = pane_path_env()
    if pane_path:
        own = os.environ.get("PATH", "")
        launch_env = dict(os.environ,
                          PATH=(pane_path + os.pathsep + own) if own else pane_path)
    rc, out, err = run_tmux(argv, env=launch_env)
    if rc != 0:
        return "", (err or f"tmux exited {rc}")

    # 🔴 SPLIT THE LINE BEFORE STRIPPING IT. `out.strip()` removes a TRAILING
    # TAB, so a well-formed three-field line whose last field is empty —
    # `#{pane_current_path}` is empty until the pane's process cwd is readable —
    # arrives here as TWO fields and fails the length check below. The window
    # EXISTS by then: the caller got an error, a stray window was left behind,
    # and a retry would have made a second one. Measured as an intermittent
    # real-tmux failure, 3 occurrences in ~12 runs, the reported string
    # byte-identical to the good line after `.strip()`. Strip only the line
    # ending; strip the FIELDS individually afterwards.
    lines = out.splitlines() or [""]
    fields = lines[0].split("\t")
    if len(fields) != 3:
        return "", f"tmux did not report the new window's identity (got {out.strip()!r})"
    pane, landed_session, landed_path = (f.strip() for f in fields)
    if not pane.startswith("%"):
        return "", f"tmux did not report a pane id for the new window (got {pane!r})"

    # 🔴 EMPTY IS "NOT READABLE YET", NOT "THE WRONG DIRECTORY" — and the two must
    # not share a code path. `os.path.realpath("")` returns THIS PROCESS'S cwd, so
    # handing an empty value to same_directory() below compares a directory nobody
    # asked about and usually refuses, with a message naming a fallback that never
    # happened. Re-read the path for this specific pane instead; one extra call, in
    # the rare case only.
    if not landed_path:
        rc2, out2, _ = run_tmux(["display-message", "-p", "-t", pane,
                                 "#{pane_current_path}"])
        if rc2 == 0:
            landed_path = (out2.splitlines() or [""])[0].strip()
    if not landed_path:
        # Still unreadable. This agent presses Enter, so an unverifiable location
        # is a refusal, not a shrug.
        return "", ("tmux did not report the new window's directory, so where it "
                    "landed could not be verified")

    # 🔴 REFUSE ON A MISMATCH RATHER THAN TYPE INTO IT. Both checks are about one
    # thing: tmux resolved the target to something other than what was asked for,
    # and the next step presses Enter.
    if tmux_session and landed_session != tmux_session:
        return "", (f"tmux opened the window in session {landed_session!r}, not the requested "
                    f"{tmux_session!r}")
    if not same_directory(landed_path, cwd):
        return "", (f"tmux opened the window in {landed_path!r}, not the requested {cwd!r} — "
                    "the directory does not exist on this host, so tmux fell back")
    return pane, ""


def same_directory(a: str, b: str) -> bool:
    """Whether two paths name the same directory, resolving symlinks.

    `realpath` BOTH sides: a trailing slash and a symlinked parent are ordinary,
    and a raw string comparison would report a false mismatch and refuse a
    legitimate write.
    """
    try:
        return os.path.realpath(a) == os.path.realpath(b)
    except OSError:
        return False


# ── the AskUserQuestion menu surface ─────────────────────────────────────────
# 🔴 THE DEFECT THIS CLOSES, MEASURED. `send-keys -l -- '<text>'` followed by
# `send-keys Enter` is correct against a TEXT prompt and WRONG against a Claude
# Code `AskUserQuestion` menu: the menu DISCARDS typed characters — no filter, no
# selection, the cursor unmoved — and the Enter then selects whatever row is
# HIGHLIGHTED, which on a freshly rendered menu is option 1. Reproduced live on
# Claude Code 2.1.232 against a one-question ask offering Postgres/SQLite:
#
#     tmux send-keys -t %176 -l -- 'SQLite'
#     tmux send-keys -t %176 Enter
#     -> ● User answered Claude's questions:
#          ⎿  · Which database should the queue use? → Postgres
#
# ⚠ THAT QUOTE IS PRETTY-PRINTED AND THE REAL BYTES ARE NOT. The spaces after `●`
# and around `·` are NON-BREAKING (`\xa0`), measured byte-exact in live scrollback
# — so a reader built by copying the two lines above matches NOTHING. Anything that
# parses this render must go through `menu_answer_records`, which normalises
# whitespace instead of pattern-matching the pretty form.
#
# So EVERY option the operator tapped delivered option 1, and the card reported
# `Delivered`. clawgate's own rationale (internal/ui/reply.go: "send the option's
# LABEL verbatim, never its index") assumed a text prompt; it is still the only
# thing on the wire — `data-reply-option` is a render-time data attribute for test
# handles and the route never reads it — so the LABEL is what this agent matches
# on, and the index it presses is READ OFF THE PANE rather than assumed.
#
# 🔴 A WRONG ANSWER IS WORSE THAN NO ANSWER, and that orders every branch below.
# Where the pane cannot be read, or can be read and is a shape this agent cannot
# drive correctly (a multi-question chain, a multiSelect list, a numbered menu it
# does not recognise), it SENDS NOTHING and refuses with a named reason. The
# at-most-once ladder above is untouched: no path here retries, re-sends or
# re-claims, and an unverified outcome is reported `failed` — which the audit log
# reads as delivery UNKNOWN — never optimistically as `delivered`.
MENU_CURSOR = "❯"                              # ❯, the cursor row marker
MENU_QUESTION_MARKS = ("☐", "☒")          # ☐ / ☒, one per question
MENU_SUBMIT_TAB = "✔ Submit"                   # ✔ Submit, the multi-question tab
MENU_REVIEW_HEADING = "Review your answers"         # the multi-question end screen

# ── the footer: the ONLY modal signal that survives a short pane ──────────────
# 🔴 EVERY OTHER SIGNAL THIS FILE HAD RENDERS AT THE **TOP** OF THE MODAL AND
# SCROLLS OUT OF A SHORT VIEWPORT, WHILE `capture_pane` READS THE VIEWPORT ONLY.
# The tab strip, the `☐` markers and the `Review your answers` heading all sit
# above the option rows; the footer is the modal's LAST line, so it is the last
# thing a short pane clips. MEASURED live on Claude Code 2.1.232 by raising a
# real modal in a scratch tmux session and RESIZING THE WINDOW — not by
# truncating a capture, which is a simulation: the TUI re-renders to fit, and it
# scrolls its own option list rather than simply losing lines.
#
#     a real ONE-question ask, 104 columns, window resized to each height
#     ──────────────────────────────────────────────────────────────────────
#     40 32 28 24 20 16  ->  menu            (driven by digit; correct)
#     15 14             ->  menu            (correct, but only 2 of 6 rows
#                                            parse, so most replies refuse)
#     13 12 11 10       ->  text   🔴 TYPED THE REPLY INTO A LIVE MODAL
#
#     a real TWO-question chain, same pane, same method
#     ──────────────────────────────────────────────────────────────────────
#     40 32 28 26 24 20 16 -> multi-question (refused; correct)
#     15 14                -> menu   🔴 ANSWERED QUESTION 1 AND REPORTED
#                                       `delivered` WITH THE CHAIN STILL OPEN
#     13 12 11 10          -> text   🔴 TYPED THE REPLY INTO A LIVE MODAL
#
# The footer was present in ALL 24 of those captures, at every height, in both
# shapes. 5 of the 57 live panes on this host are 28 lines or shorter and one is
# 21, so the clipped band is not hypothetical.
#
# 🔴 AND IT COMES IN TWO SPELLINGS, ONE PER SHAPE — which is the fact that makes
# it close the CHAIN case too, and the fact an earlier round got wrong. The
# review that proposed this signal quoted `Enter to select · Tab/Arrow keys to
# navigate · Esc to cancel` as "the modal's footer". That is the CHAIN's footer.
# A one-question ask renders `Enter to select · ↑/↓ to navigate · Esc to cancel`
# — measured — so requiring the chain string would have refused every
# single-question modal and left the whole feature inert.
#
# 🔴 AND `Enter to select` IS **NOT** A DISCRIMINATOR — AT LEAST FOURTEEN OTHER
# CHOOSERS SPELL IT (at least, because the enumeration below is a floor and the
# retraction further down says why),
# AND SEVEN OF THOSE ALSO CARRY THE SINGLE-QUESTION NAV HINT, WHICH IS
# WHAT MADE THEM DRIVEABLE. (Two of the seven were caught LIVE; the other five
# came out of the enumeration below, which is the point of enumerating.) An earlier
# round of this file asserted "None of the three carries `Enter to select`. That
# is the whole discriminator", and that sentence was false about the shipped
# binary at the moment it was written. Measured two ways:
#
#   * LIVE: `/sandbox` renders `←/→ to switch · ↑/↓ to navigate · Enter to
#     select · Esc to close` over `1. Sandbox BashTool, with auto-allow` /
#     `2. … regular permissions` / `❯ 3. No Sandbox ✔`, and `/permissions` with
#     its rule list focused renders `↑/↓ to navigate · Enter to select · ←/→ to
#     switch · Esc to cancel` over `❯ 1.   Add a new rule…` plus rows 2-9. Both
#     satisfied the old substring pair and both classified `menu` — and a reply
#     naming a row DID press its digit: reproduced in-process against the previous
#     round's own code, `send-keys … 1` sent and the result reported `delivered`,
#     for both dialogs. That CHANGES THE SANDBOX MODE, or opens "Add a new rule…"
#     — and that row ends in `…`, so `label_matches`' truncation rule accepted ANY
#     reply beginning `Add a new rule`. Neither was shown to the operator.
#     ⚠ The two CAPTURES were taken by the review round, not by this one; what
#     this round measured is the delivery above and the literals below.
#   * STRUCTURALLY, which is what makes the enumeration below more than a list of
#     sightings — but NOT closed; see the retraction below. The string is not a
#     literal in the ask's renderer: the
#     footer is assembled from a `<chord>`/`<action>` component joined with ` · `,
#     so the question "which footers can say `Enter to select`" is answerable
#     over the shipped bundle. On Claude Code 2.1.232
#     (`…/claude-code-2.1.232/bin/.claude-wrapped`):
#
#         grep -aoP 'chord:"enter",action:"select"'        -> 14 component sites
#         grep -aoP '.{0,120}Enter to select.{0,120}'      ->  2 whole literals
#
#     …and the two literals are exactly the `/permissions` and `/sandbox` footers
#     above. SIXTEEN footers are what THOSE TWO GREPS FIND — a floor, not the set;
#     the retraction below names seven more the greps are structurally blind to.
#     Of the 14 component sites, TWO are AskUserQuestion renderers (the ledger
#     below); the other 12 are MCP/tool/model/resume choosers whose own field
#     lists differ, and FIVE of those 12 put `↑/↓ to navigate` immediately before
#     the anchor — so of the 14 NON-asks these greps find, SEVEN also carried the
#     nav hint and were admitted by the substring pair, not the two that were
#     found by looking.
#     ⚠ THREE NUMBERS, KEPT APART, BECAUSE COLLAPSING THEM IS HOW THIS COMMENT WAS
#     FIRST WRITTEN WRONG: these greps find 16 that can spell the anchor, 14 of
#     those are not asks, and 7 of the 14 were driveable. A draft said "seven other
#     choosers spell it, two of them with the nav hint" — which contradicted its
#     own next paragraph.
#
# 🔴 SO THE GUARD IS THE WHOLE FOOTER, FIELD BY FIELD, NOT A WORD IN IT. The
# permitted field set below is transcribed from the two ask renderers, and the
# ONE free slot is the editor name. A field the set does not name — `←/→ to
# switch`, `Esc to close`, `↓ to select`, `n/N to navigate` — makes the footer
# not an ask's, whatever else it spells.
#
# 🔴 THE SET IS **NOT** CLOSED, AND THE SENTENCE THAT SAID IT WAS IS RETRACTED.
# This paragraph used to read "the grep above finds every site that can produce
# the anchor". That is FALSE. `grep 'chord:"enter",action:"select"'` finds sites
# that name the anchor as a LITERAL chord/action PAIR, which is the only shape it
# can see — not every path that can PRODUCE `Enter to select`. At least two other
# composition paths exist in this same bundle, both found by reading the renderer
# rather than by grepping harder:
#
#   * `lo({action,context,fallback,description})` renders
#     `nt({chord: WT(action,context,fallback), action: description})`, and `WT`
#     returns the FALLBACK when that action has no configured keybinding. SIX
#     sites pass `fallback:"Enter", description:"select"` — six anchor producers
#     whose chord is a VARIABLE at the call site and whose action is a prop.
#   * the generic scrollable picker DEFAULTS its action —
#     `qJl = hfw === void 0 ? "select" : hfw`, rendered
#     `nt({chord:"enter", action: <that>})`. A seventh, computed.
#
# So at least 23 SITES in 2.1.232 can spell the anchor, not 16, and no
# enumeration written here is provably complete: a third composition path would
# be invisible to the same greps. Say it is unestablished rather than reach for a
# replacement argument — reaching is what produced the retracted sentence.
#
# 🔴 SO THE SAFETY RESTS ON THE **GRAMMAR**, NOT ON THE ENUMERATION — and that is
# a measurement, not a consolation. Every FOOTER those seven sites render was
# driven through `menu_footer`, bare and inside a pane capture — seven sites are
# FIVE strings, because `lo` sites 1-4 all render `Enter to select · Esc to go
# back` and the picker has two width-dependent shapes — and every one resolves
# FOOTER_UNKNOWN; the positive control is ask renderer 1 -> FOOTER_SINGLE. WHICH
# RULE REFUSES EACH, measured by walking the reader's own branches rather than
# inferred: all six `lo` footers on the LAST-field rule (`Esc to go back` is not
# the ask's terminator, so the run never reaches one and stops at the anchor); the
# picker on the FIRST-field rule at >= 120 columns (its nav field renders BEFORE
# the anchor) and on the NAV-COUNT rule below that width, where the nav field
# reads `↑/↓ to nav` and is not a field this file names at all. The
# permitted field set is transcribed from the two ask RENDERERS, so a field it
# does not name refuses whatever produced it. That is why the reader is safe over
# a set nobody can close — and why `ASK_FOOTER_LEDGER` is a corpus of MEASURED
# VERDICTS rather than a completeness proof.
#
# ⚠ AND IT IS NOT CLOSED ACROSS VERSIONS EITHER — a reworded render is a field the
# set does not name — and there the guard FAILS SAFE the same way: an
# unrecognised field resolves to FOOTER_UNKNOWN and REFUSES, so the feature goes
# inert with a named reason rather than driving a chooser it misread. That is the
# same trade `MENU_FREE_TEXT_LABELS` documents below.
MENU_FOOTER_SELECT = "Enter to select"
#: How `Nr` joins the footer's fields. A wrap breaks at a space, so joining the
#: capture's lines with a single space restores the field string exactly — which
#: is why the reader normalises the whole capture instead of reading one line.
MENU_FOOTER_SEP = " · "
#: `Tab` switches QUESTION TABS, so this spelling is itself a chain signal, and
#: unlike the tab strip it is at the bottom of the modal and survives clipping.
MENU_FOOTER_NAV_CHAIN = "Tab/Arrow keys to navigate"
#: One question: there are no tabs to Tab between, so the nav hint names the
#: arrow keys only. Measured with and without the free-text row focused — that
#: render inserts `ctrl+g to edit in Nvim` and keeps both anchors.
MENU_FOOTER_NAV_SINGLE = "↑/↓ to navigate"
#: 🔴 THE SECOND ASK RENDERER'S OWN CHAIN SIGNAL, AND NOTHING IN THIS FILE COULD
#: SEE IT BEFORE. An ask whose options carry a `preview` renders a different
#: modal — two columns, a `Notes:` field — whose footer is `Enter to select · ↑/↓
#: to navigate · n to add notes · [Tab to switch questions] · [ctrl+g to edit in
#: <editor>] · Esc to cancel`. Its chain marker is `switch questions`, NOT
#: `Tab/Arrow keys to navigate`, so a MULTI-question preview ask read
#: FOOTER_SINGLE under the substring pair. Matched on the lowercase tail so the
#: chord's own capitalisation is not a second thing to be wrong about.
MENU_FOOTER_SWITCH_QUESTIONS = "to switch questions"
#: Variant B's other field, and the one that DISQUALIFIES it from being driven.
#: Not a chain signal — a ONE-question preview ask carries it too — but in that
#: renderer a digit reaches the SAME handler the arrow keys reach and selects
#: NOTHING (the standard render's digit selects and advances), so a digit there can
#: never answer. ⚠ Named by what the code DOES, not by a symbol name: the bundle is
#: minified, so the function has no readable name to quote and inventing one would
#: be a claim about source nobody can check. It is a permitted field so the run can
#: span it and then be refused ON it; see `menu_footer`.
MENU_FOOTER_ADD_NOTES = "n to add notes"
#: The ask footer's required LAST field. `Esc to close` (the `/sandbox` picker),
#: `Esc to back`, `Esc to go back`, `Esc to clear` and `Esc to continue` are each
#: some other chooser's terminator, so this is a positive requirement rather than
#: decoration.
MENU_FOOTER_CANCEL = "Esc to cancel"
#: The one slot whose text is not fixed: the editor name is interpolated
#: (`edit in ${editor}`), so this is matched as a PREFIX and the tail is free.
MENU_FOOTER_EDIT_PREFIX = "ctrl+g to edit in "

#: What `menu_footer` can answer. 🔴 THE DRIVING PATH REQUIRES `FOOTER_SINGLE`,
#: i.e. POSITIVE evidence of a one-question ask, rather than the ABSENCE of a
#: chain signal. Concluding "single" from an absence is the A1 defect's own
#: shape, and RULES.md names it: an empty result cannot distinguish two
#: mechanisms. So an `Enter to select` footer whose FIELD LIST this file does not
#: recognise resolves to FOOTER_UNKNOWN and REFUSES.
FOOTER_NONE = ""
FOOTER_SINGLE = "single"
FOOTER_CHAIN = "chain"
FOOTER_UNKNOWN = "unknown"

#: 🔴 WHAT A **NON**-AskUserQuestion CURSORED NUMBERED MENU RENDERS INSTEAD, AND
#: WHY THE FOOTER HAD TO BECOME A PRECONDITION RATHER THAN ONLY A WIDENING. Five
#: live renders were captured, all of them classified `menu` by the shipped code
#: and all of them answerable by digit:
#:
#:   * the tool-approval prompt — `❯ 1. Yes` / `2. Yes, allow all edits during
#:     this session (shift+tab)` / `3. No`, footer `Esc to cancel · Tab to
#:     amend`. A reply of `Yes` pressed 1 and **APPROVED A TOOL CALL THE OPERATOR
#:     NEVER SAW**; `No` pressed 3 and denied it. BOTH directions were
#:     deliverable, because `No` is a bare label here — an earlier round believed
#:     the deny row always carried a suffix, and that is false for this render.
#:   * the trust-this-folder dialog and the bypass-permissions warning — footer
#:     `Enter to confirm · Esc to cancel`, and the second one is INVERTED
#:     (`❯ 1. No, exit` / `2. Yes, I accept`), so a reply of `Yes` would have
#:     pressed 2 there and 1 on the first.
#:   * 🔴 `/sandbox` and `/permissions`, WHICH DO CARRY `Enter to select` — see
#:     the section above. These two are why the guard reads the whole field list:
#:     the first three are refused by the ABSENCE of the anchor, and an absence
#:     was never going to be enough.
#:
#: ⚠ `Enter to confirm` USED TO BE A NAMED CONSTANT HERE AND IS NOT ANY MORE. It
#: was referenced from one comment and no code, and the reader no longer asks
#: about it at all: a footer whose fields are not the ask's is refused whatever
#: its confirm wording is, so a constant naming one such wording would be a guard
#: that guards nothing. The measured render stays written down, right here.

#: The render the pane leaves once an ask has been ANSWERED. MEASURED byte-exact
#: in live scrollback on 18 of 57 panes, and again by answering a scratch modal
#: with a digit: `●\xa0User answered Claude's questions:` then
#: `  ⎿\xa0·\xa0<question> → <chosen label>` (NBSPs, and the question/answer wrap
#: across continuation lines). ⚠ THE QUOTE AT THE TOP OF THIS SECTION WRITES
#: THOSE AS ORDINARY SPACES and is therefore not matchable as-is — which is why
#: this is a heading substring plus a joined-and-normalised read rather than a
#: literal, and why `normalise_label` is what does the joining (`str.split()`
#: treats `\xa0` as whitespace).
#:
#: 🔴 AND THE PREVALENCE FIGURE IS A **SCROLLBACK** ONE. `capture_pane` reads the
#: VIEWPORT (`capture-pane -p`, no `-S`), so a scrollback count is not a count of
#: what this code sees. RE-MEASURED 2026-09-19 over all 58 live panes on this host,
#: both scopes, with this module's own reader:
#:
#:     viewport                 heading present on  0 panes, 0 records parsed
#:     2000 lines of scrollback heading present on 19 panes, 19 records parsed
#:
#: RE-MEASURED AGAIN the same day with the same script: 55 panes, heading on 19 in
#: scrollback, 0 in any viewport, 36 records parsed. So the NUMERATOR held across
#: two sweeps and the DENOMINATOR did not — panes come and go, and `19 of 58` was
#: a fleet snapshot the moment it was written. The numerator is the figure this
#: file rests on; the denominator is written as "on this host" elsewhere for that
#: reason. (An audit block circulating alongside this work said 21; two sweeps say
#: 19, so 19 is the figure.)
#:
#: (The earlier `18 of 57` was the scrollback number; the fleet has moved by one
#: pane and one record since.) WHAT THAT CHANGES AND WHAT IT DOES NOT: the
#: BOTTOM-MOST rule and the pre-keypress baseline are still the right design — a
#: stale record CAN scroll into the viewport, OR FINISH DRAWING THERE while a
#: modal is up, and `menu_settled` reads the pane repeatedly while a modal closes
#: and the transcript reflows — but the justifying sentence must not cite a
#: scrollback figure as if it were the viewport rate. The honest form is: NO
#: viewport on this host carries one RIGHT NOW, 19 panes have one within a
#: screenful or two of history, and the guard is built for the second.
#: 🔴 AND THAT "CAN SCROLL IN" SENTENCE IS THE ONE `menu_answer_records_for_this_ask`
#: USED TO CONTRADICT. It claimed any record appearing after an empty baseline IS
#: this ask's, which cannot both be true — see that function for the retraction and
#: the reproduction. This sentence is the correct one of the two.
MENU_ANSWERED_HEADING = "User answered Claude's questions"
MENU_ANSWERED_ARROW = "→"
#: 🔴 WHAT ENDS THE ANSWERED BLOCK, AND IT IS NOT "A LINE THAT STARTS AT COLUMN 0".
#: That was the first rule written here and it was WRONG on real data: the
#: question text WRAPS at the terminal width, so a continuation begins at column 0
#: with an ordinary letter. MEASURED — of the 18 panes whose SCROLLBACK carried an
#: answered record, that rule read the record on 17 and returned EMPTY on the one
#: whose question wrapped mid-word (`… entirely a st` / `ale base. I`). So the block
#: ends at a line opening a NEW top-level render, identified by its glyph.
#: ⚠ SCROLLBACK, AND THE WORD MATTERS — see MENU_ANSWERED_HEADING for why the
#: viewport count is 0 and what that does and does not license.
#: ⚠ Losing a record is the safe direction (the absence rule stands, so a good
#: delivery reads UNKNOWN rather than a wrong one reading delivered) — but it is
#: still a cost, which is why this is measured against the live corpus and not
#: reasoned about.
#: ⚠ `·` is NOT in this set, deliberately: it opens the SECOND and later records of
#: a CHAIN (`     · Which region? → …`), so stopping on it would silently truncate a
#: chain's record list to its first answer.
#: 🔴 THE SPINNER FRAMES ARE THE WHOLE SET, ENUMERATED FROM THE BINARY RATHER THAN
#: FROM SIGHTINGS — and this list used to hold TWO OF THE SEVEN. Claude Code
#: 2.1.232 picks its frames by `$TERM`:
#:
#:     xterm-ghostty -> ["·", "✢", "✳", "✶", "✻", "✻"]
#:     everything else -> ["·", "✢", "*", "✶", "✻", "✽"]
#:
#: so the union is `· ✢ ✳ * ✶ ✻ ✽`, of which only `✻` and `✽` were here. A
#: read-only sweep of all 58 live panes (2000 lines of scrollback each) found `✶`
#: twice and `✢` once at COLUMN 0, which is how the gap was noticed; the binary is
#: what makes the fix complete instead of two more sightings.
#: ⚠ AND `·` IS IN THE FRAME SET TOO, so that exclusion is now a NAMED RESIDUAL
#: rather than a free choice: a spinner caught on its `·` frame does not end the
#: block. The chain's record separator wins, because truncating every chain to its
#: first answer is the worse of the two, and the direction of the loss here is the
#: safe one (a lost record reads UNKNOWN, never a wrong answer).
#: ⚠ NOT EVERY COLUMN-0 GLYPH ON THE BOX IS HERE, deliberately. The same sweep saw
#: `※` (118), `╌` (66), `—` (28), `▝` (22), `└` (12), `⚠` (11) and several emoji at
#: column 0 — none of them a Claude Code top-level render (they are bar scripts and
#: agent output), so adding them would widen this on a coincidence rather than on
#: the renderer.
MENU_ANSWERED_STOP_GLYPHS = ("●", "⏺", "✻", "✽", "✶", "✢", "✳", "*", "❯", "─", "╭", "│", "╰")
#: A sanity bound so a capture with no closing glyph cannot swallow the pane.
MENU_ANSWERED_MAX_LINES = 40
#: A multiSelect list renders `[ ]` / `[x]` rather than a numbered single choice.
#: ONE spelling of "a checkbox", used to build the ROW pattern below.
MENU_CHECKBOX = r"\[[ xX✔✓]\]"
#: One numbered option row: an optional cursor, a number, a dot, the label.
#: ⚠ `scripts/session-manager` OWNS A SECOND PREDICATE OVER THE SAME BYTES —
#: `_MENU_SELECTED_RE` / `_MENU_OPTION_RE`, deciding "is a modal up" for its
#: `waiting` signal, with the measured render facts in
#: `claude/skills/session-manager/reference/waiting-signal.md`. They are NOT
#: merged: that one feeds a signal with a measured 11/11 precision and changing it
#: belongs in its own PR. What IS pinned is the RELATIONSHIP —
#: `test_the_menu_predicate_AGREES_with_session_managers_over_a_shared_corpus` —
#: because the disagreement is what found the blocker below: session-manager saw a
#: modal on three live panes this file's `menu_block` could not see.
MENU_OPTION_RE = re.compile(
    r"^[ \t]*(?:(" + MENU_CURSOR + r")[ \t]*)?([0-9]{1,3})\.[ \t]+(\S.*?)[ \t]*$")
#: One multiSelect option row. 🔴 THE CHECKBOX STANDS **AFTER** THE NUMBER, AND
#: THIS FILE SAID THE OPPOSITE FOR A WHOLE ROUND. The retracted claim was
#: "`❯ [ ] 1. Ledger` is the measured render, and `MENU_OPTION_RE` cannot see it —
#: the checkbox precedes the number". BOTH HALVES WERE FALSE, and the consequence
#: was that `menu_checkbox_block` returned `[]` for every real multiSelect and
#: `PANE_MULTI_SELECT` was dead code.
#:
#: 🔴 THE REAL RENDER, TAKEN FROM THE RENDERER RATHER THAN FROM A SIGHTING.
#: Claude Code 2.1.232's multiSelect list (`.claude-wrapped`, the `Ltl` component
#: reached from `rB.multiSelect ? h6(...)`) composes each row as a flex row with
#: `gap:1`:
#:
#:     <cursor-or-space>  {`${index}.`.padEnd(w)}  {["[", selected?tick:" ", "]"]}  {label}
#:
#: which renders `❯ 1. [ ] Ledger` — number, then box. A live capture of the
#: operator's pane %170 agreed (`❯ 1. [ ] Fill the 3 recorded …`). The renderer is
#: the stronger of the two sources and is what this pattern is transcribed from:
#: it is the code that produces every capture, so it cannot be a one-pane
#: accident. ⚠ AND I DID NOT WITNESS A LIVE MULTISELECT MYSELF — a read-only sweep
#: of all 58 panes on this host (viewport + 2000 lines of scrollback) found ZERO
#: genuine multiSelect renders; the only checkbox rows on the box were the review
#: prose quoting this very defect. So the live half of this is cited, not
#: reproduced, and the renderer is what the pattern rests on.
#:
#: 🔴 AND THIS PATTERN IS THE **ONLY** THING THAT REFUSES A MULTISELECT — THE FOOTER
#: CANNOT. A multiSelect is not a third renderer: it is a MODE of ask renderer 1
#: (`rB.multiSelect` swaps the list component, not the surrounding chrome), and the
#: list component emits no footer of its own. So a live multiSelect renders ask
#: renderer 1's footer and `menu_footer` returns **FOOTER_SINGLE** for it — which is
#: correct, because it IS an AskUserQuestion; it is simply not one a digit can answer.
#: The footer grammar therefore does NOT separate a driveable ask from a multiSelect
#: and no comment in this file may imply it does: `menu_checkbox_block` is the whole
#: guard, which is why the round that made it return `[]` for every real multiSelect
#: left nothing standing but an accident.
#:
#: 🔴 AND `MENU_OPTION_RE` DOES SEE THAT ROW — the second false half. It matches
#: with `number=1` and `label="[ ] Ledger"`, so a multiSelect ALREADY reaches
#: `menu_block`, and the claim one screen down that "`menu_block` does not see them
#: at all" was wrong too. What saves it today is only that the label carries the
#: box, so no reply matches and no free-text row is recognised — an accident, not
#: a guard. This pattern is what refuses it on purpose.
#:
#: 🔴 THE BOX MUST STAND WHERE THE LABEL WOULD, immediately after the number,
#: because a checkbox ANYWHERE was the live false positive this replaces: a
#: markdown `- [ ] task` list, a `grep -c '\[ \]'` in shell output, or an option
#: label that merely CONTAINS `[x]` each made a legitimate pane unanswerable. The
#: box-FIRST spelling is gone rather than kept beside this one: no renderer in the
#: shipped bundle emits it, and keeping it would re-open exactly the
#: `❯ [x]`-quoted-in-prose refusal the previous round measured.
#: 🔴 THE `^` AND THE `.match` AT THE CALL SITE ARE ONE GUARD AND BOTH ARE
#: LOAD-BEARING TOGETHER. Individually they are EQUIVALENT mutants (with `^` and
#: no MULTILINE, `.search` anchors exactly as `.match` does), but dropping BOTH
#: widens the pattern to any position on the line — and an earlier round recorded
#: that as unkillable on the grounds that "a mid-line `[x]` yields `cursor=False`,
#: so it still cannot form the CURSORED run". THAT IS FALSE, and measured false: on
#: `2. Flatfile ❯ 9. [x] more` the widened pattern finds the cursored group
#: mid-line, so `group(1)` IS the cursor and `cursor=True`. A pane quoting a
#: cursored checkbox row inside prose therefore flips `text` -> `multi-select`,
#: refusing a legitimate reply — and quoting a modal back at the operator is a
#: shape this repo's own `waiting-signal.md` calls routine. It is pinned in
#: `test_the_checkbox_ROW_pattern_requires_the_box_where_the_LABEL_would_stand`.
#: ⚠ NOTHING IS REQUIRED **AFTER** THE BOX, deliberately. The render puts a space
#: and the label there, so requiring them would usually hold — and the two
#: directions are not symmetric: a row this pattern MISSES falls through to the
#: numbered path and gets driven by digit, while a row it matches too eagerly costs
#: one refusal. So it is left as wide as the measured prefix allows.
MENU_CHECKBOX_ROW_RE = re.compile(
    r"^[ \t]*(?:(" + MENU_CURSOR + r")[ \t]*)?([0-9]{1,3})\.[ \t]*" + MENU_CHECKBOX)
#: How far apart two consecutive option rows may sit and still be ONE block.
#: 🔴 THIS WAS 4 AND THAT WAS TOO SMALL TO SEE A REAL MENU. MEASURED over every
#: live tmux pane on this host (57 panes; 3 of them showing a real
#: `AskUserQuestion` modal): an option that carries a DESCRIPTION renders its
#: description on the lines beneath it, indented further, so consecutive option
#: rows sat 7, 5, 4, 2 / 5, 3, 3, 4, 2 / 6, 5, 3, 2 lines apart. At a gap of 4
#: `menu_block` returned ZERO rows for all three — which is why a sweep of the
#: whole fleet found not one menu this agent could drive, and why the pane a
#: reply belonged in read as `text`. 12 overshoots the measured 7; it is not a
#: multiple of any step here, and it is a sanity bound rather than the signal.
MENU_ROW_GAP = 12
MENU_MIN_OPTIONS = 2
#: A digit key selects AND advances — measured — so rows past 9 are unreachable
#: without arrow keys, which this agent will not drive.
MENU_MAX_DIGIT = 9
#: The free-text row's label, normalised (lowercased, trailing `.`/`…` stripped).
#: An ENUMERATION rather than a pattern: it decides whether a genuine free-text
#: reply has a route at all, and a pattern loose enough to match a real option
#: label would type a reply into the wrong row.
#: ⚠ ONE OF THE FOUR IS MEASURED (`Type something.`, Claude Code 2.1.232); the
#: other three are guesses at spellings of the same affordance. If Claude Code
#: rewords the row, the set matches nothing — and the consequence is NOT confined
#: to free-text replies: with no recognised free-text row `deliver_to_menu` has no
#: route for a reply that matches no label, so those are refused. A reply that
#: matches a label EXACTLY is unaffected, because the match is decided before this
#: set is consulted.
MENU_FREE_TEXT_LABELS = frozenset({
    "type something",
    "type something else",
    "type your own",
    "write my own answer",
})
#: Shortest head of a truncated label (`Some very long opt…`) this agent will
#: accept as a prefix match. Below this a truncation is not evidence of anything.
MENU_TRUNCATION_MIN = 8
MENU_TRUNCATION_MARKS = ("…", "...")
#: How long to wait for the TUI to redraw before reading the pane back. Reads
#: only — `capture-pane` types nothing — so a slow redraw costs latency, never a
#: second keypress.
MENU_SETTLE_SECONDS = float(os.environ.get("TMUX_REPLY_MENU_SETTLE_SECONDS", "0.15"))
MENU_VERIFY_ATTEMPTS = int(os.environ.get("TMUX_REPLY_MENU_VERIFY_ATTEMPTS", "8"))

#: What `classify_pane` can answer. Enumerated, and only PANE_TEXT means "deliver
#: the way this agent always has": every other value is either a menu this agent
#: drives by digit or a shape it refuses.
PANE_TEXT = "text"
PANE_MENU = "menu"
PANE_MULTI_QUESTION = "multi-question"
PANE_MULTI_SELECT = "multi-select"
PANE_UNKNOWN_MENU = "unknown-menu"


def normalise_label(s: str) -> str:
    """Collapse whitespace, the one difference a terminal render introduces."""
    return " ".join(s.split())


def free_text_key(label: str) -> str:
    """A menu label reduced to the key matched against MENU_FREE_TEXT_LABELS."""
    return normalise_label(label).casefold().rstrip(".!:… ").strip()


def menu_footer_field_kind(field: str) -> str:
    """What one ` · `-separated footer field is, or "" if the ask cannot emit it.

    🔴 THE RETURN VALUE IS THE FIELD'S **ROLE**, not a boolean, because the roles
    are what the ask footer's grammar is written in: exactly one nav field,
    `Enter to select` first, `Esc to cancel` last. An empty string means "no ask
    renderer in this Claude Code produces this field", which is the whole
    discriminator — see the section header for how that set was enumerated.
    """
    if field == MENU_FOOTER_SELECT:
        return "select"
    if field == MENU_FOOTER_CANCEL:
        return "cancel"
    if field == MENU_FOOTER_NAV_SINGLE:
        return "nav-single"
    if field == MENU_FOOTER_NAV_CHAIN:
        return "nav-chain"
    if field == MENU_FOOTER_ADD_NOTES:
        return "notes"
    # ⚠ THE LOWERCASE TAIL, NOT THE WHOLE FIELD: the chord renders `Tab` here and
    # the file has been wrong about a capitalisation before. The tail is the part
    # that carries the meaning.
    if field.casefold().endswith(MENU_FOOTER_SWITCH_QUESTIONS):
        return "switch-questions"
    # The one free slot: the editor name is interpolated by the renderer, so a
    # whole-field pin here would break on any host whose $EDITOR differs. The
    # PREFIX is fixed and that is what is required.
    if field.startswith(MENU_FOOTER_EDIT_PREFIX) and len(field) > len(MENU_FOOTER_EDIT_PREFIX):
        return "edit"
    return ""


def menu_footer_field_kind_ignoring_glue(field: str) -> str:
    """The same question, for a field that may carry text GLUED IN FRONT of it.

    🔴 THIS EXISTS BECAUSE THE FIELD BEFORE THE ANCHOR IS THE ONE THE JOIN CORRUPTS,
    AND WITHOUT IT THE FIRST-FIELD RULE WAS INERT WHERE IT MATTERS. The reader joins
    the whole capture, so the footer's OWN first field arrives with the transcript
    above it glued on. For `/permissions` (`↑/↓ to navigate · Enter to select · ←/→ to
    switch · Esc to cancel`) that first field is the nav hint — and read exactly it
    classifies as NOTHING, so the run did not extend leftwards and the "anchor must be
    field 1" rule never fired. Measured: it fired on the bare footer and not on the
    same footer inside a pane capture, which is the only shape that occurs.

    ⚠ ASYMMETRIC ON PURPOSE. Only a glued PREFIX is tolerated, because only the left
    edge of the run can carry one; the `edit` field is not tail-matchable at all (its
    own tail is the free editor name) and is not needed here — it never precedes the
    anchor in either ask renderer.

    🔴 UNKILLABLE CLAUSE, KEPT AND LABELLED — the standard is in `menu_footer`'s
    docstring. The SURVIVOR: `field.endswith(spelling)`, i.e. the same test with the
    leading space dropped. Measured on this suite at the commit that wrote this line —
    198 passed, unchanged, with a sentinel mutant in the SAME batch KILLED (34 failed,
    164 passed), so the sweep could see a difference and there was none to see. WHY IT
    IS UNKILLABLE: this function only ever sees fields split out of
    `normalise_label(captured)`, and that read joins every line and every run of
    whitespace with ONE space — so a permitted spelling glued to text in front of it
    always arrives with a space between. The space is a true statement about the
    reader's input rather than a reachable guard. WHY IT IS KEPT ANYWAY: without it the
    test matches a spelling glued mid-word (`pressEnter to select`), which is prose
    rather than a footer field, and admitting prose as a FIELD is the direction this
    file refuses everywhere.
    """
    kind = menu_footer_field_kind(field)
    if kind:
        return kind
    for spelling in (MENU_FOOTER_SELECT, MENU_FOOTER_NAV_SINGLE, MENU_FOOTER_NAV_CHAIN,
                     MENU_FOOTER_ADD_NOTES, MENU_FOOTER_CANCEL):
        if field.endswith(" " + spelling):
            return menu_footer_field_kind(spelling)
    return ""


def menu_footer(captured: str) -> str:
    """Which AskUserQuestion footer the pane is showing, if any.

    🔴 THIS IS THE ONE READ IN THIS FILE THAT IS NOT DEFEATED BY A SHORT PANE —
    see the measured height tables in the section header. Everything else the
    classifier had renders above the option rows and clips away; this renders
    below them.

    Returns FOOTER_CHAIN / FOOTER_SINGLE / FOOTER_UNKNOWN / FOOTER_NONE.

    🔴 THE GUARD IS THE WHOLE FIELD LIST, NOT THE PRESENCE OF `Enter to select`.
    That word is spelled by at least FOURTEEN other choosers in this same binary,
    and SEVEN of them also carry the single-question nav hint — so the substring
    pair this function used to test drove a chooser that changes the SANDBOX MODE
    or adds a permission RULE, those two being the ones caught live. The
    enumeration is in the section header, together with the RETRACTION of the claim
    that it is closed: at least seven further sites reach the anchor through
    composition paths the enumerating greps cannot see, and what refuses them is
    the grammar below rather than the list. What is checked here:

      * the maximal CONTIGUOUS run of fields the ask can emit, around the anchor;
      * `Enter to select` is the run's FIRST field — it is field 1 in both ask
        renderers. ⚠ NOT a discriminator on its own: five of the six `lo`-composed
        footers put it in field 1 as well, and the sixth leads with a nav hint this
        file does not name, so the run does not extend past it either. This rule
        rejects NONE of the six — the terminator does;
      * `Esc to cancel` is the run's LAST field — `Esc to close` / `to back` /
        `to go back` / `to clear` / `to continue` each belong to some other
        chooser, and `to go back` is what refuses all six `lo` sites;
      * exactly ONE nav field, which is also what says single-vs-chain — and what
        refuses the scrollable picker below 120 columns, whose nav field reads
        `↑/↓ to nav`.

    ⚠ THE THREE RULES OVERLAP ON TODAY'S CHOOSERS, AND WHICH ONES HAVE A REAL
    KILLING CASE IS NOT THE SAME FOR ALL THREE — a draft of this paragraph said it
    was, and a mutation sweep separated them:

      * the FIRST-field rule is killed by a REAL footer — one of the twelve non-ask
        component sites renders `↑/↓ to navigate · Enter to select · Esc to cancel`,
        the ask's own fields in the wrong order, and nothing else rejects it;
      * the LAST-field rule, and the refusal to extend the run leftwards past a
        clean permitted field, are each killed ONLY by a row labelled
        `GRAMMAR (synthetic)` in `ASK_FOOTER_LEDGER`. `/permissions` and `/sandbox`
        each trip two rules at once, so neither of those two is what decides them.

    Neither of the synthetic-only rules is deleted, because each encodes a fact about
    the two ask RENDERERS rather than a coincidence about the non-asks — but the
    labelling is the point: a guard whose only killing case is invented must say so,
    or the next reader will take it for a measurement.

    🔴 THE STANDARD FOR AN UNKILLABLE CLAUSE, STATED ONCE AND APPLIED TO ALL THREE OF
    THEM IN THIS FILE, because it was being decided case by case and the three came out
    inconsistent. A clause no mutant can kill is:

      * DELETED when its PREMISE describes a render that does not exist. The tail-glue
        tolerance on the terminator was that: it existed for text rendering BELOW the
        footer, and at every measured height there is nothing there but blanks the
        normalising read collapses. A clause guarding an impossible state reads as a
        guard while guarding nothing, so it is gone (see the comment at the `run`
        assembly below, which keeps the reasoning where the deletion happened).
      * KEPT **AND LABELLED WITH THE SURVIVING MUTANT** when its premise is true and it
        is unkillable for some other reason — because every live case is double-covered
        (the two GRAMMAR rows above), or because it makes this function's claim
        independent of the ORDER two branches happen to sit in, or because dropping it
        changes no verdict on any input the reader can actually receive. The two in that
        class are `"nav-chain" in run` and the leading space in
        `menu_footer_field_kind_ignoring_glue`'s glue test; each now names its own
        survivor beside it.

    What is NOT allowed is either half on its own: a clause kept silently reads as
    measured coverage, and a clause deleted because "no mutant kills it" throws away a
    true statement about the renderers. The label is what separates the two.

    ⚠ AND THE FIRST-FIELD RULE WAS INERT IN A REAL CAPTURE UNTIL THIS ROUND — found by
    the same sweep, one level deeper than the guard. It compared the anchor's left
    neighbour EXACTLY, and in a capture that neighbour carries the transcript glued in
    front of it, so `/permissions`' leading nav hint classified as nothing and the run
    never extended leftwards. It fired on a bare footer and not on the same footer
    inside a pane, which is the only shape that occurs. See
    `menu_footer_field_kind_ignoring_glue`.

    ⚠ IT READS THE WHOLE CAPTURE NORMALISED, NOT ONE LINE, and that is not
    cosmetic: the footer WRAPS at narrow widths, and `Nr` joins fields with
    ` · `, so a wrap breaks at a space and re-joining the lines with one space
    restores the field string byte for byte. A per-line parse would have refused
    the free-text render (74 columns of footer) on any pane under ~74 wide, which
    is a coverage loss this reader does not have. Anchoring on the LAST line would
    be worse still: at every height measured there were trailing blanks after the
    footer, and at 15 lines it sat two lines from the bottom.

    🔴 CHAIN WINS OVER SINGLE WHEN BOTH ARE PRESENT, and that ordering is the
    safe one rather than an arbitrary tie-break: FOOTER_CHAIN refuses and
    FOOTER_SINGLE drives, so a capture carrying both — a scrollback holding a
    finished chain's footer beneath a live single ask, which is one read away
    from happening — must resolve to the refusing value. It is decided on a bare
    SUBSTRING over the capture, before the field parse and deliberately wider
    than it, because a clipped chain is the case where the footer itself may be
    half gone: see the CHAIN branch in `classify_pane` for the measured cost.
    """
    # 🔴 NORMALISED, NOT RAW, AND THAT IS A COVERAGE FIX RATHER THAN TIDINESS. The
    # footer WRAPS at narrow widths, so at 40 columns a real chain renders
    # `… · Tab/Arrow keys to` / `navigate · …` and a raw substring test misses its
    # own anchor — measured on this reader's corpus at 30 and 40 columns, where the
    # old raw test returned FOOTER_UNKNOWN for a live chain and FOOTER_NONE for a
    # live single ask. Joining the lines with one space restores both, because the
    # wrap breaks at a space and `Nr` joins fields with ` · `.
    flat = normalise_label(captured)
    if MENU_FOOTER_SELECT not in flat:
        return FOOTER_NONE
    if (MENU_FOOTER_NAV_CHAIN in flat
            or MENU_FOOTER_SWITCH_QUESTIONS in flat.casefold()):
        return FOOTER_CHAIN
    # ⚠ THE EDGE FIELDS CARRY GLUE, AND THAT GLUE IS THE EVIDENCE. Joining the
    # whole capture means the text ABOVE the footer lands in the same
    # ` · `-delimited element as its first field, and anything below it in the
    # element holding its last. So a HEAD-glued anchor is positive proof there is
    # no ` · ` to its left — i.e. `Enter to select` really is field 1 of its own
    # footer, which is what separates the ask from `/permissions` (where the
    # anchor is an exact element, preceded by a separator and a nav field).
    fields = flat.split(MENU_FOOTER_SEP)
    kinds = [menu_footer_field_kind(f) for f in fields]
    anchor = None
    head_glued = False
    # BOTTOM-MOST, for the reason `menu_block` is bottom-most: a live footer is
    # the one at the bottom and anything above it is transcript. A stale ask
    # footer in scrollback must not out-vote a live `/permissions` below it.
    for i in range(len(fields) - 1, -1, -1):
        if fields[i] == MENU_FOOTER_SELECT:
            anchor = i
            break
        if fields[i].endswith(" " + MENU_FOOTER_SELECT):
            anchor, head_glued = i, True
            break
    if anchor is None:
        # The anchor is on screen but not as a field of its own and not at the end
        # of one — quoted mid-sentence. Not a footer this file reads.
        return FOOTER_UNKNOWN
    lo = anchor
    if not head_glued:
        # ⚠ GLUE-TOLERANT LEFTWARDS, EXACT RIGHTWARDS. The run's left edge is the one
        # element the whole-capture join corrupts, so a field there is classified by
        # what it ENDS with — otherwise `/permissions`' leading nav hint reads as
        # nothing and the first-field rule is inert in the only shape that occurs.
        while lo - 1 >= 0 and menu_footer_field_kind_ignoring_glue(fields[lo - 1]):
            lo -= 1
            kinds = (kinds[:lo]
                     + [menu_footer_field_kind_ignoring_glue(fields[lo])]
                     + kinds[lo + 1:])
    hi = anchor
    while hi + 1 < len(fields) and kinds[hi + 1]:
        hi += 1
    # ⚠ NO TAIL-GLUE TOLERANCE ON THE TERMINATOR, AND A MUTANT IS WHY. This is the
    # DELETED arm of the unkillable-clause standard in this function's docstring; the
    # two KEPT arms (`"nav-chain" in run` below, and the leading space in
    # `menu_footer_field_kind_ignoring_glue`) each name their own survivor. A draft of
    # this reader also accepted a last field BEGINNING with `Esc to cancel`, on the
    # theory that something might render under the modal and be joined onto it.
    # Removing that clause SURVIVED the whole sweep, because no measured capture has
    # anything below the footer — at every height measured there were trailing blanks,
    # which the normalising read collapses away. A clause no mutant can kill reads as
    # a guard while guarding nothing, so it is gone rather than pinned by an invented
    # row: the left edge genuinely carries glue (the transcript above the modal) and
    # the right edge, measured, does not. If a future render puts something there, the
    # terminator stops being the run's last field and the verdict is FOOTER_UNKNOWN —
    # inert with a named reason, which is the direction this file chooses everywhere.
    run = ["select" if j == anchor else kinds[j] for j in range(lo, hi + 1)]
    if run[0] != "select" or run[-1] != "cancel":
        return FOOTER_UNKNOWN
    if run.count("nav-single") != 1 or "nav-chain" in run:
        # 🔴 UNKILLABLE CLAUSE, KEPT AND LABELLED — the standard is in this function's
        # docstring. The SURVIVOR: `if run.count("nav-single") != 1:`, i.e. this line
        # with `or "nav-chain" in run` dropped. Measured on this suite at the commit
        # that wrote this line — 198 passed, unchanged, with a sentinel mutant in the
        # SAME batch KILLED (34 failed, 164 passed), so the sweep could see a
        # difference. WHY IT IS UNKILLABLE: `nav-chain` cannot reach here, because the
        # substring arm near the top of this function already returned FOOTER_CHAIN for
        # any capture containing that spelling. WHY IT IS KEPT: it makes this line's
        # claim a statement about the FIELD LIST rather than about the order two
        # branches happen to sit in — move the chain arm and the clause starts working,
        # which is the opposite of the tail-glue clause that was deleted (that one
        # guarded a render nobody can produce, at any branch order).
        return FOOTER_UNKNOWN
    if "notes" in run:
        # 🔴 THE PREVIEW ASK IS AN ASK THIS AGENT CANNOT DRIVE, SO IT REFUSES —
        # and `n to add notes` is admitted as a field precisely so the run can
        # span it and be REJECTED on it, rather than the run stopping early and
        # losing its own terminator.
        #
        # It is a real AskUserQuestion (`Enter to select` first, `Esc to cancel`
        # last), which is why a wording-level guard would have driven it. What
        # disqualifies it is its KEY HANDLER: in that renderer a digit calls the SAME
        # function the arrow keys call — it MOVES the highlight and selects nothing —
        # where the standard render's digit selects and advances (that second half is
        # this file's own measurement, recorded at MENU_MAX_DIGIT; only the preview
        # renderer's half is new here). So a digit here can never
        # answer, and sending one would move the highlight on the operator's live
        # modal and then report `failed`. Refusing costs the same `failed` row
        # without touching their screen.
        return FOOTER_UNKNOWN
    return FOOTER_SINGLE


def menu_answer_records(captured: str) -> list[str]:
    """Every answer the pane RECORDS for an ask, read off the answered render.

    🔴 THIS IS THE POSITIVE EVIDENCE `menu_settled` USED TO SAY IT COULD NOT
    HAVE. Its docstring claimed closing that residual "needs positive evidence
    from the other side of the wire" — and the evidence is on THIS side, in the
    pane, and this file already quoted it verbatim in the section header above.
    Comparing a recorded answer against the reply turns `delivered` from "the
    menu is gone" into "this option was recorded as the answer".

    🔴 BOTTOM-MOST BLOCK ONLY, for the reason `menu_block` is bottom-most: 19 live
    panes on this host carry an answered record from an EARLIER ask in scrollback
    (the figure two sweeps agreed on; the fleet SIZE moved between them, so it is
    stated without a denominator — see MENU_ANSWERED_HEADING), so taking any match
    would read a stale row as evidence about this delivery.

    The question and the answer WRAP across continuation lines, so the block is
    joined into one normalised string before it is split — reading line by line
    finds the `→` on a line whose label continues on the next one. Splitting on
    the arrow yields the question as the head and each answer as a tail, and each
    tail is cut at the `·` that starts the next question in a chain.

    🔴 AND THE WRAP IS WHY THE BLOCK'S END IS A GLYPH TEST RATHER THAN AN INDENT
    ONE — see MENU_ANSWERED_STOP_GLYPHS. A rule reading "the block ends at the
    first line starting in column 0" returned EMPTY on the one live pane whose
    question wrapped mid-word, because the continuation starts in column 0 with an
    ordinary letter. Measured on the live corpus: 17 of 18 with the indent rule, 18
    of 18 with this one.

    ⚠ ITS LOOSENESS IS MONOTONE-SAFE, and that is why it is acceptable. A
    question text that itself contains `→` yields extra junk candidates. A junk
    candidate can only ADD to the set, so it can only make a MISMATCH verdict
    more conservative (fewer good deliveries reported UNKNOWN) and make the
    positive read slightly looser — and the positive read is only ever consulted
    where the shipped code already returned `delivered` from an absence. So
    nothing here makes `delivered` reachable in a state where it was not.
    """
    lines = captured.splitlines()
    starts = [i for i, ln in enumerate(lines) if MENU_ANSWERED_HEADING in ln]
    if not starts:
        return []
    start = starts[-1]
    body = []
    for ln in lines[start + 1:start + 1 + MENU_ANSWERED_MAX_LINES]:
        if ln[:1] in MENU_ANSWERED_STOP_GLYPHS:
            # A new top-level render begins here, so the answered block has ended.
            break
        body.append(ln)
    joined = normalise_label(" ".join(body))
    if MENU_ANSWERED_ARROW not in joined:
        return []
    out = []
    for chunk in joined.split(MENU_ANSWERED_ARROW)[1:]:
        answer = chunk.split("·")[0].strip()
        if answer:
            out.append(normalise_label(answer))
    return out


def menu_answer_records_for_this_ask(captured: str, before: list[str] | None) -> list[str] | None:
    """The answered records attributable to THIS ask, or None if undecidable.

    🔴 A DIFFERENCE IS BETTER EVIDENCE THAN A SNAPSHOT, AND A SNAPSHOT IS WHAT THE
    PREVIOUS ROUND SHIPPED. `menu_answer_records` reads the BOTTOM-MOST answered
    block, which is the right block to read and still says nothing about WHICH ask
    it belongs to: 19 live panes on this host carry a record from an EARLIER ask
    WITHIN A SCREENFUL OR TWO OF SCROLLBACK (0 in any viewport right now — see
    MENU_ANSWERED_HEADING, the count is a scrollback one), and on those the previous
    code read a stale row as evidence about the delivery it had just made. Two
    measured consequences, opposite directions:

      * a correct delivery reported `failed` with `the pane records a DIFFERENT
        option as the answer to this ask` — the ask had closed, its own record had
        not been drawn yet, and the stale one was still bottom-most;
      * a delivery with NO record of its own reported `delivered` with `the pane
        records this option as the answer` — a false measurement claim, because the
        record it read predated the keypress.

    So the question is answered against the record set read BEFORE the keypress.
    `before is None` means no baseline was taken, and then attribution is
    IMPOSSIBLE rather than empty — the record is not consulted at all, which is
    what keeps `delivered` from resting on a row this process never saw appear.

    🔴 WHAT THE DIFFERENCE DOES **NOT** ESTABLISH, AND THE PREVIOUS WORDING CLAIMED
    IT DID. This paragraph read "`before == []` is a real measurement (the pane
    carried no record) and any record appearing after it IS this ask's." The second
    half is FALSE, and it contradicted this file's own MENU_ANSWERED_HEADING note
    that "a stale record CAN scroll into the viewport". It can also be COMPLETED
    rather than scrolled: the transcript above a live modal keeps rendering, so an
    EARLIER ask's record can finish drawing after the baseline was taken and pass
    this difference while belonging to nothing this process did. Reproduced in
    process: baseline `[]`, one record `['Ledger']` afterwards, reply `Ledger`
    -> `match`, reply `Flatfile` -> `mismatch`, neither of them a fact about this
    delivery.

    So what a difference against `before` establishes is NARROWER than ownership:
    the record was not on screen when the baseline was read. It rules out the
    previous round's defect — a verdict resting on a row that predated the
    keypress — and it does NOT prove the row is this ask's. That residual is why
    `menu_settled` requires the record to be read TWICE on BOTH arms, and why the
    plain absence rule, not the record, is what the common correct case rests on.
    It is stated as unestablished rather than argued away: nothing here closes it.

    ⚠ THE OTHER COST, STATED: an ask whose answer happens to render a record
    IDENTICAL to the one already on screen — the same question re-asked and
    re-answered the same way — reads as unattributable, so the verdict falls back
    to the plain absence rule. That is the weaker of the two claims and never the
    wrong one.
    """
    if before is None:
        return None
    records = menu_answer_records(captured)
    if not records or records == before:
        return None
    return records


def menu_answer_verdict(captured: str, text: str, before: list[str] | None = None) -> str:
    """Whether the pane's recorded answer agrees with the reply.

    Returns "" (no record attributable to this ask), "match", or "mismatch".
    `menu_row_holds_reply` is the predicate, not `label_matches`: the recorded
    label wraps and is sometimes truncated in that render, which is the same
    tolerance the read-back end already needed for a wrapped menu row.

    ⚠ `before` IS REQUIRED FOR ANY VERDICT BUT `""`, and that is the F2/F3 fix —
    see `menu_answer_records_for_this_ask` for what each value of it means.
    """
    records = menu_answer_records_for_this_ask(captured, before)
    if records is None:
        return ""
    if any(menu_row_holds_reply(r, text) for r in records):
        return "match"
    return "mismatch"


def menu_option_rows(captured: str) -> list[dict]:
    """Every numbered option row in a pane capture, in screen order."""
    rows = []
    for lineno, line in enumerate(captured.splitlines()):
        m = MENU_OPTION_RE.match(line)
        if m:
            rows.append({
                "line": lineno,
                "number": int(m.group(2)),
                "label": normalise_label(m.group(3)),
                "cursor": m.group(1) is not None,
            })
    return rows


def rows_are_one_block(lines: list[str], first_line: int, second_line: int) -> bool:
    """Whether two consecutive option rows belong to ONE block.

    🔴 THE RULE IS "NO BLANK LINE BETWEEN THEM", NOT A LINE COUNT, AND THAT IS
    MEASURED. An option's DESCRIPTION renders on the lines directly beneath it,
    indented further, with no blank line anywhere in the run: over the three live
    `AskUserQuestion` modals on this host, every inter-row span was 1-6
    consecutive NON-blank lines and not one contained a blank. So the thing that
    separates a menu from an unrelated numbered list further up the pane is the
    blank line, which is exactly what a bare gap count cannot see — at a gap of 4
    a real menu's rows were invisible while a synthetic pair six BLANK lines apart
    was the case the bound had been chosen for.

    MENU_ROW_GAP stays as a sanity bound so an arbitrarily long span of prose
    cannot join two unrelated numbers; the blank-line rule is the signal.

    🔴 AND THE LESSON THAT TRANSFERS, BECAUSE IT NEARLY SHIPPED THE ORIGINAL BUG
    BACK: the review that caught the *other* half of this defect had a positive
    control, and the control PASSED while the detector was blind to every real
    render on the box — because the control's menu was SYNTHETIC, with its option
    rows packed onto adjacent lines. A control built from clean fixture data cannot
    detect a defect that only realistic data exposes. The fixture that pins this
    (`DESCRIBED_MENU_CAPTURE`) reproduces the measured spacing instead, and its
    test asserts its own widest inter-row span is >= 7 — because at 3 or 4 a mutant
    restoring the old bound passes it and SURVIVES without executing this function.

    ⚠ NO `0 < gap` LOWER BOUND, deliberately, and this is the SECOND clause in
    this file deleted for that reason. Both callers walk rows in SCREEN ORDER off
    a `splitlines()` enumeration that yields each line once, so `second_line` is
    strictly greater than `first_line` on every call and the lower bound can
    never be false. Dropping it SURVIVED the module's mutation sweep — and the
    commit that deleted `len(a) < len(b)` from `menu_row_holds_reply` gave the
    reason this one has to go too: a clause no mutant can kill is a clause that
    reads as a guard while guarding nothing. (At `gap == 0` the slice below is
    empty and `all([])` is True, so the deletion is behaviour-preserving for
    every input the callers can produce, not merely for the ones they do.)
    """
    gap = second_line - first_line
    if gap > MENU_ROW_GAP:
        return False
    return all(line.strip() for line in lines[first_line + 1:second_line])


def menu_block(captured: str) -> list[dict]:
    """The BOTTOM-MOST run of option rows numbered 1..N, or [].

    🔴 BOTTOM-MOST, because a live menu is the thing at the bottom of the pane
    and anything above it is transcript. 🔴 AND NUMBERED FROM 1, because that is
    what makes the block a menu rather than any numbered text that happens to be
    on screen: an ordinary prompt cannot satisfy "1., 2., … contiguous, no blank
    line between them, one of them carrying the cursor glyph".
    """
    lines = captured.splitlines()
    best: list[dict] = []
    current: list[dict] = []
    for row in menu_option_rows(captured):
        if row["number"] == 1:
            current = [row]
            continue
        if (current and row["number"] == current[-1]["number"] + 1
                and rows_are_one_block(lines, current[-1]["line"], row["line"])):
            current.append(row)
            if len(current) >= MENU_MIN_OPTIONS:
                best = list(current)
        else:
            current = []
    return best


def menu_checkbox_block(captured: str) -> list[dict]:
    """The BOTTOM-MOST run of CURSORED multiSelect option rows, or [].

    🔴 THE SAME SHAPE AS `menu_block`, AND FOR THE SAME REASON: a run of adjacent
    option rows, at least MENU_MIN_OPTIONS of them, at least one carrying the
    cursor glyph. That combination is what the repo's own measured live-modal
    signal is (`claude/skills/session-manager/reference/waiting-signal.md`: the
    cursor plus a second option row, "because agents quote menus back at the
    operator all day").

    🔴 WHAT IT REPLACES, AND WHY THE OLD SIGNAL WAS A BLOCKER. A `[ ]` or `[x]`
    ANYWHERE in the capture used to be the whole multiSelect signal, which refused
    every reply to any pane that merely mentioned one. MEASURED over all 53 live
    tmux panes on this host: 4 refused, 0 answerable. A markdown `- [ ] task` list
    sitting above a genuine single-question menu, and an option label that merely
    CONTAINS `[x]`, were both reproduced as refusals of a pane this agent can
    answer correctly. There is no cursor and no adjacent run in any of those.
    """
    lines = captured.splitlines()
    best: list[dict] = []
    current: list[dict] = []
    for lineno, line in enumerate(lines):
        m = MENU_CHECKBOX_ROW_RE.match(line)
        if not m:
            continue
        row = {"line": lineno, "cursor": m.group(1) is not None}
        if current and rows_are_one_block(lines, current[-1]["line"], lineno):
            current.append(row)
        else:
            current = [row]
        if len(current) >= MENU_MIN_OPTIONS and any(r["cursor"] for r in current):
            best = list(current)
    return best


def classify_pane(captured: str) -> tuple[str, list[str], str]:
    """What the pane is showing. Returns (kind, option labels, refusal reason).

    🔴 THE ONLY OUTCOME THAT TYPES IS PANE_TEXT, so every uncertainty resolves
    AWAY from typing. The THREE refusing kinds are each a shape where a typed
    reply would be discarded and an Enter would answer something nobody chose:

      * PANE_MULTI_SELECT — `[ ]` checkboxes, where a digit TOGGLES in place and
        the completing `Submit` row is UNNUMBERED and reachable only by arrow
        keys, which `tmux_text_policy` refuses to deliver by design.
      * PANE_MULTI_QUESTION — the `←  ☐ DB  ☐ Region  ✔ Submit  →` tab strip or
        its `Review your answers` end screen. Answering question 1 and leaving
        the rest is a HALF answer, which is its own wrong answer.
      * PANE_UNKNOWN_MENU — a modal footer is up but the row geometry does not
        parse into exactly one cursored block numbered from 1; or a cursored
        numbered menu that is NOT an AskUserQuestion at all; or a numbered block
        plus a question marker carrying no cursor row (a menu caught half-drawn).
        In every case whether a live ask is up, and which row is which, could not
        be decided.

    🔴 THE FOOTER IS WHAT MAKES THAT INVARIANT TRUE RATHER THAN CLAIMED. It was
    false in two directions before, and both were measured on real renders rather
    than argued:

      * a SHORT PANE clipped every top-of-modal signal, so a live one-question
        ask read `text` at ≤13 lines and a live CHAIN read `menu` at 14-15 and
        `text` at ≤13 — the first typed into a modal, the second answered
        question 1 and reported `delivered` with the rest of the chain open.
      * a cursored numbered menu that is not an ask at all — the TOOL-APPROVAL
        prompt, the trust-this-folder dialog, the bypass-permissions warning, a
        transcript quoting a menu — read `menu`, so a reply of `Yes` pressed 1
        and APPROVED A TOOL CALL THE OPERATOR NEVER SAW.

    So the driving path now requires POSITIVE evidence of a one-question ask:
    `Enter to select` plus the single-question nav hint. Every other footer state
    — the chain's, an unrecognised nav wording, `Enter to confirm`, or no footer
    at all — refuses.

    ⚠ THE COST, STATED, AND IT IS THE DIRECTION THIS FILE CHOOSES EVERYWHERE: if
    Claude Code rewords either anchor, `menu_footer` returns FOOTER_UNKNOWN or
    FOOTER_NONE and every menu is REFUSED with a named reason — the feature goes
    inert rather than wrong, and the refusal says which signal was missing so the
    card shows why. That is the same trade `MENU_FREE_TEXT_LABELS` already
    documents one screen up.

    ⚠ THE RESIDUAL, STATED: this is a read of the pane at one instant and the
    keypress happens after it, so a menu that re-renders in between is not
    covered here — the same TOCTOU window `should_refuse` already documents for
    a pane that simply moved on. What bounds it is the read-back after the send.
    """
    lines = captured.splitlines()
    block = menu_block(captured)
    checkbox_block = menu_checkbox_block(captured)
    footer = menu_footer(captured)
    multi = (MENU_REVIEW_HEADING in captured
             or MENU_SUBMIT_TAB in captured
             or any(sum(line.count(m) for m in MENU_QUESTION_MARKS) >= 2 for line in lines))

    # 🔴 THE CHAIN, HOWEVER CLIPPED — AND THIS BRANCH IS FIRST BECAUSE THE
    # SIGNALS BELOW IT ALL FAIL IN A SHORT PANE. `multi` is computed from the tab
    # strip, the `Review your answers` heading and the `☐` markers, every one of
    # which renders ABOVE the option rows: on a real 2-question chain resized to
    # 15 lines all three were gone while the footer still said `Tab/Arrow keys to
    # navigate`. Answering question 1 and leaving the rest is a half answer, and
    # the shipped code reported it `delivered`.
    #
    # ⚠ AND IT NEEDS NO NUMBERED BLOCK, WHICH IS A DELIBERATE FALSE-POSITIVE COST.
    # A pane merely QUOTING this footer string in prose is refused. That is the
    # wrong direction of the two available, and it is chosen: requiring a block
    # would reopen the ≤13-line band where the chain is live and the block is
    # destroyed, which types into it. MEASURED over all 57 live panes on this host,
    # viewport and 2000 lines of scrollback: the string appears on 2, both of them
    # real chains — and notably on NONE of the 18 panes carrying an answered record,
    # because Claude Code erases the footer when the ask closes. So the realistic
    # false positive is a pane discussing this code, and its cost is one refusal
    # with a named reason rather than an answer nobody chose.
    if footer == FOOTER_CHAIN:
        return PANE_MULTI_QUESTION, [], (
            "the pane is showing a MULTI-question menu — its footer offers Tab to move "
            "between question tabs — and answering the first question would leave the rest "
            "unanswered, so nothing was typed and nothing was answered")

    # 🔴 THE PRECONDITION, AND IT GOVERNS EVERY BRANCH BELOW RATHER THAN ONE.
    # A live modal leaves a STRUCTURAL trace: a run of option rows, one of them
    # carrying the cursor. A `☐`, a `✔ Submit`, a `Review your answers` or a `[ ]`
    # does NOT open the question on its own.
    #
    # ⚠ THE FOOTER DOES, AND THIS SENTENCE USED TO DENY IT. It read "Nothing else
    # opens the question", which was true when it was written and false the moment
    # the branch above and the gate below were added — the footer is precisely a
    # non-structural signal that opens it, and it has to be, because the structure
    # is what a short pane destroys. A comment is a claim like any other.
    #
    # 🔴 THAT WORDING IS THE FIX FOR A MEASURED BLOCKER, not a tightening for its
    # own sake. This used to read `… and question_marks == 0`, so ANY `☐`/`☒` on
    # screen — a quoted tab strip in scrollback, a transcript of an earlier ask —
    # sent the pane into the refusing branches below with no cursor row and no
    # numbered block in sight. MEASURED over all 53 live tmux panes on this host:
    # `text 49 · multi-question 2 · unknown-menu 2` — 4 refused, ZERO answerable,
    # every one of the 4 with zero numbered rows and zero cursor rows.
    #
    # 🔴 EITHER SIGNAL SATISFIES IT, and the REASON THIS COMMENT USED TO GIVE WAS
    # FALSE. It read "a multiSelect list's rows carry their checkbox BEFORE the
    # number, so `menu_block` does not see them at all". The real render is
    # `❯ 1. [ ] Ledger` (see MENU_CHECKBOX_ROW_RE), which `MENU_OPTION_RE` matches
    # with `label="[ ] Ledger"` — so `menu_block` sees a multiSelect perfectly well
    # and the checkbox block is not reaching a case the numbered one cannot.
    # What it is actually for: the two blocks can be clipped INDEPENDENTLY. A
    # multiSelect whose row 1 has scrolled out of a short viewport loses its
    # numbered block (`menu_block` only starts a run at `number == 1`) while rows
    # 2..N still carry boxes, so the checkbox block is the one that survives and
    # says "refuse this". Keying the precondition on the numbered block alone would
    # let that pane fall through to the typing path.
    # ⚠ WITH ONE CONDITION, AND WRITING THIS SENTENCE IS WHAT FOUND IT: the checkbox
    # block also requires a CURSOR, so it survives that clipping only while focus is
    # on a row still in the viewport. That is what a scrolled modal shows — the list
    # scrolls to keep the focused row visible — but it is a condition, not a
    # guarantee, and the test that pins this had to be built to respect it.
    #
    # 🔴 AND A NUMBERED BLOCK ALONE IS NOT ONE OF THEM — IT MUST CARRY THE CURSOR.
    # Measured while writing this: without that clause a pane whose ordinary
    # output happens to contain `1. … 2. … 3. …` (a shell that just printed a
    # numbered list, a README, a help screen) classified as a menu-shaped thing
    # and every reply into it was REFUSED. That is the false-positive direction of
    # this detector and it costs legitimate deliveries.
    cursor_rows = sum(1 for r in block if r["cursor"])
    question_marks = sum(line.count(m) for line in lines for m in MENU_QUESTION_MARKS)

    # 🔴 A LIVE ASK WHOSE ROW GEOMETRY DOES NOT PARSE IS A REFUSAL, AND EVERY WAY
    # IT USED TO FAIL LANDED ON THE TYPING PATH. The half-drawn exception below is
    # gated on `block and question_marks`, so when the numbered block is DESTROYED
    # there was nothing left to refuse on and control fell through to PANE_TEXT.
    # FOUR measured routes to an empty block on a live modal, the last of which no
    # earlier round named:
    #
    #   1. clipping — `menu_block` only starts a run at `number == 1`, so once row
    #      1 leaves the viewport the whole block goes (real render, ≤13 lines);
    #   2. a description taller than MENU_ROW_GAP under option 1 (verified at the
    #      boundary: 12 lines seen, 13 empty);
    #   3. one blank line between rows 1 and 2;
    #   4. 🔴 THE MODAL SCROLLS ITS OWN OPTION LIST AND MARKS THE EDGE ROW WITH
    #      `↓`, WHICH STANDS EXACTLY WHERE `MENU_OPTION_RE` EXPECTS WHITESPACE OR
    #      THE CURSOR. Measured: at 104x13 a live ask rendered `↓ 2. SQLite`, the
    #      1->2 run never formed, and the pane read `text`. This is why the fix is
    #      a footer read and NOT a wider row pattern: a scrolled list shows only
    #      SOME of the options, so its label set is incomplete and a match against
    #      it is not evidence about the operator's choice either way.
    #
    # The row pattern is left alone deliberately. Refusing is the whole remedy: an
    # unparseable live modal is a shape this agent cannot drive correctly, and the
    # footer is the one signal that says a modal is there at all.
    # ⚠ THE CONDITION IS `not (block and cursor_rows)`, NOT `cursor_rows == 1`,
    # deliberately: a block carrying TWO cursor glyphs is a different fact with its
    # own refusal further down, and folding it in here would replace that message
    # with this one. This branch owns the case where the geometry is GONE.
    if footer != FOOTER_NONE and not checkbox_block and not (block and cursor_rows):
        # ⚠ WHAT THE FOOTER ESTABLISHED IS NAMED, AND IT IS NOT THE SAME FACT IN
        # BOTH STATES. `footer != FOOTER_NONE` is reachable with FOOTER_SINGLE — a
        # real ask, so "a live question menu is on screen" is measured — and with
        # FOOTER_UNKNOWN, where all that was read is a chooser footer offering
        # `Enter to select` whose field list is not an ask's. Saying the first
        # sentence about the second state is a claim the code did not make: seven
        # other choosers in this Claude Code spell that anchor. So the phrase is
        # chosen from the verdict rather than written once and hoped over both.
        seen_footer = ("the pane's footer says a live question menu is on screen"
                       if footer == FOOTER_SINGLE else
                       "the pane is showing a chooser footer offering `Enter to select`, whose "
                       "other fields are not an AskUserQuestion's")
        # ⚠ TWO REASONS, KEPT APART, because an operator acts differently on each
        # and because the half-drawn one is the case the marker-gated branch below
        # already named — the footer's contribution there is seeing it when the
        # marker itself has been clipped away.
        if block:
            return PANE_UNKNOWN_MENU, [], (
                f"{seen_footer} and it is showing "
                f"{len(block)} numbered option rows with no cursor row — which is what a menu "
                "caught half-drawn looks like — so whether a live menu is up could not be "
                "decided and nothing was typed")
        return PANE_UNKNOWN_MENU, [], (
            f"{seen_footer}, but none of its option "
            "rows parsed into a block numbered from 1 — a short pane clips row 1, and the "
            "modal marks a scrolled row with an arrow standing where the cursor would be — so "
            "which row is which could not be decided and nothing was typed")

    if not (block and cursor_rows) and not checkbox_block:
        # ⚠ ONE NARROW EXCEPTION, AND IT IS THE HALF-DRAWN FRAME. A numbered block
        # from 1 on adjacent lines, a question marker on screen, and NO cursor row
        # is what a menu caught mid-redraw looks like — and typing into that is the
        # original defect. It requires BOTH signals, so it costs nothing the sweep
        # measured: all 4 live refusals had zero numbered rows, and the PR's own
        # measured false positive (`1. … 2. … 3. …` in shell output) carries no
        # marker. Refusing here also keeps this end of the delivery agreeing with
        # the read-back end, which reports the same frame UNKNOWN.
        if block and question_marks:
            return PANE_UNKNOWN_MENU, [], (
                "the pane is showing numbered option rows and a question marker but no "
                "cursor row — which is also what a menu caught half-drawn looks like — so "
                "whether a live menu is up could not be decided and nothing was typed")
        return PANE_TEXT, [], ""

    if checkbox_block:
        # 🔴 AND THIS BRANCH IS THE WHOLE GUARD FOR THIS SHAPE — the footer read below
        # returns FOOTER_SINGLE for a live multiSelect, because a multiSelect IS an
        # AskUserQuestion (a MODE of ask renderer 1, whose list component emits no
        # footer of its own). So `footer == FOOTER_SINGLE` does NOT mean "driveable by
        # digit", and the ordering here is what makes that safe: the checkbox block is
        # consulted before the footer gate, never after it. See MENU_CHECKBOX_ROW_RE.
        return PANE_MULTI_SELECT, [], (
            "the pane is showing a multi-select question, whose completing `Submit` row is "
            "unnumbered and reachable only by arrow keys — which this agent does not send — "
            "so nothing was typed and nothing was answered")
    if multi:
        return PANE_MULTI_QUESTION, [], (
            "the pane is showing a MULTI-question menu (a tab strip or its review screen), "
            "and answering the first question would leave the rest unanswered — so nothing "
            "was typed and nothing was answered")
    if cursor_rows != 1:
        return PANE_UNKNOWN_MENU, [], (
            "the pane is showing numbered rows without exactly one cursor row, so whether "
            "it is a live menu could not be decided and nothing was typed")

    # 🔴 A CURSORED NUMBERED MENU IS NOT EVIDENCE OF AN `AskUserQuestion`, AND
    # BELIEVING IT WAS IS HOW A REPLY OF `Yes` COULD APPROVE A TOOL CALL. The
    # driving path requires the ask's OWN footer — positive evidence, not the
    # absence of a counter-signal. FIVE live renders were captured that satisfy
    # everything above and are not asks at all (the enumeration lives in the footer
    # section header, together with the retraction that makes it a FLOOR rather than
    # a closed set): the tool-approval prompt, the trust-this-folder dialog, the
    # bypass-permissions warning, `/sandbox` and `/permissions`. A transcript quoting
    # a menu, or a numbered list left in the composer, is the same class — ZERO live
    # panes on this host in the sweep that measured it, but
    # `claude/skills/session-manager/reference/waiting-signal.md` records the
    # quoting shape as routine, "because agents quote menus back at the operator
    # all day".
    #
    # ⚠ THIS IS A GUARD ON THE STATE, NOT ON A WORD, AND THAT SENTENCE WAS ONCE
    # FALSE OF THE CODE UNDER IT. The state read is now the footer's WHOLE FIELD
    # LIST; when this comment first said "guard on the state" the code tested for
    # the SUBSTRING `Enter to select`, which is a word — one that `/sandbox` and
    # `/permissions` both spell, so both were driven by digit. What is true either
    # way is that it does not read the option LABELS and cannot be walked by
    # relabelling a row: the approval prompt's rows are `Yes` / `Yes, allow all
    # edits during this session (shift+tab)` / `No` today and were `Yes, and don't
    # ask again …` / `No, and tell Claude what to do differently (esc)` in an
    # earlier render, and neither spelling is what this decides on.
    if footer != FOOTER_SINGLE:
        return PANE_UNKNOWN_MENU, [], (
            "the pane is showing a cursored numbered menu that carries no AskUserQuestion "
            "footer, so it is some other chooser — a tool-approval prompt, a startup dialog, "
            "or a menu quoted in a transcript — where a digit would answer a question the "
            "operator was never shown; nothing was typed")

    # 🔴 NO FREE-TEXT PRECONDITION HERE, DELIBERATELY. This used to refuse a
    # cursored numbered menu carrying no RECOGNISED free-text row — before any
    # label matching happened — so a reply naming row 2 EXACTLY was refused with
    # "a reply that matches no option has no route", which was false about that
    # reply. `deliver_to_menu` already refuses correctly and only when nothing
    # matched, so the precondition was redundant in the one direction and wrong in
    # the other. Its removal is what makes the `0 free-text rows` wording there
    # reachable.
    return PANE_MENU, [r["label"] for r in block], ""


def capture_pane(pane: str) -> tuple[str, str]:
    """Read a pane's visible content. Returns (text, error).

    A non-empty error means the pane could NOT be read — which is not the same
    fact as "the pane is empty", and the caller treats them differently: an
    unreadable pane is a refusal, while a pane that reads back blank provably is
    not a menu, because a menu has visible rows.
    """
    rc, out, err = run_tmux(["capture-pane", "-p", "-t", pane])
    if rc != 0:
        return "", (err.strip() or f"tmux exited {rc}")
    return out, ""


def label_matches(label: str, text: str) -> bool:
    """Whether a pane row's label is the option the reply text names."""
    a = normalise_label(label)
    b = normalise_label(text)
    if a == b or a.casefold() == b.casefold():
        return True
    # A label too long for the pane is rendered truncated, with a mark. Matching
    # its head against the reply is the only way that option stays selectable —
    # and the mark is REQUIRED, so an ordinary short label can never prefix-match
    # a different, longer reply.
    for mark in MENU_TRUNCATION_MARKS:
        if a.endswith(mark):
            head = a[:-len(mark)].rstrip()
            if len(head) >= MENU_TRUNCATION_MIN and b.casefold().startswith(head.casefold()):
                return True
    return False


def menu_row_holds_reply(label: str, text: str) -> bool:
    """Whether a menu row still HOLDS (a head of) the reply. Read-back only.

    🔴 A DIFFERENT QUESTION FROM `label_matches`, AND IT MUST NOT BE FOLDED INTO
    IT. `label_matches` decides which row to PRESS, so an unmarked prefix match
    there would select a short option row for a longer, different reply. This one
    decides whether a reply is still SITTING in a row, where the same looseness is
    the safe direction: a false positive reports `failed` (delivery UNKNOWN) for a
    good delivery, which is the direction `menu_committed` already chose.

    🔴 WHAT IT ADDS: A WRAPPED ROW. A reply longer than the option-row width
    renders as `N. <head>` with NO truncation mark — the mark `label_matches`
    REQUIRES — so nothing matched, `menu_committed` concluded the reply had left
    the menu, and an uncommitted reply was reported `delivered`. That is the third
    instance of this PR's own defect (a wrong outcome reported as success), inside
    the guard written to close the second. The `…` case was handled; the wrap was
    not.
    """
    if label_matches(label, text):
        return True
    a = normalise_label(label)
    b = normalise_label(text)
    # The head is REQUIRED to be long enough to be evidence, exactly as the marked
    # case requires — a two-character row is not a rendering of a long reply.
    # ⚠ NO `len(a) < len(b)` CLAUSE, deliberately: it cannot be false here. If `b`
    # starts with `a` and they are the same length they are the same string, which
    # `label_matches` already returned True for. A clause no mutant can kill is a
    # clause that reads as a guard while guarding nothing.
    return len(a) >= MENU_TRUNCATION_MIN and b.casefold().startswith(a.casefold())


def menu_digit(index: int) -> tuple[str, str]:
    """The digit key that selects row `index`, or ("", reason)."""
    n = index + 1
    if n > MENU_MAX_DIGIT:
        return "", (f"the option to select is row {n}, past the {MENU_MAX_DIGIT} a single "
                    "digit key can reach — the rest need arrow keys, which this agent does "
                    "not send")
    return str(n), ""


def menu_settled(pane: str, labels: list[str], text: str = "",
                 before: list[str] | None = None) -> tuple[bool, str]:
    """Whether the menu a DIGIT answered has moved on. Returns (settled, observed).

    🔴 THIS IS THE READ-BACK THAT MAKES `delivered` A MEASUREMENT RATHER THAN AN
    ASSUMPTION — the whole failure being fixed here is a wrong answer reported as
    success. It sends nothing; it only reads.

    The question is "is it the SAME menu", not "is a menu on screen": answering
    may be followed immediately by another ask, and reporting `failed` for that
    is the failure direction that trains an operator to ignore the state column.

    🔴 AN ABSENCE MUST BE READ TWICE, AND ONE READ USED TO BE ENOUGH. The verdict
    here rests on NOT seeing the menu, and a half-drawn frame looks exactly like
    that — so a menu caught mid-render read as "moved on" and reported `delivered`,
    while the SAME frame at classify time is a pane this agent would type into.
    Two ends of one delivery, two answers. Requiring two CONSECUTIVE reads to agree
    is what makes the absence evidence rather than a snapshot; the `same menu`
    state is stable by construction, so it needs no such treatment.

    🔴 IT RETURNS WHAT IT OBSERVED, AND THE CALLER MUST SAY THAT RATHER THAN CLAIM
    A SELECTION. "selected menu row 2 by its digit" asserted a selection this
    function never saw; what it can vouch for is that the menu is gone, or that a
    different one is up.

    🔴 AND THE POSITIVE EVIDENCE IS ON **THIS** SIDE OF THE WIRE. This paragraph
    used to say closing the residual below "needs positive evidence from the other
    side of the wire … recorded as a clawgate-side change", and that was wrong
    about its own file: the answered render — `● User answered Claude's questions:`
    then `⎿ · <question> → <chosen label>` — appears where the modal was, this
    module quotes it verbatim in the menu section header, and it was found in live
    scrollback on 19 panes on this host (NO viewport carries one at this instant — the
    figure is a scrollback one and MENU_ANSWERED_HEADING says what that licenses, and
    why it is stated without a denominator).
    `menu_answer_records` reads it. So:

      * a record that HOLDS the reply upgrades the verdict from "the menu is gone"
        to "the pane records this option as the answer" — the claim `delivered`
        was always making and never measuring;
      * a record that names something ELSE is a WRONG ANSWER caught red-handed,
        and is reported UNKNOWN rather than delivered;
      * a DIFFERENT MENU with no record is refused, and that is what independently
        catches a clipped chain: pressing a digit there answers question 1 and
        renders question 2, which the shipped code reported `delivered` because
        "a different menu is now on screen" — while a chain prints no answered
        line at all until Submit.

    ⚠ THE COST OF THAT LAST ONE, STATED. A genuine answer followed immediately by
    another ask, whose tall modal has pushed the answered line out of the
    VIEWPORT, now reads UNKNOWN. That is a `failed` audit row over a good
    delivery — the direction this whole file chooses — and it cannot cause a
    second keypress, because nothing on this path retries. The plain "menu gone"
    case keeps the absence rule precisely because it is the common correct one.

    ⚠ `text` DEFAULTS TO EMPTY AND THAT DISABLES ONLY THE UPGRADE, never a
    refusal: with no reply to compare against, a record cannot be said to hold it,
    so `menu_answer_verdict` is not consulted and the absence rule stands alone.

    🔴 AND SO DOES `before`, WHICH IS THE RECORD SET READ **BEFORE** THE KEYPRESS.
    A bottom-most block is not evidence about THIS ask on its own — 19 live panes
    on this host carry one from an earlier ask within a screenful or two of
    scrollback. Without the baseline the arms fired on stale rows in both
    directions: a false `failed` accusing a correct delivery, and a `delivered`
    whose detail cited a record that predated the keypress. So the record is
    consulted only as a DIFFERENCE against `before`, and with `before is None` not
    at all. ⚠ THAT DIFFERENCE IS NARROWER THAN OWNERSHIP AND THIS PARAGRAPH USED TO
    CALL IT OWNERSHIP: it establishes that the row was not on screen at the
    baseline, NOT that this ask caused it — an earlier ask's record can finish
    drawing in the same window. See `menu_answer_records_for_this_ask` for the
    reproduction and the residual, which is not closed.

    🔴 SO BOTH RECORD ARMS READ THE RECORD TWICE, AND THE MATCH ARM DID NOT.
    The record BLOCK renders progressively: a wrapped answer caught half-drawn
    reads as a SHORTER label, which does not hold the reply and therefore looks
    exactly like a wrong answer. Requiring two consecutive reads to yield the SAME
    attributable record is what makes either arm an observation rather than a frame.
    ⚠ THAT IS A DIFFERENT CHECK FROM `seen == prev` — the classification is
    identical across both halves of a half-drawn record, so the stability that
    matters is the RECORD's, not the pane kind's — and `seen == prev` was the only
    STABILITY the upgrade used to require. A record that fails the second read does not
    cost the delivery: the arm falls through to the absence rule, which is the
    weaker claim and the true one.

    ⚠ THE RESIDUAL THAT SURVIVES, STATED. "no menu on screen AND no record" is
    still also what a pane that had ALREADY moved on before the keypress looks
    like, with the digit left uncommitted in the operator's buffer. The record
    narrows that band; it does not remove it, because the record is not guaranteed
    to be in the viewport by the time these reads run.
    """
    prev = None
    prev_new = None
    last = None
    want = (PANE_MENU, list(labels))
    # 🔴 `max(2, …)` IS LOAD-BEARING: two CONSECUTIVE agreeing reads are what make
    # the absence evidence, so an operator who sets TMUX_REPLY_MENU_VERIFY_ATTEMPTS
    # to 1 (or 0) must not thereby get a one-read verdict. Pinned by
    # test_the_verify_attempt_FLOOR_survives_an_operator_setting_it_below_two.
    for _ in range(max(2, MENU_VERIFY_ATTEMPTS)):
        time.sleep(MENU_SETTLE_SECONDS)
        captured, err = capture_pane(pane)
        if err:
            # An unreadable pane is not an observation, so it cannot be half of an
            # agreeing pair either.
            prev = None
            prev_new = None
            continue
        kind, now_labels, _ = classify_pane(captured)
        seen = (kind, now_labels)
        last = seen
        # ⚠ THE RECORD IS ONLY CONSULTED ONCE THE ASK IS GONE, and the ordering is
        # load-bearing rather than tidy. The record block is not the only thing that
        # moves: the transcript ABOVE a live modal keeps rendering, so an earlier
        # ask's record can be completed — changing the bottom-most block, and so
        # passing the `before` difference — while OUR menu is still demonstrably on
        # screen. Reading it there would report "the pane records a DIFFERENT
        # option" about a delivery that has not happened yet: a true-ish `failed`
        # with a false explanation. Pinned by
        # test_a_record_that_APPEARS_while_THIS_menu_is_still_up_is_not_this_asks.
        new = menu_answer_records_for_this_ask(captured, before) if seen != want else None
        verdict = menu_answer_verdict(captured, text, before) if (text and seen != want) else ""
        if verdict == "mismatch" and new == prev_new:
            # 🔴 TWO AGREEING READS OF THE SAME RECORD, for the reason the docstring
            # gives: a half-drawn wrapped answer reads SHORT, does not hold the
            # reply, and is indistinguishable from a wrong answer on one frame.
            # Once the same attributable record has been read twice, no later frame
            # makes it correct.
            return False, ("the pane records a DIFFERENT option as the answer to this ask")
        if seen != want and seen == prev:
            # 🔴 THE UPGRADE NEEDS THE **RECORD** READ TWICE, NOT THE PANE. `seen ==
            # prev` is pane stability, which `menu_settled`'s docstring already calls
            # the wrong stability for this question: the classification is identical
            # across both halves of a half-drawn record, so a one-frame record was
            # enough to make the strongest claim this function emits while the
            # mismatch arm beside it already required two. Symmetry is the fix — and
            # failing the second read costs nothing, because control falls through to
            # the absence rule below, which is the weaker claim and the true one.
            if verdict == "match" and new == prev_new:
                return True, "the pane records this option as the answer"
            if kind == PANE_MENU:
                return False, ("a different menu is now on screen and the pane records no "
                               "answer to this one, which is also what answering the first "
                               "question of a CHAIN looks like")
            return True, "the menu is no longer on screen"
        prev = seen
        prev_new = new
    if last == want:
        return False, "the menu did not move"
    return False, "the pane never held one state long enough to be read twice"


def menu_committed(pane: str, text: str) -> bool:
    """Whether a reply TYPED into the free-text row actually left the menu.

    🔴 THE FREE-TEXT PATH NEEDS A DIFFERENT QUESTION FROM `menu_settled`, AND
    ASKING THAT ONE HERE WAS WRONG. Typing REPLACES the focused row's label, so a
    reply that was typed and never committed changes the label set — and it can
    even stop the pane classifying as a menu at all, because the row that made it
    recognisable is now the reply. Both of those satisfy "the menu moved on",
    which is the one outcome that must not read as delivered.

    So the question is whether the reply is still sitting in a menu row. It is
    answered against the pane's own bytes inside this process and nothing about
    it is reported — see the module header on the text being credential-grade.

    ⚠ THE COST, STATED: a menu rendered AFTER the answer whose own row label
    happens to match the reply reads as uncommitted, so a good delivery can be
    reported `failed`. That direction is chosen — an audit row saying UNKNOWN
    over one that says DELIVERED wrongly — and it cannot cause a second
    keypress, because nothing on this path retries.

    🔴 AND THE ABSENCE IS READ TWICE, for the reason `menu_settled` gives: the
    verdict here is "no row holds the reply", which is what a half-drawn frame
    also looks like. `menu_row_holds_reply` — not `label_matches` — is the
    predicate, because a WRAPPED row carries no truncation mark.
    """
    prev = None
    # 🔴 `max(2, …)`, for the reason `menu_settled` gives: the verdict rests on an
    # absence and a half-drawn frame imitates one, so the floor of two consecutive
    # reads must survive an operator setting TMUX_REPLY_MENU_VERIFY_ATTEMPTS below
    # it. Pinned by the same test — BOTH call sites, because each `max` survived
    # the sweep individually while no test drove the constant under 2.
    for _ in range(max(2, MENU_VERIFY_ATTEMPTS)):
        time.sleep(MENU_SETTLE_SECONDS)
        captured, err = capture_pane(pane)
        if err:
            prev = None
            continue
        rows = menu_block(captured)
        holds = any(menu_row_holds_reply(r["label"], text) for r in rows)
        if holds is False and prev is False:
            return True
        prev = holds
    return False


def menu_free_text_focused(pane: str, index: int) -> bool:
    """Whether the digit actually FOCUSED the free-text row.

    🔴 WITHOUT THIS THE FREE-TEXT PATH REBUILDS THE ORIGINAL DEFECT. If the digit
    did not focus the row, the characters that follow are discarded exactly as
    before and the Enter answers whatever is highlighted. So the text is not
    typed and Enter is never pressed until the focus is observed.

    🔴 THE CURSOR ON THAT EXACT ROW IS THE WHOLE SIGNAL, AND A SECOND CLAUSE HAD
    TO GO. This also accepted `ctrl+g` appearing ANYWHERE in the capture — the
    constant's own comment said "the hint that grows UNDER the free-text row",
    while the code substring-matched the whole pane. Reproduced: with `ctrl+g`
    present for an unrelated reason and the cursor still on row 1, this returned
    True, the reply was typed into an UNFOCUSED menu, Enter was pressed, and the
    agent reported `delivered` — a fourth instance of the defect this file exists
    to close, and one `menu_committed` structurally cannot see, because once the
    ask is gone there are no menu rows left for the reply to sit in. The two
    clauses also SHIELDED EACH OTHER: deleting either one left the suite green,
    because the measured focused render satisfies both.

    ⚠ SO THE FREE-TEXT PATH NOW DEPENDS ENTIRELY ON THE CURSOR MOVING. That is
    what the measured render does (`❯` moves to the free-text row, Claude Code
    2.1.232). If a future render focused the row WITHOUT moving the cursor, this
    returns False and the reply is never typed — refused work rather than a wrong
    answer, which is the direction this file chooses everywhere else.

    ⚠ ONE READ IS ENOUGH HERE, unlike `menu_settled` and `menu_committed`. Those
    conclude from an ABSENCE, which a half-drawn frame imitates; this concludes
    from a POSITIVE structural observation — the cursor glyph on row `index` — and
    a frame showing that is a frame in which the row is selected.
    """
    for _ in range(max(1, MENU_VERIFY_ATTEMPTS)):
        time.sleep(MENU_SETTLE_SECONDS)
        captured, err = capture_pane(pane)
        if err:
            continue
        rows = menu_block(captured)
        if len(rows) > index and rows[index]["cursor"]:
            return True
    return False


def deliver_to_menu(pane: str, labels: list[str], text: str,
                    submit: bool, captured: str = "") -> tuple[str, str]:
    """Answer a question menu by pressing the row's DIGIT. Returns (state, detail).

    🔴 NO DETAIL HERE MAY CARRY A LABEL. A matched label IS the reply text, and
    the reply text is credential-grade and never leaves this process — see the
    module header. Every diagnostic below names a digit, a count or a shape.

    🔴 `captured` IS THE PANE AS IT WAS **BEFORE** ANY KEY WAS SENT — the same read
    `classify_pane` decided on — and it is what lets the read-back attribute an
    answered record to THIS ask instead of to whatever was already on screen. Its
    default is empty so the function stays callable on its own; with no baseline
    the read-back simply does not consult the record. See
    `menu_answer_records_for_this_ask` for the two measured defects that come of
    reading a record without one.
    """
    before = menu_answer_records(captured) if captured else None
    if not submit:
        return "refused", (
            "the pane is showing a question menu, where a typed character is discarded and "
            "a digit both selects and advances — so a type-only write has no meaning there "
            "and nothing was sent")
    if not text:
        # ⚠ NOT REACHABLE THROUGH `deliver()`, AND SAYING SO IS THE POINT.
        # `validate()` refuses an empty send-keys text before this function is
        # called, so this branch is reachable only by calling `deliver_to_menu`
        # directly — which is how its test drives it. It is kept as a precondition
        # on a function that can be called from elsewhere, because on THIS path an
        # Enter with nothing typed does not merely do nothing: on an empty
        # free-text row it ABORTS THE WHOLE TOOL (`User declined to answer
        # questions`), a destructive outcome rather than a no-op.
        #
        # ⚠ IT IS NOT COUNTED AMONG THE REFUSALS A WRITE CAN RECEIVE **ON THE MENU
        # PATH** — and the qualifier is the correction, because the unqualified
        # version of this sentence was used to state a TOTAL that was wrong. A
        # claimed write also passes through `validate()` and `should_refuse()`,
        # whose refusals it very much can receive, so any count of "refusals a
        # claimed write can receive" is larger than any count taken here.
        # 🔴 AND NO NUMBER IS STATED IN PROSE ANYWHERE, deliberately: that count
        # has now been quoted wrong three times across three rounds (nine-vs-eight,
        # then eight-vs-ten, then one-vs-two divergences), always by a sentence
        # copied forward instead of re-derived. The refusal shapes this path can
        # produce are enumerated as a ledger in
        # `test_every_menu_path_REFUSAL_SHAPE_is_enumerated`, which is pinned
        # two-way and fails when one is added or removed — a prose number cannot
        # be, and that is the whole mechanism fix.
        return "refused", "the write carries no text, and an empty answer aborts the menu"

    matches = [i for i, lbl in enumerate(labels) if label_matches(lbl, text)]
    if len(matches) > 1:
        return "refused", (
            f"the reply matches {len(matches)} of the menu's {len(labels)} option rows, so "
            "which one the operator meant cannot be decided here and nothing was sent")
    if matches:
        digit, reason = menu_digit(matches[0])
        if reason:
            return "refused", reason
        rc, _, err = run_tmux(["send-keys", "-t", pane, "-l", "--", digit])
        if rc != 0:
            return "failed", redact(err or f"tmux exited {rc}", text)
        settled, observed = menu_settled(pane, labels, text, before)
        if settled:
            # 🔴 THE DETAIL SAYS WHAT WAS OBSERVED, NOT WHAT WAS INTENDED. It used
            # to read "selected menu row N by its digit", which asserts a selection
            # nothing here measured; the read-back can vouch for the menu being
            # gone, or for a different one being up, and that is what it says.
            return "delivered", f"menu row {digit} was sent and {observed}"
        return "failed", (f"menu row {digit} was sent and {observed}, so whether "
                          "the answer was accepted is UNKNOWN; nothing was re-sent")

    # No row names this reply, so it is a genuine free-text answer. That has its
    # own row, and it is the only route that does not put words nobody chose into
    # a selection.
    free = [i for i, lbl in enumerate(labels) if free_text_key(lbl) in MENU_FREE_TEXT_LABELS]
    if len(free) != 1:
        return "refused", (
            f"the reply matches none of the menu's {len(labels)} option rows and the pane "
            f"offers {len(free)} free-text rows, so there is no route for it and nothing "
            "was sent")
    digit, reason = menu_digit(free[0])
    if reason:
        return "refused", reason
    rc, _, err = run_tmux(["send-keys", "-t", pane, "-l", "--", digit])
    if rc != 0:
        return "failed", redact(err or f"tmux exited {rc}", text)
    if not menu_free_text_focused(pane, free[0]):
        return "failed", (
            f"menu row {digit} was sent to reach the free-text row and the row did not take "
            "focus, so the reply was NOT typed and Enter was NOT pressed — an Enter there "
            "would have answered whichever row is highlighted")
    rc, _, err = run_tmux(["send-keys", "-t", pane, "-l", "--", text])
    if rc != 0:
        return "failed", redact(err or f"tmux exited {rc}", text)
    rc, _, err = run_tmux(["send-keys", "-t", pane, "Enter"])
    if rc != 0:
        return "failed", redact(
            "the reply was typed into the menu's free-text row but Enter was not accepted: "
            + (err or f"tmux exited {rc}"), text)
    if menu_committed(pane, text):
        return "delivered", f"typed the reply into menu row {digit} and committed it"
    return "failed", (f"the reply was typed into menu row {digit} and Enter was sent, and it "
                      "is still sitting in a menu row, so whether it was accepted is "
                      "UNKNOWN; nothing was re-sent")


def deliver(write: dict) -> tuple[str, str]:
    """Execute ONE claimed write. Returns (state, detail).

    🔴 ONE ATTEMPT. No retry at any layer, for any reason. The claim already
    moved this row out of `pending` permanently, so a retry here would be the one
    place in the whole path that could deliver a command twice.
    """
    kind = write.get("kind") or KIND_SEND_KEYS
    kind = kind.strip() or KIND_SEND_KEYS if isinstance(kind, str) else KIND_SEND_KEYS
    pane = write.get("pane") or ""
    text = write.get("text") or ""
    submit = bool(write.get("submit"))
    expected = write.get("expectTmuxServerId") or ""
    expected = expected.strip() if isinstance(expected, str) else ""

    # 🔴 THE TRUST BOUNDARY. See `validate`: this process executes, so this
    # process refuses — regardless of what the server accepted.
    if reason := validate(write):
        return "refused", reason

    refuse, reason = should_refuse(expected, tmux_server_id())
    if refuse:
        return "refused", reason

    if kind == KIND_NEW_SESSION:
        # `validate` has already established this is an absolute, traversal-free
        # path; the local read below is the value it checked.
        # 🔴 THE GUARD ABOVE STILL APPLIES, and it is not redundant here. A
        # new-session has no pane to be stale about, but it DOES have a host and a
        # tmux server: an expectation that no longer matches means the enqueuer was
        # looking at a tmux server that has since restarted, and a window opened on
        # the new one is not the fleet state it was reasoning about.
        cwd = write.get("cwd") or ""
        pane, err = open_window(cwd, write.get("tmuxSessionName") or "")
        if err:
            return "failed", redact(err, text)
        if not text:
            # A bare window is a complete delivery: the caller asked for one.
            return "delivered", f"opened {pane}"
        # 🔴 A new-session's text is ALWAYS SUBMITTED, and the constant says so
        # rather than the assignment. The point of a new-session is a window that
        # is DOING something; typing a command into a fresh shell and not running
        # it produces a window the operator has to go and finish by hand, which is
        # the thing this feature exists to avoid. `submit` on the row is therefore
        # not consulted for this kind — it describes the send-keys case — and
        # test_a_new_session_ALWAYS_submits_whatever_the_row_says pins BOTH
        # directions so a mutant that drops this line, or that starts honouring
        # the field, is caught.
        submit = NEW_SESSION_ALWAYS_SUBMITS
    else:
        # 🔴 READ THE PANE BEFORE TYPING INTO IT. See the menu section above: the
        # text-then-Enter pair below is correct against a prompt and delivers
        # OPTION 1 against an `AskUserQuestion` menu, whatever the operator tapped.
        #
        # 🔴 ONLY FOR THE send-keys KIND. A new-session's pane is one this agent
        # just created, running a fresh shell, so there is no menu to read and a
        # capture there could only add a way to refuse a window we opened.
        captured, cap_err = capture_pane(pane)
        if cap_err:
            # An unreadable pane cannot RULE OUT a menu, and the failure direction
            # of guessing is a wrong answer reported as delivered.
            return "refused", redact(
                "the pane could not be read, so whether it is showing a question menu — "
                "where a typed reply is discarded and Enter answers whatever is highlighted "
                "— is unknown: " + cap_err, text)
        pane_kind, menu_labels, why = classify_pane(captured)
        if pane_kind == PANE_MENU:
            # 🔴 THE PRE-KEYPRESS CAPTURE GOES WITH IT. Without it the read-back
            # cannot tell this ask's answered record from one already on screen,
            # which cost a false accusation in one direction and a false
            # measurement claim in the other.
            return deliver_to_menu(pane, menu_labels, text, submit, captured)
        if pane_kind != PANE_TEXT:
            return "refused", why

    # 🔴 `-l` MAKES IT LITERAL, AND WITHOUT IT THIS IS A DIFFERENT COMMAND.
    # Un-flagged, `send-keys` interprets its arguments as KEY NAMES: a reply
    # containing "C-c" would interrupt whatever is running in the pane rather
    # than typing three characters. `--` ends option parsing so text beginning
    # with `-` is text and not a flag. The text is ONE argv element; see run_tmux.
    rc, _, err = run_tmux(["send-keys", "-t", pane, "-l", "--", text])
    if rc != 0:
        return "failed", redact(err or f"tmux exited {rc}", text)

    if submit:
        # A SEPARATE, NON-LITERAL send: `Enter` here is a key name, which is
        # exactly why the text above had to be sent literally and alone. The
        # server rejects any text containing a newline, so this is the ONLY
        # submission a delivery can produce.
        rc, _, err = run_tmux(["send-keys", "-t", pane, "Enter"])
        if rc != 0:
            # 🔴 THE TEXT IS ALREADY IN THE PANE. Report `failed` so the audit log
            # does not claim a completed delivery, but say which half failed — an
            # operator seeing this needs to know a line is sitting there unsent,
            # not that nothing happened.
            return "failed", redact(
                "the text was typed but Enter was not accepted: " + (err or f"tmux exited {rc}"), text)
    return "delivered", (f"opened {pane}" if kind == KIND_NEW_SESSION else "")


def redact(detail: str, text: str) -> str:
    """Remove the write's text from a diagnostic before it leaves this process.

    🔴 tmux QUOTES ITS ARGUMENTS IN ITS OWN ERRORS, so the most natural failure
    diagnostic is also the one most likely to carry a secret the operator typed —
    into a log line and into the audit log's `detail` column. The exact string is
    known here, so this is an exact substitution rather than a pattern match: it
    cannot miss for the reason a secret-shaped regex misses, and it cannot
    silently claim to have scrubbed something it did not.
    """
    if text:
        detail = detail.replace(text, "<text>")
    detail = " ".join(detail.split())
    return detail[:400]


# ── main loop ────────────────────────────────────────────────────────────────
_STOP = False


def _on_signal(_signum, _frame):
    global _STOP
    _STOP = True


#: Ids this process has already executed. 🔴 THE HOST'S OWN at-most-once, and it
#: is not redundant with the server's: the server's guarantee is a property of
#: its claim predicate, and this agent is the thing that RUNS the command. If a
#: server is wrong, rolled back, restored from a backup, or simply newer than
#: this agent, re-offering a claimed row would re-execute it — and the operator's
#: decision that clawgate presses Enter makes that a second command execution.
#:
#: Bounded, because an unbounded set in a process that runs for weeks is a slow
#: leak. The bound is generous relative to the real rate (a handful of replies a
#: day) and the eviction is oldest-first, so the only thing it can forget is a
#: write from thousands of writes ago — which the server's own ladder has long
#: since made unclaimable anyway.
SEEN_LIMIT = 4096
_SEEN: dict = {}


def already_executed(wid: str) -> bool:
    """Record wid and report whether this process had already run it."""
    if wid in _SEEN:
        return True
    _SEEN[wid] = True
    while len(_SEEN) > SEEN_LIMIT:
        # dicts preserve insertion order, so this evicts the oldest.
        _SEEN.pop(next(iter(_SEEN)))
    return False


def one_round(api: str, token: str, host: str, agent: str) -> int:
    """Claim, execute and report one batch. Returns the number of writes handled."""
    got = post_json(f"{api}/api/term/send-keys/claim", token,
                    {"host": host, "agent": agent})
    writes = got.get("writes") or []
    if not isinstance(writes, list):
        raise Refused("the server's claim answer had no `writes` array")
    if len(writes) > MAX_BATCH:
        # 🔴 REFUSE THE WHOLE BATCH RATHER THAN TRUNCATE IT. Executing the first
        # four and dropping the rest would run commands the server believes are
        # in flight while silently abandoning others — a partial delivery nobody
        # can reason about. Refusing the round leaves every row to be relabelled
        # `abandoned` (delivery UNKNOWN), which is the honest record, and the
        # condition is loud rather than absorbed.
        raise Refused(f"the server returned {len(writes)} writes in one claim, over the "
                      f"{MAX_BATCH} this agent will execute")
    for write in writes:
        wid = write.get("id")
        if not isinstance(wid, str) or not WRITE_ID_RE.match(wid):
            # 🔴 NOT LOGGED VERBATIM. Every field here is server-controlled, and
            # an id is the one that would otherwise be interpolated into both a
            # log line and a URL. An unusable id cannot be reported either — there
            # is nowhere to report it TO — so this counts it rather than echoing
            # it, and the count is the signal.
            log("a claimed write carried an unusable id and cannot be reported; skipping")
            continue
        if already_executed(wid):
            # 🔴 DO NOT RUN IT AGAIN, and report the refusal so the audit log
            # records that this host saw a duplicate rather than silently
            # dropping it. See _SEEN.
            state, detail = "refused", "this agent has already executed that write id"
        else:
            # 🔴 AN UNEXPECTED ERROR IS REPORTED, NOT THROWN. A non-string `kind`
            # or `expectTmuxServerId` used to raise out of the whole round: no
            # result was POSTed for that row OR ANY LATER ROW in the batch, so
            # they were relabelled `abandoned` -- "delivery UNKNOWN" -- when the
            # truthful answer is `refused`, nothing ran. An audit log that says
            # UNKNOWN where it could say NO is the failure its design avoids.
            try:
                state, detail = deliver(write)
            except Exception as exc:  # noqa: BLE001 - one bad row must not eat the batch
                state, detail = "refused", f"the agent could not process that write: {exc!r}"
        # 🔴 The log names the ROW and the OUTCOME, never the text. `detail` is
        # already redacted of the text by deliver().
        # 🔴 EVERY INTERPOLATED FIELD IS BOUNDED AND SHAPED. `wid` matched
        # WRITE_ID_RE above; `pane` is re-derived through the same regex rather
        # than echoed, so a server-supplied pane cannot put arbitrary text — or a
        # newline that forges a second log line — into the journal. `detail` is
        # already redacted of the write's text and clamped by redact().
        pane = write.get("pane")
        pane = pane if isinstance(pane, str) and PANE_ID_RE.match(pane) else "-"
        # 🔴 EVERY DETAIL IS CLAMPED HERE, ON ONE PATH. A validate() refusal used
        # to bypass redact() entirely -- an unbounded server-supplied `kind`
        # interpolated into a refusal produced a 100,021-character detail, into a
        # journal line and into the audit-log column, while the comment below
        # asserted every interpolated field was bounded. Clamping at the single
        # point where a detail becomes output makes that true for paths nobody has
        # written yet.
        text = write.get("text") if isinstance(write.get("text"), str) else ""
        detail = redact(detail, text)
        log(f"{state} {wid} (pane {pane})" + (f": {detail}" if detail else ""))
        try:
            post_json(f"{api}/api/term/send-keys/{wid}/result", token,
                      {"agent": agent, "state": state, "detail": detail})
        except Refused as exc:
            # 🔴 DO NOT RE-EXECUTE. The write already ran (or already failed); a
            # lost result leaves the row to be relabelled `abandoned`, which means
            # "delivery UNKNOWN" and is the truthful record. Re-sending would be
            # the second execution this whole design exists to prevent.
            log(f"could not report the outcome of {wid} — the audit log will show it as "
                f"abandoned, which means delivery is UNKNOWN, not that it did not run: {exc}")
    return len(writes)


def skip_memo_key(skipped) -> frozenset:
    """The rate-limit key for the transcript stream's skip line.

    🔴 THE KEY IS THE SET OF REASONS, NOT THEIR COUNTS, AND THE COUNT VERSION
    DEFEATED THE RATE LIMIT IT WAS WRITTEN AS. A count moves whenever a different
    NUMBER of sessions is mid-record this poll than last — and `no-record-boundary`
    fires whenever an append window ends without a newline, which the tailer's own
    docstring calls the ordinary steady state. So the same condition re-logged
    every few seconds, on a loop that runs 17,280 times a day. That is the
    journal-flooding the memo exists to prevent, and it is what trains an operator
    to ignore the one channel this unit has.

    🔴 IT IS A FUNCTION RATHER THAN AN EXPRESSION INSIDE THE LOOP BECAUSE A RULE
    THAT LIVES IN `main()` CANNOT BE TESTED AT THE POINT IT CAN BE WRONG. The
    first attempt at this fix was pinned only through a whole-agent subprocess
    run, and the count-keyed mutant SURVIVED it: the fixture had one skipping
    session throughout, so no count ever moved and the distinction the test
    claimed to make was never exercised.

    `unchanged` is dropped: it IS the steady state and says nothing.
    """
    return frozenset(k for k in (skipped or {}) if k != "unchanged")


def skip_reasons_to_report(seen: frozenset, skipped) -> frozenset:
    """The reasons worth logging THIS poll, given the ones already reported.

    🔴 THE MEMO IS STICKY, AND A SET-COMPARISON MEMO WAS NOT ENOUGH. Comparing
    the current reason set against the previous one logs on every change in
    EITHER direction — so a reason that appears and disappears costs TWO lines
    per cycle, and `no-record-boundary` is exactly that shape: a session is
    mid-record on one poll and complete on the next, which _read_append's own
    docstring calls the ordinary steady state. A condition that is ordinary is
    also ordinarily ABSENT, which is what makes it flap rather than persist.

    Measured against a verbatim transcription of the loop, 40 polls:

        constant reason, constant counts              1 log line
        constant reason, MOVING counts                1 log line   (the count fix)
        reason FLAPS present/absent                  39 log lines  <- this
        reason present 1 poll in 10                   8 log lines
                                                     = 3,456/day at 17,280 polls

    So the fix that made the counts stop mattering did not make the LINE stop
    repeating, while its own docstring claimed it had. Reporting each reason the
    FIRST time this process sees it gives a bound that is provable rather than
    hoped for: at most one line per distinct reason per agent lifetime, and the
    reasons are the SKIP_* constants in `transcript_stream` minus `unchanged`.

    ⚠ NO NUMBER IS WRITTEN HERE, AND ONE WAS — "four, since there are four
    reasons", when there were five. Worse, a later commit's message claimed to
    have removed it and had not: the edit landed on the emit-site comment and not
    on this docstring, so the false number survived a round whose whole subject
    was that number. A count restated in prose beside the list that defines it is
    the rot the repo's own doc gate exists for.
    `test_the_reported_reason_bound_matches_the_TAILERS_OWN_set` checks the
    relationship against that module instead.

    ⚠ THE COST, STATED: a reason that goes away and comes back is not re-reported.
    That is deliberate — a signal that fires 3,456 times a day is not a louder
    version of this one, it is a channel nobody reads — and the counts are still
    printed when a reason is first seen.

    🔴 BUT NOT BECAUSE "the bulk push covers every skipped session either way",
    WHICH IS WHAT THIS PARAGRAPH USED TO SAY AND IS FALSE. Measured, both feeders
    over one fixture with a mode-000 file beside a healthy one:

        STREAM emitted ['good'], skipped {'unreadable': 1}
        BULK   emitted ['good']
        -> covered by the bulk push? False

    `read_tail` catches OSError and skips, so an `unreadable` session reaches
    NEITHER feed. So the honest statement is narrower: `no-record-boundary` and
    `undecodable` are covered by the reconciler; `unreadable` is covered by
    nothing, and `duplicate-session-id` / `no-session-id` are conditions the
    reconciler now guards against itself rather than repairs.

    The consequence to accept with this design: a session stalled under a reason
    whose one-shot budget was already spent on a benign earlier occurrence is not
    announced again. `no-record-boundary` is the likeliest to be spent that way.
    """
    return skip_memo_key(skipped) - seen


def transcript_round(api: str, hook_token: str, host: str, state) -> dict:
    """One transcript-streaming round, over the connection this agent already has.

    🔴 IT RIDES THIS POLL AND OPENS NOTHING NEW. No inbound port on either host,
    no second long-lived connection, no second unit — one more request per
    existing ~5s cycle, which is why the session view goes from five-minutes-fresh
    to seconds-fresh for the cost of a route rather than a transport.

    🔴 IT IS ON THE HOOK TIER, NOT THE TERMINAL ONE, AND THAT SEPARATION IS
    DELIBERATE. The transcript ingest executes nothing; the write surface executes
    arbitrary commands as the operator. Fusing them into one request would put a
    read-model feed behind the credential whose whole purpose is to gate command
    execution, so disarming the write surface — a security act — would silently
    take the operator's session view with it.

    ⚠ THE ONE COUPLING THAT REMAINS, STATED RATHER THAN HIDDEN: this runs inside
    the reply agent's loop, and the reply agent exits 2 without
    CLAWGATE_TERMINAL_TOKEN. So on a host where the write surface is disarmed,
    streaming does not run either — the five-minute bulk push is the whole feed
    there, exactly as it was before this change.
    """
    return TRANSCRIPT_STREAM.run_round(
        lambda path, payload: post_json(api + path, hook_token, payload),
        lambda path: get_json(api + path, hook_token),
        host,
        state,
        PROJECTS_DIR,
    )


def main(argv: list[str]) -> int:
    signal.signal(signal.SIGTERM, _on_signal)
    signal.signal(signal.SIGINT, _on_signal)

    api = (resolve("CLAWGATE_API_URL", CONF_FILE) or API_DEFAULT).rstrip("/")
    token = resolve("CLAWGATE_TERMINAL_TOKEN", CONF_FILE)
    if not token:
        # 🔴 A CONFIGURATION ERROR THAT CANNOT SELF-HEAL, so this one exits rather
        # than backing off. It was the state this shipped in; arming meant
        # provisioning that secret on the pod AND handing this host a copy, and
        # both have since been done, so on an armed host reaching here means the
        # host's copy has GONE — ~/.claude/clawgate.env rewritten, or the unit
        # started under an environment that cannot read it — not that the feature
        # is unbuilt. The unit is wired into the user manager's default target
        # only while `enableTmuxReplyAgent` is true.
        log(f"no CLAWGATE_TERMINAL_TOKEN in the environment or {CONF_FILE} — "
            "the terminal write surface is not armed on this host; refusing to poll")
        return 2

    rc, _, _ = run_tmux(["-V"])
    if rc != 0:
        log("tmux is not usable on this host; a claimed write could not be delivered")
        return 3

    # 🔴 A REFUSAL TO NAME THIS HOST IS FATAL, NOT A DEFAULT. `local_host_label`
    # used to answer `"workbench"` when nothing identified the machine; on the
    # laptop that made this agent claim the WORKBENCH's queue — polling a host
    # nobody enqueues to, delivering nothing, with no error anywhere. Dying with
    # a named reason is the only honest outcome, and it is caught rather than
    # left to escape so the log says WHY instead of showing a traceback.
    try:
        host = local_host_label()
    except HostLabelError as exc:
        log(f"cannot identify this host, so a claim would name the wrong "
            f"machine's queue: {exc}")
        return 3
    # The agent identity the server records against a claim. It includes the pid
    # so two agents on one host (a hand-started one beside the unit) are
    # distinguishable in the audit log rather than indistinguishable.
    agent = f"{host}:{os.getpid()}"
    log(f"polling {api} every {POLL_SECONDS:g}s for writes addressed to `{host}` as `{agent}`")

    # ── transcript streaming, on this same poll ──────────────────────────────
    # 🔴 A SEPARATE CREDENTIAL, AND ITS ABSENCE IS NOT FATAL. The transcript
    # routes are on the HOOK tier; a host with a terminal token but no hook token
    # can still deliver writes, and the five-minute bulk push keeps feeding the
    # read model. Exiting here would take the write surface down over a read
    # model's missing key.
    hook_token = resolve("CLAWGATE_HOOK_TOKEN", CONF_FILE)
    stream_state = None
    if TRANSCRIPT_STREAM is None:
        log("transcript streaming is OFF: scripts/lib/transcript_stream.py could not be "
            "loaded — the 5-minute bulk push is the whole transcript feed on this host")
    elif not hook_token:
        log(f"transcript streaming is OFF: no CLAWGATE_HOOK_TOKEN in the environment or "
            f"{CONF_FILE} — the 5-minute bulk push is the whole transcript feed on this host")
    else:
        stream_state = TRANSCRIPT_STREAM.StreamState()
        log("transcript streaming is ON, riding this poll")

    # 🔴 LOG A REPEATING STREAM CONDITION ONCE, NOT EVERY POLL, for the same
    # reason the write loop does: 17,280 polls a day would bury every real event.
    # Two conditions, two memories: a stream FAILURE (the request did not
    # complete) and a stream SKIP (the request was fine, some session could not be
    # read). They are different facts and a single variable would let one mask the
    # other.
    #
    # `stream_skips` is STICKY — the reasons already reported, never cleared. See
    # skip_reasons_to_report for why a set that tracks the CURRENT reasons still
    # floods when a reason flaps.
    stream_problem = ""
    stream_skips: frozenset = frozenset()

    backoff_reason = ""
    while not _STOP:
        # 🔴 THE STREAM RUNS FIRST AND ITS FAILURES NEVER REACH THE WRITE PATH.
        # Everything it can raise is caught HERE rather than by the loop's own
        # handler, because that handler puts the agent into a 60-second backoff —
        # so a transcript hiccup would delay somebody's typed reply by a minute.
        # The write surface is the capability with a person waiting on it.
        if stream_state is not None:
            try:
                # 🔴 REFUSALS ARE DELIBERATELY NOT REPORTED. A refusal is the
                # NORMAL way a host that fell out of step learns where the server
                # got to — it happens on every redeploy and after every bulk push
                # — so logging one as a fault would fire the one signal this loop
                # has at exactly the moments the design is working.
                #
                # 🔴 BUT THE `skipped` COUNTERS ARE, AND AN EARLIER REVISION THREW
                # THEM AWAY. `unchanged` is the steady state and says nothing; the
                # others are the only observable a stalled or corrupt session
                # has. Two liveness bugs in the tailer were found by reading the
                # code rather than by reading a log, because nothing printed
                # these.
                #
                # ⚠ IT IS **NOT** RATE-LIMITED "exactly like the failure line
                # below", WHICH IS WHAT THIS COMMENT USED TO SAY. The two are
                # structurally different and the difference matters to whoever
                # reads the journal: the failure memo is a change-detector that is
                # CLEARED on success and has a recovery line, so a repeating
                # failure re-fires after each recovery; this one is STICKY and
                # one-shot per reason per process, and its recovery line was
                # removed on purpose. See skip_reasons_to_report for why, and for
                # what that costs.
                counts = transcript_round(api, hook_token, host, stream_state)
                if stream_problem:
                    log("transcript streaming is working again")
                    stream_problem = ""
                # 🔴 THE MEMO IS THE SET OF REASONS, NOT THEIR COUNTS, AND THE
                # COUNT VERSION DEFEATED THE RATE LIMIT IT WAS WRITTEN AS. A count
                # moves whenever a different NUMBER of sessions is mid-record this
                # poll than last — and `no-record-boundary` fires whenever an
                # append window ends without a newline, which _read_append's own
                # docstring calls the ordinary steady state. So a busy fleet
                # re-logged the same condition every few seconds, which is exactly
                # the journal-flooding this memo exists to prevent (17,280 polls a
                # day). The REASONS are the condition; the counts are noise, and
                # they are still printed in the line so nothing is lost.
                fresh = skip_reasons_to_report(stream_skips, counts.get("skipped"))
                if fresh:
                    notable = {k: v for k, v in (counts.get("skipped") or {}).items()
                               if k != "unchanged"}
                    log("transcript streaming skipped some sessions "
                        f"(the 5-minute bulk push still covers them): {notable}")
                    stream_skips |= fresh
            except Exception as exc:  # noqa: BLE001 — must never affect the write path
                reason = f"{exc!r}"
                if reason != stream_problem:
                    log(f"transcript streaming failed this poll (the 5-minute bulk push still "
                        f"covers it): {reason}")
                    stream_problem = reason
                # 🔴 RE-HYDRATE ON THE NEXT POLL. The most likely cause is that
                # clawgate was redeployed, which is exactly when this host's
                # cursors may no longer describe what the server holds.
                stream_state.hydrated = False

        try:
            one_round(api, token, host, agent)
            if backoff_reason:
                log("the server is answering again; back to the normal poll")
                backoff_reason = ""
            delay = POLL_SECONDS
        except Refused as exc:
            reason = str(exc)
            # 🔴 LOG A REPEATING CONDITION ONCE, NOT EVERY TICK. The 503 "not
            # armed" state is PERMANENT until someone arms the surface, and this
            # loop runs 17,280 times a day; a line per tick would bury every real
            # event in the journal and make the unit's output worthless.
            if reason != backoff_reason:
                log(f"backing off {BACKOFF_SECONDS:g}s: {reason}")
                backoff_reason = reason
            delay = BACKOFF_SECONDS
        except Exception as exc:  # noqa: BLE001 — a poll must not kill the unit
            log(f"unexpected error in the poll; backing off {BACKOFF_SECONDS:g}s: {exc!r}")
            delay = BACKOFF_SECONDS

        # Sleep in short slices so a shutdown signal is honoured promptly rather
        # than after a full backoff.
        waited = 0.0
        while waited < delay and not _STOP:
            step = min(0.25, delay - waited)
            time.sleep(step)
            waited += step

    log("stopping")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
