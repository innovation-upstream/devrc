// opencode.jsonc — global opencode configuration, managed by home-manager.
//
// Edit HERE (devrc/scripts/opencode/opencode.jsonc) then `home-manager switch`
// (or scripts/ship.sh). ~/.config/opencode/opencode.jsonc is a READ-ONLY store
// symlink — editing it directly is impossible, and editing it "successfully"
// would mean the symlink is gone and the file has drifted.
//
// 🔴 PERMISSION ORDERING IS LOAD-BEARING AND IS THE INVERSE OF CLAUDE CODE.
// opencode evaluates permission globs with LAST-MATCH-WINS over a FLAT ORDERED
// ARRAY (measured on v1.18.4 via `opencode debug agent <name>`, which prints
// that array — it is the authority, not this file). So `"*": "allow"` must come
// FIRST and every deny/ask AFTER it.
// If someone "tidies" these keys alphabetically, `"*"` (0x2A) still sorts to the
// front — so the obvious first-key assertion does NOT catch it — but the
// specific patterns reorder among themselves and a broad `ask` can end up AFTER
// the narrow `deny` it was meant to be overridden by. scripts/tests/
// test_opencode_config.py pins the EFFECTIVE RESOLVED OUTCOME for exactly this
// reason; a key-order assertion alone is vacuous.
//
// 🔴 THE BLOCK IS ORDERED: `"*": "allow"`, then every ASK, then every DENY.
// Deny-last is what makes a narrow deny beat a broad ask (`*talosctl reset*`
// deny must win over `*talosctl*` ask). Do not interleave them.
//
// 🔴 EVERY DANGEROUS PATTERN IS LEADING-`*`. opencode matches a command NODE's
// FULL TEXT, so a bare `"git stash*"` is trivially bypassed by any prefix:
// `FOO=1 git stash`, `sudo -n git stash` and `git -C /tmp stash` all MISSED it
// (measured). This matters because the house style mandates the bypassing form
// — `KUBECONFIG=$KC_HOMELAB kubectl …` and `git -C <path> …`. MEASURED on
// v1.18.4 with a live tool call: `*` crosses spaces, `/` and `-`, so
// `*git*stash*` catches all four spellings above. Pipelines and `&&` chains are
// already checked PER COMMAND, so only the prefix/wrapper case needed closing.
//
// Other measured facts baked into this file (v1.18.4):
//   * only a `"*": "deny"` removes a tool from the request schema; a narrow
//     deny does not, and `"ask"` costs exactly what `"allow"` costs.
//   * `small_model` drives TITLE GENERATION ONLY — not compaction. The real
//     cheap-model lever is pinning the hidden title/summary/compaction agents
//     in the `agent` block below.
//   * a tool listed in this global `permission` block is re-enabled on the
//     HIDDEN title/summary/compaction agents too, whose stock tool set is
//     EMPTY. Hence the explicit `"*": "deny"` on each of them below.
//   * DEPRECATED in 1.18.4, deliberately absent: agent-level `tools`, `mode`
//     (at config level), `layout`, `autoshare`, `reference` (now `references`),
//     `maxSteps` (now `steps`). `theme`/`keybinds`/`tui` moved to a separate
//     ~/.config/opencode/tui.json and are NOT set here.
//   * there is NO `list` tool and NO `websearch` tool on 1.18.4. The real set is
//     exactly {bash, edit, glob, grep, invalid, question, read, skill, task,
//     todowrite, webfetch, write}. Naming a nonexistent tool here is a no-op.
{
  "$schema": "https://opencode.ai/config.json",

  "model": "openrouter/deepseek/deepseek-v4-pro",
  // Title generation only. Compaction is pinned via the `agent` block.
  "small_model": "openrouter/deepseek/deepseek-v4-flash",

  "autoupdate": false,
  "share": "disabled",
  "snapshot": true,
  "lsp": true,
  "formatter": true,
  "subagent_depth": 2,

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },

  // Cap a single tool result so one `kubectl get -A -o yaml` cannot blow the
  // window and force an immediate compaction.
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 24576
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "result/**",
      ".direnv/**",
      "**/*.enc.yaml"
    ]
  },

  "agent": {
    // The three HIDDEN system agents. These run on every session (titles) or on
    // every context overflow (summary/compaction) and have no reasoning
    // requirement — pinning them to the flash model is the actual cost lever,
    // since `small_model` above only covers title generation.
    //
    // 🔴 `"permission": {"*": "deny"}` is NOT optional. Their STOCK tool set is
    // EMPTY (measured: `enabled=[]` against a bare config dir), but every entry
    // in the global `permission` block below is appended to THEIR resolved list
    // too — which re-enabled bash, write, edit, task and skill on all three.
    // compaction runs automatically on every context overflow, so that handed a
    // shell and a writer to the cheap model on a path nobody watches, and made
    // every title generation carry the ~3,730-token skill catalogue.
    "title": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "permission": { "*": "deny" }
    },
    "summary": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "permission": { "*": "deny" }
    },
    "compaction": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "permission": { "*": "deny" }
    },

    // Built-in `plan` is only nominally read-only — it can still write and
    // shell out. Make it GENUINELY read-only so "let's plan this" cannot
    // mutate the tree.
    //
    // `task` and `write` are here because the global block below OVERRODE the
    // built-ins: stock `plan` resolves `task 'general' deny` (it may not spawn
    // the general subagent, which HAS a shell), and the global `"task": "allow"`
    // landed after it and flipped it to allow. Restating them at agent level
    // puts them last again.
    "plan": {
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "task": { "general": "deny" }
      }
    }
  },

  "permission": {
    // NOTE: `read` is deliberately ABSENT. opencode ships a built-in
    // `read: {"*": allow, "*.env": ask, "*.env.*": ask, "*.env.example": allow}`
    // — a blanket `"read": "allow"` here lands AFTER those and silently defeats
    // the `.env` guard on every agent. The default already allows everything
    // except `.env`, so there is nothing to add.
    // `list` and `websearch` are absent because NO SUCH TOOLS EXIST on 1.18.4.
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "write": "allow",
    "webfetch": "allow",
    "todowrite": "allow",
    "task": "allow",
    "skill": "allow",

    // Ask before burning a long unproductive loop, and before reaching outside
    // the project directory.
    "doom_loop": "ask",
    "external_directory": "ask",

    // 🔴 LAST MATCH WINS. Order: `"*"` FIRST, then every ASK, then every DENY.
    // Every pattern is leading-`*` so a `VAR=…`/`sudo`/`git -C <path>` prefix
    // cannot slip past it. See the header for the measurements.
    "bash": {
      "*": "allow",

      // ================= ASK: legitimate, real blast radius ================= //

      // --- git ---
      "*git push*": "ask",
      "*git commit*": "ask",
      "*git rebase*": "ask",
      "*git checkout -- *": "ask",
      "*git restore*": "ask",
      "*git branch -D*": "ask",
      "*gh pr merge*": "ask",

      // --- kubernetes ---
      "*kubectl delete*": "ask",
      "*kubectl apply*": "ask",
      "*kubectl patch*": "ask",
      "*kubectl scale*": "ask",
      "*kubectl drain*": "ask",
      "*kubectl edit*": "ask",
      "*kubectl replace*": "ask",
      "*kubectl exec*": "ask",
      "*kubectl cp*": "ask",
      "*kubectl rollout undo*": "ask",
      // `get secret -o yaml` prints every value base64-encoded, i.e. plaintext.
      "*kubectl get secret*": "ask",
      "*kubectl describe secret*": "ask",

      "*helm upgrade*": "ask",
      "*helm uninstall*": "ask",
      "*helm rollback*": "ask",

      "*flux suspend*": "ask",
      "*flux resume*": "ask",
      "*flux delete*": "ask",

      // --- talos --- (`*talosctl reset*` is DENIED below, after this)
      "*talosctl patch*": "ask",
      "*talosctl reboot*": "ask",
      "*talosctl upgrade*": "ask",
      "*talosctl apply-config*": "ask",
      "*talosctl shutdown*": "ask",

      // --- secrets to plaintext ---
      "*sops -d*": "ask",
      "*sops --decrypt*": "ask",
      "*sops exec-env*": "ask",
      "*age -d*": "ask",
      "*age --decrypt*": "ask",

      // --- whole-system state ---
      "*nixos-rebuild*": "ask",
      "*home-manager switch*": "ask",
      "*nix-collect-garbage*": "ask",
      "*nix profile remove*": "ask",
      // Only the MUTATING systemctl verbs. `systemctl status`/`list-timers` are
      // read-only and high-frequency — gating those is pure prompt fatigue,
      // which trains the operator to click through the ones that matter.
      "*systemctl start*": "ask",
      "*systemctl stop*": "ask",
      "*systemctl restart*": "ask",
      "*systemctl enable*": "ask",
      "*systemctl disable*": "ask",
      "*systemctl daemon-reload*": "ask",

      // --- privilege escalation: gate the WRAPPER itself ---
      "sudo*": "ask",
      "*sudo *": "ask",
      "*doas *": "ask",

      // --- filesystem blast radius ---
      "*chmod -R*": "ask",
      "*chown -R*": "ask",
      // Broad `rm -rf` asks; the catastrophic targets are DENIED below.
      "*rm -rf*": "ask",
      "*rm -fr*": "ask",
      "dd *": "ask",
      "*dd if=*": "ask",
      "*dd of=*": "ask",

      // ============ DENY: destructive or rule-violating, never worth ======== //
      // ============ a prompt. MUST stay LAST — deny beats ask.       ======== //

      // Blind-staging leaks unrelated WIP and secrets from a dirty tree.
      "*git*add -A*": "deny",
      "*git*add --all*": "deny",
      "*git*add .": "deny",
      "*git*add ..*": "deny",
      // The stash stack is repo-GLOBAL across worktrees — a concurrent agent
      // or session pops your entry, or you pop theirs. Copy files aside
      // instead.
      "*git*stash*": "deny",
      // Irreversibly destroys uncommitted work.
      "*git*reset --hard*": "deny",
      "*git*clean -fd*": "deny",

      // Catastrophic delete targets. (`rm -rf /*` also covers `/tmp/x` — that
      // is pre-existing behaviour and deliberately kept: an absolute-path
      // recursive delete is worth the friction.)
      "*rm -rf /*": "deny",
      "*rm -fr /*": "deny",
      "*rm -rf ~*": "deny",
      "*rm -fr ~*": "deny",
      "*rm -rf $HOME*": "deny",
      "*rm -rf .": "deny",
      "*rm -rf ..*": "deny",

      // Wipes a Talos node. Must come after `*talosctl*` asks.
      "*talosctl reset*": "deny",

      // Formats a filesystem. No agent on these hosts has a reason to.
      "*mkfs*": "deny"
    }
  }
}
