{
  "manifest_version": 3,
  "name": "Claude Usage Tracker",
  "version": "0.3.0",
  "description": "Snapshots every Claude account's usage when claude.ai is open, shows it in-page and on the toolbar badge, and lists all known accounts with reset countdowns. Local-only, personal automation.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content_probe.js", "content_widget.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/widget.js",
        "lib/timefmt.js",
        "lib/format.js",
        "lib/severity.js",
        "lib/availability.js"
      ],
      "matches": ["https://claude.ai/*"]
    }
  ],
  "action": {
    "default_title": "Claude Usage Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
