#!/usr/bin/env python3
"""Interactive fzf menu for the i3status-rust `runaways` block.

Reads the cache file written by bar-status-poll and presents flagged
processes in an fzf selector. Selecting a process sends SIGTERM.

Left-click on the pill opens this menu; right-click opens syshealth in
a float terminal.
"""
from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import time


def cache_path() -> str:
    base = os.environ.get("BAR_STATUS_DIR") or os.path.join(
        os.path.expanduser("~"), ".cache", "bar-status")
    return os.path.join(base, "runaways.json")


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def format_entry(proc: dict) -> str:
    """Format a single process for fzf display."""
    pid = proc.get("pid", "?")
    cpu = proc.get("cpu", 0)
    age = proc.get("age_sec", 0)
    cmd = proc.get("cmd", "?")
    cwd = proc.get("cwd", "")

    age_str = _fmt_age(age)
    parts = ["PID %s" % pid, "%.0f%% CPU" % cpu, age_str]
    if cwd:
        parts.append(cwd)
    parts.append(cmd[:60])
    return "  ".join(parts)


def _fmt_age(secs: int) -> str:
    if secs < 60:
        return "%ds" % secs
    if secs < 3600:
        return "%dm%ds" % (secs // 60, secs % 60)
    hours = secs // 3600
    mins = (secs % 3600) // 60
    if hours < 24:
        return "%dh%dm" % (hours, mins)
    days = hours // 24
    hours = hours % 24
    return "%dd%dh" % (days, hours)


def run_fzf(entries: list[dict]) -> dict | None:
    """Show fzf with the process list; return the selected entry or None."""
    lines = [format_entry(e) for e in entries]
    if not lines:
        return None
    try:
        proc = subprocess.run(
            ["fzf", "--prompt", "Runaways: ", "--no-multi",
             "--height", "40%"],
            input="\n".join(lines),
            capture_output=True, text=True, timeout=30)
    except Exception:
        return None
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    sel = proc.stdout.strip()
    # Match by PID (first entry)
    for e in entries:
        if format_entry(e) == sel:
            return e
    return None


def kill_process(proc: dict) -> bool:
    """Send SIGTERM to the process. Returns True on success."""
    pid = proc.get("pid")
    if not pid:
        return False
    try:
        os.kill(int(pid), signal.SIGTERM)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="fzf menu for runaway processes")
    ap.add_argument("--dry-run", action="store_true",
                    help="print entries and exit without fzf or kill")
    args = ap.parse_args(argv)

    payload = load(cache_path())
    if not isinstance(payload, dict):
        print("No runaway data available", file=sys.stderr)
        return 1

    entries = payload.get("processes", [])
    if not entries:
        print("No runaways detected", file=sys.stderr)
        return 0

    if args.dry_run:
        for e in entries:
            print(format_entry(e))
        return 0

    sel = run_fzf(entries)
    if not sel:
        return 0

    pid = sel.get("pid", "?")
    cmd = sel.get("cmd", "?")[:40]
    confirm = subprocess.run(
        ["fzf", "--prompt", "Kill PID %s (%s)? [y/N] " % (pid, cmd),
         "--no-multi", "--height", "10%"],
        capture_output=True, text=True, timeout=15)
    if confirm.returncode != 0 or confirm.stdout.strip().lower() not in ("y", "yes"):
        return 0

    if kill_process(sel):
        print("Killed PID %s" % pid)
        return 0
    else:
        print("Failed to kill PID %s" % pid, file=sys.stderr)
        return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)