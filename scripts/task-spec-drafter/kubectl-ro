#!/usr/bin/env bash
# kubectl-ro — a READ-ONLY kubectl for the task-spec-drafter's headless pass.
#
# WHY THIS EXISTS (read before touching the argument parser)
# ---------------------------------------------------------
# The allowlist used to carry `Bash(kubectl get*)` / `logs*` / `describe*` /
# `top*`, and the deny layer tried to claw back the inherited `Bash(kubectl:*)`
# grant from ~/.claude/settings.json with 29 `Bash(kubectl <verb>:*)` rules.
# THAT DID NOT WORK. Permission rules are PREFIX rules, so they only match when
# the verb comes FIRST — and kubectl accepts its global flags BEFORE the verb:
#
#     kubectl delete pod -n prod api-0                    -> denied
#     kubectl -n prod delete deploy web                   -> ALLOWED  (bypass)
#     kubectl -n x exec pod -- sh -c id                   -> ALLOWED  (bypass)
#     kubectl --kubeconfig=/prod delete ns prod           -> ALLOWED  (bypass)
#     kubectl --insecure-skip-tls-verify -n prod apply -f x.yaml -> ALLOWED
#
# `-n <ns>` before the verb is the single most ordinary kubectl idiom, and the
# pass runs under `env KUBECONFIG=<PRODUCTION kubeconfig>` over UNTRUSTED civitai
# ticket text. A prefix rule cannot express "verb, wherever it appears", and a
# mid-pattern wildcard (`Bash(kubectl * delete *)`) is both against this repo's
# structural rule and quote-bypassable. So kubectl moves behind a FIXED WRAPPER,
# exactly like `ticket-status`: the allowlist pins this script's absolute path,
# `Bash(kubectl:*)` is DENIED WHOLESALE, and argument validation happens here, in
# code we control, where flag ORDER is irrelevant.
#
# CONTRACT
#   * the subcommand must be one of: get, logs, describe, top
#   * flags may appear anywhere, including before the subcommand
#   * identity / endpoint / TLS overrides are refused outright — they would let an
#     injected ticket point a "read-only" verb at a DIFFERENT cluster
#   * `--kubeconfig` is accepted ONLY if it names the same file as $KUBECONFIG
#     (the runner's production kubeconfig). 18 of the 30 real kubectl calls in the
#     8-day transcript window pass it redundantly, so refusing it outright would
#     have broken them.
#   * `secret`/`secrets` are refused: `get secret -o yaml` returns base64
#     credentials and WebFetch (allowlisted, domain-unrestricted) completes the
#     exfil chain. Zero of the 1,335 real calls in the 8-day window read secrets.
#   * `--follow`/`-f`/`--watch`/`-w` are refused: they never terminate, and this
#     runs unattended behind a timeout.
#
# FAIL-CLOSED BY CONSTRUCTION: every parse ambiguity resolves to "the token I
# landed on is not one of the four permitted verbs", i.e. rejection. The single
# mis-parse that could resolve the other way — a value-taking flag swallowing a
# mutating verb and leaving an allowed one as the result — is covered
# independently by the "no kubectl subcommand may appear before the verb" check.
#
# Exit codes: 64 = refused by this wrapper (never reached kubectl); anything else
# comes from kubectl itself.
set -euo pipefail

readonly PROG="kubectl-ro"

die() {
  printf '%s: %s\n' "$PROG" "$1" >&2
  printf '%s: only `get`, `logs`, `describe` and `top` are permitted, against the runner'"'"'s own kubeconfig.\n' "$PROG" >&2
  exit 64
}

# The four verbs this wrapper exists to permit.
is_read_verb() {
  case "$1" in
    get|logs|describe|top) return 0 ;;
    *) return 1 ;;
  esac
}

# EVERY kubectl subcommand, read or write. Used only for the belt-and-braces
# check that no subcommand hides in the pre-verb flag run.
is_any_subcommand() {
  case "$1" in
    get|logs|describe|top|explain|api-resources|api-versions|cluster-info\
    |config|version|options|completion|kustomize|diff|events|wait|auth\
    |certificate|create|apply|edit|delete|replace|patch|scale|autoscale\
    |rollout|run|exec|attach|cp|port-forward|proxy|debug|drain|cordon\
    |uncordon|taint|label|annotate|set|expose|plugin|apply-set|alpha|convert)
      return 0 ;;
    *) return 1 ;;
  esac
}

# Flags that take a SEPARATE value word. Consulted ONLY while scanning the
# pre-verb run, so the `-f` = `--filename` (get) vs `--follow` (logs) ambiguity
# never arises. An omission here is fail-closed (the value becomes the candidate
# verb and is rejected); an over-inclusion is caught by is_any_subcommand().
takes_value() {
  case "$1" in
    -n|-o|-l|-c|-s|-L\
    |--namespace|--output|--selector|--field-selector|--container|--filename\
    |--kubeconfig|--context|--cluster|--user|--server|--token|--as|--as-group\
    |--as-uid|--tail|--since|--since-time|--limit-bytes|--request-timeout\
    |--cache-dir|--certificate-authority|--client-certificate|--client-key\
    |--tls-server-name|--username|--password|--chunk-size|--template|--sort-by\
    |--label-columns|--profile|--profile-output|--max-log-requests\
    |--pod-running-timeout|--raw|--v|--log-flush-frequency|--subresource)
      return 0 ;;
    *) return 1 ;;
  esac
}

# Identity / endpoint / TLS / file-writing / non-terminating flags. Refused
# ANYWHERE in argv, in both `--flag value` and `--flag=value` spellings.
# `--kubeconfig` is handled separately: pinned, not refused.
is_forbidden_flag() {
  case "$1" in
    --server|-s|--token|--as|--as-group|--as-uid|--username|--password\
    |--client-certificate|--client-key|--certificate-authority\
    |--insecure-skip-tls-verify|--insecure-skip-tls-verify-backend\
    |--tls-server-name|--context|--cluster|--user|--cache-dir|--profile\
    |--profile-output|--log-file|--follow|-f|--watch|-w|--watch-only)
      return 0 ;;
    *) return 1 ;;
  esac
}

is_secret_token() {
  case "${1%%/*}" in
    secret|secrets|secret.v1.|secrets.v1.) return 0 ;;
    *) return 1 ;;
  esac
}

args=("$@")
argc=${#args[@]}
[ "$argc" -gt 0 ] || die "no arguments; expected a read-only kubectl invocation"

# --- pass 1: forbidden flags, and pin --kubeconfig, anywhere in argv ---------
kubeconfig_arg=""
expect_kubeconfig_value=0
for (( i = 0; i < argc; i++ )); do
  tok="${args[i]}"
  if [ "$expect_kubeconfig_value" -eq 1 ]; then
    kubeconfig_arg="$tok"
    expect_kubeconfig_value=0
    continue
  fi
  case "$tok" in
    -*) name="${tok%%=*}" ;;
    *) continue ;;
  esac
  if is_forbidden_flag "$name"; then
    die "refusing flag '$name' — identity/endpoint/TLS overrides and non-terminating flags are not permitted"
  fi
  if [ "$name" = "--kubeconfig" ]; then
    if [ "$tok" = "$name" ]; then
      expect_kubeconfig_value=1
    else
      kubeconfig_arg="${tok#*=}"
    fi
  fi
done
[ "$expect_kubeconfig_value" -eq 0 ] || die "--kubeconfig given with no value"

if [ -n "$kubeconfig_arg" ]; then
  runner_kubeconfig="${KUBECONFIG:-}"
  [ -n "$runner_kubeconfig" ] || die \
    "--kubeconfig is only permitted when the runner has already pinned one via \$KUBECONFIG"
  given="$(readlink -f -- "$kubeconfig_arg" 2>/dev/null || printf '%s' "$kubeconfig_arg")"
  pinned="$(readlink -f -- "$runner_kubeconfig" 2>/dev/null || printf '%s' "$runner_kubeconfig")"
  [ "$given" = "$pinned" ] || die \
    "--kubeconfig '$kubeconfig_arg' is not the runner's \$KUBECONFIG — pointing a read verb at another cluster is not permitted"
fi

# --- pass 2: locate the subcommand, allowing flags before it -----------------
verb=""
verb_index=-1
i=0
while [ "$i" -lt "$argc" ]; do
  tok="${args[i]}"
  if [ "$tok" = "--" ]; then
    i=$(( i + 1 ))
    continue
  fi
  case "$tok" in
    -*)
      name="${tok%%=*}"
      # `--flag=value` carries its value inline; only the bare spelling eats the
      # next word. `-n prod` MUST consume `prod`, or `prod` looks like the verb.
      if [ "$name" = "$tok" ] && takes_value "$name"; then
        i=$(( i + 2 ))
      else
        i=$(( i + 1 ))
      fi
      continue
      ;;
  esac
  verb="$tok"
  verb_index="$i"
  break
done

[ -n "$verb" ] || die "no subcommand found in: ${args[*]}"

# Belt and braces: nothing that is itself a kubectl subcommand may sit in the
# pre-verb flag run. Without this, a value-taking flag that swallowed a mutating
# verb could leave an allowed verb as the parse result.
for (( i = 0; i < verb_index; i++ )); do
  tok="${args[i]}"
  case "$tok" in
    -*) continue ;;
  esac
  if is_any_subcommand "$tok"; then
    die "'$tok' appears before the subcommand — refusing an ambiguous invocation"
  fi
done

is_read_verb "$verb" || die "subcommand '$verb' is not read-only"

# --- pass 3: Secret objects --------------------------------------------------
for (( i = 0; i < argc; i++ )); do
  case "${args[i]}" in
    -*) continue ;;
  esac
  if is_secret_token "${args[i]}"; then
    die "refusing to read Secret objects"
  fi
done

exec kubectl "$@"
