#!/usr/bin/env python3
"""i3status-rust custom block: qBittorrent (behind the gluetun AirVPN sidecar).

Reads the cache file written by scripts/bar-status-poll (the `media` source) and
emits ONE i3status-rust JSON line. INSTANT local file read — CREDENTIAL-FREE,
never touches the network, never blocks the bar. All the fetch/auth lives in the
poller; this block only renders what parse_media already decided.

Unlike the hide-at-zero count blocks, this one ALARMS instead of hiding on the
failure states (per the media widget's decision 5):
  connected + actively transferring -> neutral pill `CA ↓.. ↑..` (from cache)
  connected + idle                  -> HIDDEN (empty block; parse_media emits "")
  firewalled (port not forwarded)   -> RED  (Critical; the AirVPN-fixed regression)
  poller-stale / qBit unreachable / missing / corrupt cache
    / a cache the poller STOPPED REFRESHING                 -> soft yellow `qBit?`

The right-click detail popup (media-detail) and left-click (open the qBit WebUI)
are wired in graphical.nix, not here.

🔴 THE LAST OF THOSE UNKNOWN CASES IS NEW, AND IT WAS THE INVISIBLE ONE. This
block always alarmed rather than hid on a stale marker, so it looked immune to
the bar-wide "an outage renders as healthy" defect — but nothing here read the
`ts` the poller stamps on every payload. When `bar-status-poll` stopped, the
last reading simply stayed on screen: a connected tunnel kept rendering its
neutral `CA ↓.. ↑..` pill, and a firewalled one kept its red, both as confident
present-tense facts about a tunnel nobody had looked at in days. Alarming on the
`stale` MARKER only covers the outage the poller is alive to report.
"""
import importlib.machinery
import importlib.util
import json
import os
import sys
import time

NAME = "media"
_VALID_STATES = ("Idle", "Info", "Good", "Warning", "Critical")
_EMPTY = {"text": "", "state": "Idle"}
# Soft-yellow "status unknown" pill: the poller ran but couldn't reach qBit, OR
# the cache is missing/corrupt. Deliberately NOT red (avoid crying wolf on a
# transient poller hiccup) and NOT hidden (a down media tunnel is worth a nudge).
_STALE = {"icon": "net_down", "text": "qBit?",
          "short_text": "qBit?", "state": "Warning"}


def _load_freshness():
    """Load the co-located `bar_freshness.py` sibling by EXPLICIT PATH.

    Extensionless block scripts cannot be a package, so this is the repo's
    standard sibling-module shape (cf. `notif-center` loading `i3status-notifs`,
    `bar-status-poll` loading `scripts/lib/`). Deliberately NOT wrapped in a
    try: a block that cannot load the freshness predicate cannot know whether
    its cache is current, and `__main__` below turns that into the VISIBLE
    `qBit?` pill rather than a confident tunnel state. `dont_write_bytecode`
    keeps a `__pycache__` out of the operator's ~/.config/i3status-rust/scripts.
    """
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "bar_freshness.py")
    loader = importlib.machinery.SourceFileLoader("_bar_freshness", path)
    spec = importlib.util.spec_from_loader("_bar_freshness", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


fresh = _load_freshness()


def cache_path() -> str:
    base = os.environ.get("BAR_STATUS_DIR") or os.path.join(
        os.path.expanduser("~"), ".cache", "bar-status")
    return os.path.join(base, NAME + ".json")


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def render(payload, now=None) -> dict:
    """Pure: cache payload (or None) -> i3status-rust block dict.

    NOT MEASURED — None / malformed / stale / error / a `ts` that is absent,
    junk or older than `bar_freshness.MAX_CACHE_AGE_SECS` -> soft-yellow `qBit?`
    (alarm, not hide). Otherwise pass through parse_media's render fields; an
    empty text (the connected+idle case) collapses to the invisible block.

    `now` is injected rather than read here so the freshness gate is testable
    without sleeping; it defaults to the wall clock. Fail-safe throughout: it
    never raises, whatever the file contains — a claim only a DIRECT call can
    test, since `__main__` below prints a `qBit?` pill for any exception.
    """
    now = time.time() if now is None else now
    # missing / corrupt cache, a poller that reached us but not qBit, and a
    # poller that stopped writing altogether — one predicate, one answer.
    if fresh.unmeasured(payload, now):
        return dict(_STALE)
    text = payload.get("text", "")
    if not isinstance(text, str) or text == "":
        return dict(_EMPTY)                        # connected + idle -> hidden
    state = payload.get("state")
    if state not in _VALID_STATES:
        state = "Idle"
    out = {"text": text, "short_text": payload.get("short_text", text),
           "state": state}
    icon = payload.get("icon")
    if icon:
        out["icon"] = icon
    return out


def main() -> int:
    sys.stdout.write(json.dumps(render(load(cache_path()))) + "\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        # 🔴 The last-resort fallback is the `qBit?` pill, NOT the empty one, and
        # it USED to be the empty one — the single place in this module where a
        # failure hid instead of alarming, contradicting the block's stated
        # philosophy two docstrings above it. A block that crashed measured
        # nothing. Built literally so it cannot depend on anything that just
        # failed — including the sibling module the import above may not have
        # found.
        sys.stdout.write(
            '{"icon": "net_down", "text": "qBit?", "short_text": "qBit?", '
            '"state": "Warning"}\n')
        sys.exit(0)
