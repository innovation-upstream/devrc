# activity-collector config — copy to ~/.config/activity-collector/env (chmod 600).
# This file is NOT in the nix store and NOT committed. The nix module creates the
# real file with these safe defaults if it is missing; edit it in place to slot in
# an authed ClickHouse user later WITHOUT any code change.

# ClickHouse HTTP endpoint (Traefik fronts the HTTP interface on port 80).
CLICKHOUSE_URL=http://clickhouse.homelab.lan
CLICKHOUSE_USER=default
# Empty for now (default user has no password). Put the authed user's key here
# later — keep this file chmod 600; it is the only place the secret lives.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=activity
CLICKHOUSE_TABLE=events

# Batching / buffering.
ACTIVITY_BATCH_SIZE=500
ACTIVITY_FLUSH_SECONDS=10
# On-disk offline buffer caps. Over-cap the OLDEST segments are dropped + logged.
# NOTE: systemd EnvironmentFile keeps inline trailing comments as part of the
# value — so values below must be bare (full-line comments only).
# ACTIVITY_MAX_BUFFER_BYTES: 64 MiB
ACTIVITY_MAX_BUFFER_BYTES=67108864
# ACTIVITY_MAX_BUFFER_AGE_SECONDS: 7 days
ACTIVITY_MAX_BUFFER_AGE_SECONDS=604800
ACTIVITY_HTTP_TIMEOUT=10

# Per-host label stamped on every shipped event. REQUIRED to disambiguate hosts:
# both machines are hostname `nixos`, so without this all events collide on
# host=nixos.
#
# 🔴 DELIBERATELY NOT SET HERE, AND THIS LINE USED TO READ `ACTIVITY_HOST=workbench`.
# A TEMPLATE CANNOT KNOW WHICH MACHINE IT LANDS ON. `nix/home.nix`'s
# `home.activation.activityCollectorEnv` copies this file VERBATIM onto any host
# that lacks the real one, so a fresh LAPTOP got `workbench` baked in — a stated
# label contradicting the machine's own address. Since #1601 that is not merely a
# wrong column: `scripts/lib/host_label.py` cross-checks the stated label against
# an address this machine holds and raises `HostLabelConflict`, which takes down
# transcript-push (every 5 min), tmux-reply-agent (FAILED after 5 restarts),
# tmux-snapshot-push (every 2 min) and `peer-host` on an otherwise-healthy box.
#
# So the value is DERIVED, not templated: the activation runs host_label.py — the
# same module every consumer reads — and APPENDS `ACTIVITY_HOST=<derived>` to the
# real file. One source of truth, and it cannot contradict the machine it lands
# on. Pinned by `scripts/tests/test_host_label_identity.py`
# (`test_the_provisioning_template_STATES_NO_HOST`).
#
# Setting it by hand is still supported and still wins — but it is a CLAIM the
# module cross-checks, not an override: state the wrong one and every consumer
# refuses rather than believing you.
# ACTIVITY_HOST=

# Spool dir (default ~/.local/state/activity/spool). Usually leave unset.
# ACTIVITY_SPOOL_DIR=
