#!/usr/bin/env python3
"""i3status-rust custom block: LIVE count of Claude-Code-in-tmux runs.

Renders the glyph `󰕮` (nf-md-view_dashboard) with a live count of how many
Claude Code sessions are currently running in tmux:
  N == 0    ->  `󰕮`      (bare glyph — a measured, quiet steady state)
  N  > 0    ->  `󰕮 N`
  unmeasured->  `󰕮 ?`    (the detector could not be loaded or could not run)

State is ALWAYS neutral/Idle — running agents are the normal steady state, NOT
"blocked on you" (CALM bar: colour == "look at me", and nothing here demands
attention). Local + cheap (a tmux + /proc scan), so this block needs NO poller /
cache / signal — it just recounts on its own `interval`, and `bar_freshness` (a
cache-staleness gate) does not apply to it.

🔴 THE TRAILING `?` IS THE BLOCK'S DISCRIMINANT, and it is the reason this file
is not a pure rename. Counting REUSES the pure detector in
`scripts/lib/claude_sessions.py` (parse_panes + build_proc_index +
classify_claude_sessions + own_pid_chain) so there is exactly ONE
Claude-session detector in the tree. That module is loaded BY EXPLICIT PATH —
this script is deployed as a lone nix-store symlink into
~/.config/i3status-rust/scripts, so the module must be symlinked BESIDE it
(`home.file` in nix/graphical.nix, exactly like `bar_freshness.py`) and must be
`git add`ed or the flake omits it silently. Both of those are ways for the load
to fail on a host where everything else is healthy — and until now the failure
rendered a bare `󰕮`, byte-identical to "nothing is running". Measured on the
workbench while writing this: 35 live sessions, and a deliberately-unloadable
module rendered the same pixels as zero. So a count that could not be taken now
says so, per the bar-wide rule that a count never travels without its
discriminant. Hide-at-zero is not used here at all: the glyph always shows.

Fail-safe: ANY error (module missing, tmux/proc unavailable, malformed) → the
`?` pill and exit 0. A bar block must never crash loudly.

Unit-tested against fixture tmux/proc data in
scripts/tests/test_claude_runs_block.py; the detector itself is tested in
scripts/tests/test_claude_sessions.py.
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import sys

GLYPH = "\U000f056e"  # 󰕮 nf-md-view_dashboard (verified present in the bar font)
UNMEASURED = "%s ?" % GLYPH
# The last-resort pill for an exception that escaped `main()`. It carries the `?`
# DISCRIMINANT, not the bare glyph — the name used to be `_BARE`, from when this
# fallback really did render `󰕮` alone, i.e. byte-identical to "nothing is
# running". Renamed so the identifier stops asserting the behaviour the rest of
# this file exists to prevent.
_UNMEASURED_PILL = {"text": UNMEASURED, "state": "Idle"}

# Three legs, in the order they are true:
#   1. SIBLING — at runtime this script's directory is
#      ~/.config/i3status-rust/scripts, populated by home.file. This is the leg
#      that runs on a live host.
#   2. ./lib/ — this script's directory is the repo's scripts/, so the module is
#      scripts/lib/. This is the leg that runs from ANY checkout or worktree,
#      including CI, without depending on $DEVRC_DIR pointing at this one.
#   3. $DEVRC_DIR — an explicit override for anything else.
# Leg 2 is not redundant: with only 1 and 3, running this file out of a worktree
# silently resolved the BASE clone (which lacks a brand-new module) and rendered
# `?` — which is how the discriminant above earned its first positive control.
_HERE = os.path.dirname(os.path.abspath(__file__))
_MODULE_PATHS = (
    os.path.join(_HERE, "claude_sessions.py"),
    os.path.join(_HERE, "lib", "claude_sessions.py"),
    os.path.join(
        os.environ.get("DEVRC_DIR", os.path.join(
            os.path.expanduser("~"), "workspace", "devrc")),
        "scripts", "lib", "claude_sessions.py"),
)


def load_detector(paths=_MODULE_PATHS):
    """Load scripts/lib/claude_sessions.py by explicit path.

    Returns the module, or None if no copy is loadable (→ caller renders the
    `?` pill). No sys.path insert: scripts/lib/ holds unrelated modules and a
    path insert would let any of them shadow a name (the CLAUDE.md _db.py /
    llm.py gotcha). `dont_write_bytecode` keeps a __pycache__ out of the
    operator's ~/.config/i3status-rust/scripts."""
    sys.dont_write_bytecode = True
    for p in paths:
        if not os.path.exists(p):
            continue
        try:
            loader = importlib.machinery.SourceFileLoader("_claude_sessions", p)
            spec = importlib.util.spec_from_loader("_claude_sessions", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            return mod
        except Exception:
            continue
    return None


def count_live_sessions(cs, list_panes=None, build_index=None, own_chain=None):
    """Number of live Claude-Code-in-tmux runs — or None if it cannot be counted.

    The three impure fetchers (tmux pane list, /proc index, own-pid chain) are
    injectable so this is unit-testable against fixtures without touching tmux
    or /proc. `cs` is the loaded claude_sessions module.

    🔴 None, NOT 0, on every failure. 0 is a real reading this block takes all
    the time; returning it for "I could not tell" is what made an unloadable
    detector indistinguishable from an idle machine. Never raises."""
    if cs is None:
        return None
    try:
        list_panes = list_panes or cs.list_tmux_panes_raw
        build_index = build_index or cs.build_proc_index
        own_chain = own_chain or cs.own_pid_chain
        panes = cs.parse_panes(list_panes())
        proc_index = build_index()
        own = own_chain()
        return len(cs.classify_claude_sessions(panes, proc_index, own_pids=own))
    except Exception:
        return None


def render(count) -> dict:
    """Pure: live-session count → i3status-rust block dict.

    The glyph always shows; the count is appended only when >0; None (or
    anything non-integral) renders the `?` discriminant. State stays
    neutral/Idle always — this block never demands attention."""
    if count is None:
        return {"text": UNMEASURED, "state": "Idle"}
    try:
        n = int(count)
    except (TypeError, ValueError):
        return {"text": UNMEASURED, "state": "Idle"}
    text = "%s %d" % (GLYPH, n) if n > 0 else GLYPH
    return {"text": text, "state": "Idle"}


def main() -> int:
    cs = load_detector()
    n = count_live_sessions(cs)
    sys.stdout.write(json.dumps(render(n)) + "\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.stdout.write(json.dumps(_UNMEASURED_PILL) + "\n")
        sys.exit(0)
