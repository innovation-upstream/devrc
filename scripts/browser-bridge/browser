      #     at mode 0600, NOT open()+umask (which lands 0644 = world-readable in a
      #     shared, sticky /tmp). mkstemp is also the right primitive against a
      #     pre-planted symlink, rather than relying on filename entropy.
      #   - the payload is VALIDATED before anything is written (strict base64 +
      #     the 8-byte PNG signature), so a malformed capture can never leave a
      #     0-byte ".png" behind that an agent Reads as if it were a screenshot.
      #   - temp captures are AUTO-PRUNED after 24h (best-effort, prefix-scoped).
      printf '%s' "$resp" | python3 -c '
import json,sys,base64,binascii,re,os,stat,tempfile,time

PREFIX = "browser-screenshot-"
SUFFIX = ".png"
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"
RETENTION_S = 24 * 3600

def prune(tmpdir):
    """Best-effort retention: drop OUR temp captures older than 24h. Strictly
    scoped to PREFIX+SUFFIX in tmpdir, never follows a symlink (lstat + a
    regular-file check), and NEVER fails the command — a screenshot must not
    break because a stale file could not be removed."""
    cutoff = time.time() - RETENTION_S
    try:
        entries = list(os.scandir(tmpdir))
    except OSError:
        return
    for e in entries:
        if not (e.name.startswith(PREFIX) and e.name.endswith(SUFFIX)):
            continue
        try:
            st = os.lstat(e.path)          # lstat → a symlink is judged as itself
            if not stat.S_ISREG(st.st_mode):
                continue                   # only ever unlink a REGULAR file
            if st.st_mtime < cutoff:
                os.unlink(e.path)
        except OSError:
            continue

d=json.load(sys.stdin)
try:
    url=d["result"]["data"]["dataUrl"]
except (KeyError, TypeError):
    sys.stderr.write("browser: screenshot response missing image data\n")
    sys.exit(1)
b64=re.sub(r"^data:image/[^;]+;base64,","",str(url)).strip()
# strict=validate: b64decode otherwise SILENTLY ignores non-alphabet chars, so
# junk (and "") would decode to b"" and be written as a 0-byte "successful" png.
try:
    png=base64.b64decode(b64, validate=True)
except (binascii.Error, ValueError) as exc:
    sys.stderr.write("browser: screenshot payload is not valid base64 (%s)\n" % exc)
    sys.exit(1)
if not png.startswith(PNG_MAGIC):
    sys.stderr.write("browser: screenshot payload is not a PNG (%d bytes decoded)\n"
                     % len(png))
    sys.exit(1)

