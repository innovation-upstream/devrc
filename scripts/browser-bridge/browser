        --json) asjson=1; shift ;;
        --) shift; pos_rest "screenshot takes at most one path" "$@"; break ;;
        -*) die "browser screenshot: unknown flag: $1 (try: --fullpage, --data-url, --json; use '--' before a path starting with '-')" ;;
