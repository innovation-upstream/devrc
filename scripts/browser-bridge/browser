        --height=*) emu_height="${1#--height=}"; shift ;;
        --dsf) shift; [ $# -ge 1 ] || die "--dsf needs a value"; emu_dsf="$1"; shift ;;
        --dsf=*) emu_dsf="${1#--dsf=}"; shift ;;
