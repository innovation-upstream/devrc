#!/usr/bin/env bash
# browser-agent — run the autonomous opencode "browser-agent" in its OWN isolated
# Brave tab against a natural-language goal, and return a compact structured
# result (never raw HTML). Invoked as `browser agent "<goal>"` (the `browser` CLI
# execs this) or directly.
#
#   browser agent "<goal>" [--instance K] [--allow-domains a,b] [--deny-domains c,d]
#                          [--steps N] [--timeout S] [--dry-run]
#
# What it does (see README "opencode browser-agent"):
#   1. `open`s a NEW tab on instance K (its OWN tab) at about:blank, captures the
#      tabId, and PROBES it (a NON-INJECTING `browser tabs` listing, no model
#      tokens) to confirm the tab is live/owned before proceeding — re-opening
#      (bounded retry) if a post-reload transient left the tab gone, so the model
#      never gets a doomed tabId. The probe must NOT inject into the page: the
#      tab starts at about:blank, which no host permission covers.
#   2. Runs `opencode run --format json -m <deepseek> --agent browser-agent --auto`
#      in a scratch --dir. The agent def DENIES every built-in tool (bash, edit,
#      read, webfetch, …) and ALLOWS only ONE custom, TYPED tool: `browser`
#      (opencode/tools/browser.js, copied into the scratch project). The model
#      calls it with structured args (op + optional selector/url/js) — it has NO
#      shell, so there is NO `>`/`;`/`|`/`$()` surface (this is the PR #180 RCE
#      fix: a shell output-redirect `browser … >> ~/.zshenv` used to ride the
#      allowed bash command through opencode's wildcard glob → host RCE).
#   3. FORCES the owned tab + instance + domain policy on the tool via env
#      (BROWSER_AGENT_TAB/…): the model cannot choose the tab or reach a denied
#      domain — enforcement lives IN the tool (browser_tool_impl.mjs), which POSTs
#      straight to the loopback bridge (no subprocess).
#   4. Enforces a wall-clock --timeout with a PROCESS-GROUP kill (`setsid` + kill
#      the whole group) so no opencode child can survive a timeout.
#   5. Closes the owned tab on EVERY exit path (success/timeout/error/tab-gone).
#   6. Parses opencode's final message as the required schema
#      {"answer","evidence":[…],"steps_used","status":"ok|partial|blocked"};
#      on malformed output it re-invokes ONCE (`--continue`) demanding ONLY the
#      JSON, then gives up with a `blocked` result (no infinite retry).
#
# Privacy: page content the agent reads is sent to OpenRouter/DeepSeek (accepted
# — see README). The OpenRouter key must already be in opencode's auth store
# (~/.local/share/opencode/auth.json); this script adds NO key.
#
# Test seams (env overrides): BROWSER_AGENT_OPENCODE (opencode binary),
# BROWSER_AGENT_BROWSER_BIN (real browser CLI for open/close), BROWSER_AGENT_MODEL,
# BROWSER_AGENT_TEMPLATE (agent md template), BROWSER_AGENT_TOOL_DIR (dir holding
# browser.js + browser_tool_impl.mjs), BROWSER_AGENT_KEEP_SCRATCH=1,
# BROWSER_AGENT_READY_ATTEMPTS / BROWSER_AGENT_READY_BACKOFF (open→readiness retry),
# BROWSER_AGENT_OPENCODE_CONFIG_DIR (isolated opencode config dir — see below).
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
BROWSER_BIN="${BROWSER_AGENT_BROWSER_BIN:-$HERE/browser}"
PARSER="$HERE/browser-agent-parse.py"
TEMPLATE="${BROWSER_AGENT_TEMPLATE:-$HERE/opencode/browser-agent.md}"
TOOL_DIR="${BROWSER_AGENT_TOOL_DIR:-$HERE/opencode/tools}"
TOOL_JS="$TOOL_DIR/browser.js"
TOOL_IMPL="$TOOL_DIR/browser_tool_impl.mjs"
OPENCODE_BIN="${BROWSER_AGENT_OPENCODE:-opencode}"
MODEL="${BROWSER_AGENT_MODEL:-openrouter/deepseek/deepseek-v4-flash}"

die() { echo "browser-agent: $*" >&2; exit 2; }

# --- isolated opencode CONFIG dir (token containment) ------------------------ #
# devrc now deploys a ~37 KB global ~/.config/opencode/AGENTS.md (PRINCIPLES +
# RULES + addendum). MEASURED on 1.18.4: that file IS injected into a run whose
# --dir is an unrelated scratch project — a tool-less probe in a scratch dir
# quoted a passphrase planted at the END of the file, so it arrives in FULL.
#
# Cost here: 8,343 input tokens vs 631 with an isolated config dir = ~7.7k
# EXTRA PER REQUEST. `cache.read`/`cache.write` were 0 in every run, so it is
# not amortised — it is multiplied by the agent-loop step count ($STEPS,
# default 12), i.e. up to ~90k tokens per browser-agent run. For an agent whose
# every host tool is DENIED (no shell, no file access), 100% of that is rules it
# can neither use nor act on.
#
# Neither mitigation that looks obvious works: OPENCODE_DISABLE_CLAUDE_CODE=1
# had ZERO effect (byte-identical token count), and a project-local AGENTS.md
# does NOT suppress the global one — they are CONCATENATED (both passphrases
# came back, tokens went UP). Relocating the config dir is what works.
#
# 🔴 STABLE AND REUSED, never `mktemp -d` per run. A FRESH config dir makes
# opencode materialise package.json + 63 MB of node_modules (2.6-4.5 s), and
# with no network it HUNG — killed at 120 s having produced 0 bytes, which trips
# the gate below and dies with "produced NO output". A warm reused dir runs
# offline fine (+0.05-0.3 s).
#
# Verified safe for this harness: auth is unaffected (auth.json lives in the
# DATA dir), and the tool-set gate output was BYTE-IDENTICAL (10,670 B, same
# resolved tools map, `browser:true` and every host tool false) under live vs
# isolated config — the custom `browser` tool loads from the scratch project's
# .opencode/tools/, not from the config dir.
#
# NOTE: this dir deliberately does NOT see devrc's global agent/ and plugin/.
# browser-agent needs neither (it defines its own agent and has no shell), so
# that is the intended trade, not an oversight.
OC_CONFIG_DIR="${BROWSER_AGENT_OPENCODE_CONFIG_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/browser-agent-opencode-config}"
mkdir -p "$OC_CONFIG_DIR" || die "cannot create opencode config dir '$OC_CONFIG_DIR'"
# Fail loud if an instruction file ever appears here — that would silently
# reintroduce the whole cost this isolation exists to remove.
for _stray in "$OC_CONFIG_DIR/AGENTS.md" "$OC_CONFIG_DIR/CLAUDE.md"; do
  [ -e "$_stray" ] && die "unexpected instruction file at '$_stray' — the isolated opencode config dir must stay free of AGENTS.md/CLAUDE.md (that is the entire point; see the comment above). Remove it."
done
export OPENCODE_CONFIG_DIR="$OC_CONFIG_DIR"

# Emit a compact schema result on stdout and exit (0 for ok/partial, 1 for
# blocked). NEVER prints raw page content — only the structured schema.
emit_result() {  # <schema-json>
  printf '%s\n' "$1"
  case "$1" in
    *'"status":"ok"'*|*'"status": "ok"'*) exit 0 ;;
    *'"status":"partial"'*|*'"status": "partial"'*) exit 0 ;;
    *) exit 1 ;;
  esac
}

blocked() {  # <reason> [steps_used]
  local reason="$1" steps="${2:-0}"
  emit_result "$(python3 -c '
import json,sys
print(json.dumps({"answer": sys.argv[1], "evidence": [],
                  "steps_used": int(sys.argv[2]), "status": "blocked"},
                 separators=(",",":")))' "$reason" "$steps")"
}

# --- parse args -------------------------------------------------------------- #
GOAL=""; GOAL_SEEN=0; INSTANCE=""; ALLOW=""; DENY=""; STEPS=12; TIMEOUT=120; DRYRUN=0
_csv_to_ws() { printf '%s' "$1" | tr ',' ' '; }
while [ $# -gt 0 ]; do
  case "$1" in
    --instance) shift; [ $# -ge 1 ] || die "usage: --instance <key>"; INSTANCE="$1" ;;
    --instance=*) INSTANCE="${1#--instance=}" ;;
    --allow-domains) shift; [ $# -ge 1 ] || die "usage: --allow-domains a,b"; ALLOW="$(_csv_to_ws "$1")" ;;
    --allow-domains=*) ALLOW="$(_csv_to_ws "${1#--allow-domains=}")" ;;
    --deny-domains) shift; [ $# -ge 1 ] || die "usage: --deny-domains a,b"; DENY="$(_csv_to_ws "$1")" ;;
    --deny-domains=*) DENY="$(_csv_to_ws "${1#--deny-domains=}")" ;;
    --steps) shift; [ $# -ge 1 ] || die "usage: --steps N"; STEPS="$1" ;;
    --steps=*) STEPS="${1#--steps=}" ;;
    --timeout) shift; [ $# -ge 1 ] || die "usage: --timeout S"; TIMEOUT="$1" ;;
    --timeout=*) TIMEOUT="${1#--timeout=}" ;;
    --dry-run) DRYRUN=1 ;;
    -h|--help) grep -E '^#( |$)' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    # `--` ends the flags: everything after it is the goal, even if it starts with
    # `-`. It used to take only the FIRST remaining arg and silently DROP the rest
    # (`browser agent -- g1 g2` ran with goal "g1"), the same drop-after-`--` shape
    # fixed in the `browser` CLI's nine loops. GOAL_SEEN (not [ -z "$GOAL" ]) so an
    # empty first goal cannot be silently overwritten by a second.
    --) shift
        while [ $# -gt 0 ]; do
          [ "$GOAL_SEEN" -eq 0 ] || die "only one goal is accepted (got extra: $1)"
          GOAL="$1"; GOAL_SEEN=1; shift
        done
        break ;;
    -*) die "unknown flag: $1" ;;
    *) [ "$GOAL_SEEN" -eq 0 ] || die "only one goal is accepted (got extra: $1)"; GOAL="$1"; GOAL_SEEN=1 ;;
  esac
  shift
done

[ -n "$GOAL" ] || die "a goal is required: browser agent \"<goal>\""
case "$STEPS" in (*[!0-9]*|"") die "--steps must be a positive integer (got: $STEPS)";; esac
[ "$STEPS" -ge 1 ] 2>/dev/null || die "--steps must be >= 1 (got: $STEPS)"
case "$TIMEOUT" in (*[!0-9]*|"") die "--timeout must be a positive integer of seconds (got: $TIMEOUT)";; esac
[ "$TIMEOUT" -ge 1 ] 2>/dev/null || die "--timeout must be >= 1 (got: $TIMEOUT)"
[ -f "$TEMPLATE" ] || die "agent template not found: $TEMPLATE"
[ -r "$TOOL_JS" ] || die "custom tool not found: $TOOL_JS"
[ -r "$TOOL_IMPL" ] || die "custom tool impl not found: $TOOL_IMPL"
[ -r "$PARSER" ] || die "parser not found: $PARSER"

# opencode must be present BEFORE we open any tab — so a missing binary can never
# leave an orphaned tab.
command -v "$OPENCODE_BIN" >/dev/null 2>&1 || die "opencode not found on PATH ('$OPENCODE_BIN') — install it or set BROWSER_AGENT_OPENCODE"

declare -a bflags=()
[ -n "$INSTANCE" ] && bflags+=(--instance "$INSTANCE")

# --- scratch: per-run agent def (bash denied) + the typed `browser` custom tool - #
# Built BEFORE any tab is opened so the fail-closed tool-set gate (below) can
# resolve the templated agent def AND a gate failure leaks NO tab.
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/browser-agent.XXXXXX")"
TAB=""            # set once the tab is actually opened (below the gate)
_closed=0
# Close the owned tab (if one was opened) on EVERY exit path, then drop scratch.
# `cleanup` no-ops before a tab exists, so a gate-fail exit closes nothing.
cleanup() {
  [ "$_closed" = "1" ] && return 0
  _closed=1
  [ -n "$TAB" ] || return 0
  "$BROWSER_BIN" "${bflags[@]}" --tab "$TAB" close >/dev/null 2>&1 || true
}
_cleanup_all() {
  cleanup
  [ "${BROWSER_AGENT_KEEP_SCRATCH:-0}" = "1" ] || rm -rf "$SCRATCH" 2>/dev/null || true
}
trap _cleanup_all EXIT INT TERM
mkdir -p "$SCRATCH/.opencode/agents" "$SCRATCH/.opencode/agent" \
         "$SCRATCH/.opencode/tools" "$SCRATCH/.opencode/tool"

# Copy the committed TYPED tool (+ its pure-logic sibling) into the scratch
# project so opencode loads exactly ONE tool, `browser`. Write to both `tools/`
# (opencode 1.18.4) and `tool/` (defensive against version skew). The `.mjs`
# sibling is imported by browser.js but is NOT itself registered as a tool
# (opencode globs `*.{ts,js}` only — verified on 1.18.4).
cp "$TOOL_JS" "$TOOL_IMPL" "$SCRATCH/.opencode/tools/"
cp "$TOOL_JS" "$TOOL_IMPL" "$SCRATCH/.opencode/tool/"

# Template the committed agent def: bake the step budget + model in. The tab is
# NOT templated any more — it is FORCED on the tool via env (below), so the model
# has no way to name a tab at all.
AGENT_MD="$SCRATCH/.opencode/agents/browser-agent.md"
sed -e "s/__STEPS__/$STEPS/g" -e "s#__MODEL__#$MODEL#g" "$TEMPLATE" > "$AGENT_MD"
# Some opencode versions read `.opencode/agent/` (singular) — write both.
cp "$AGENT_MD" "$SCRATCH/.opencode/agent/browser-agent.md"

# --- fail-closed tool-set gate (runtime verification, model-free) ------------ #
# Before spending ANY model token — and before opening a tab — verify opencode
# ACTUALLY resolved browser-agent to a BROWSER-ONLY tool set. `opencode debug
# agent` is a read-only config dump (no model spend) that emits the resolved
# `tools` map; we refuse to run unless `browser:true` AND every host tool
# (bash/read/edit/write/webfetch/…) is present AND false. On any opencode
# version/config where the host-tool denial did NOT take (browser tool missing on
# an unsupported version, or a host tool still enabled), this turns a latent
# "runs unconfined" landmine into a loud, safe refusal. `debug agent` has no
# --dir, so we resolve the templated def by running in the scratch project dir.
#
# CAPTURE TO A FILE — NEVER `$(...)`. opencode does not reliably flush stdout
# before exiting when stdout is a PIPE, so a command-substitution capture returns
# a TRUNCATED prefix. Measured on these hosts: `debug skill` 65536 B via pipe vs
# 293329 B via file (deterministic); `debug v2` 55276/55276/6103 B across three
# identical pipe runs — two different cut points AND run-to-run variance, i.e. a
# flush race on exit, not a fixed buffer cap. A truncated JSON document is
# unparseable, so the gate fails closed (correct!) — but the refusal then
# masquerades as an opencode-version problem. Redirecting to a real file removes
# the pipe, and therefore the race: the same command that died with "Unterminated
# string" via `$(...)` parses cleanly to a tool set of ['browser'] from a file.
# $SCRATCH is already mktemp -d'd and rm -rf'd on every exit path.
GATE_OUT="$SCRATCH/gate.json"
( cd "$SCRATCH" && "$OPENCODE_BIN" debug agent browser-agent ) >"$GATE_OUT" 2>/dev/null || \
  die "tool-set gate: 'opencode debug agent browser-agent' failed to RUN (non-zero exit) — cannot confirm a browser-only tool set; refusing to run (see README 'runtime tool-set gate')"
[ -s "$GATE_OUT" ] || \
  die "tool-set gate: 'opencode debug agent browser-agent' produced NO output — cannot confirm a browser-only tool set; refusing to run (see README 'runtime tool-set gate')"
python3 -c '
import json, sys
# Confirm the resolved tool set is browser-ONLY. Fail closed (exit!=0) on ANY
# uncertainty: unparseable output, missing `browser`, `browser` not true, a host
# tool still true, or a host tool absent (absence must NOT read as "disabled").
# Reads the dump from a FILE (argv[1]) — never a pipe (flush race, see above).
try:
    with open(sys.argv[1]) as fh:
        tools = json.load(fh)["tools"]
    assert isinstance(tools, dict)
except Exception as e:
    sys.stderr.write("unparseable debug-agent tool set: %s\n" % e); sys.exit(3)
if tools.get("browser") is not True:
    sys.stderr.write("browser tool not enabled (browser=%r)\n" % tools.get("browser")); sys.exit(4)
enabled = sorted(k for k, v in tools.items() if k != "browser" and v is True)
if enabled:
    sys.stderr.write("host tools still enabled: %s\n" % ",".join(enabled)); sys.exit(5)
required_false = ["bash", "read", "edit", "write", "webfetch"]
missing = [t for t in required_false if t not in tools]
if missing:
    sys.stderr.write("cannot confirm host tools disabled (absent: %s)\n" % ",".join(missing)); sys.exit(6)
sys.exit(0)
' "$GATE_OUT"
gate_rc=$?
# Distinguish the three failure classes — a truncation used to masquerade as a
# version problem, which is exactly what misdirects the diagnosis.
case "$gate_rc" in
  0) : ;;
  3) die "tool-set gate: opencode's debug-agent output was UNPARSEABLE (not JSON, or no \`tools\` map) — cannot confirm a browser-only tool set; refusing to run. Reproduce with a FILE redirect (never a pipe): cd \"$SCRATCH\" && opencode debug agent browser-agent > /tmp/gate.json (see README 'runtime tool-set gate')" ;;
  *) die "tool-set gate FAILED: opencode did not resolve browser-agent to a browser-ONLY tool set — the host-tool denial did not take on this opencode version/config. Refusing to run the model unconfined (see README 'runtime tool-set gate')" ;;
esac

# --- open the agent's own tab (with a pre-flight readiness retry) ------------ #
# Opened AFTER the gate so a gate-fail leaks no tab.
#
# Post-reload transient: right after the extension is reloaded, the service
# worker's tab-tracking isn't settled yet, so the tab we just `open`ed can
# VANISH before the model's first op — opencode then returns status:"blocked"
# with op_failed:owned_tab_gone and the run wastes tokens. So before spending
# ANY model token, VERIFY the freshly-opened tab is actually live/owned with a
# CHEAP, metadata-only, NON-INJECTING probe (`browser tabs` → chrome.tabs
# metadata only, NO page content, NO chrome.scripting). If the probe reports the
# tab is gone, close the stale tab (best-effort) and re-open — bounded retry with
# a short backoff to let the SW settle. Only a probe-passing owned tab is ever
# handed to opencode.
READY_ATTEMPTS="${BROWSER_AGENT_READY_ATTEMPTS:-3}"   # test seam
READY_BACKOFF="${BROWSER_AGENT_READY_BACKOFF:-0.4}"   # test seam (seconds)

_open_tab() {  # open a fresh owned tab; set global TAB; die on a hard open failure
  local open_resp
  open_resp="$("$BROWSER_BIN" "${bflags[@]}" open about:blank 2>/dev/null)" \
    || die "failed to open a tab (is the browser-bridge extension connected? try: browser health)"
  TAB="$(printf '%s' "$open_resp" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin)["result"]["data"]["tabId"])
except Exception:
    pass')"
  case "$TAB" in (*[!0-9]*|"") die "could not determine the opened tabId from: $open_resp";; esac
}

# _probe_tab — model-free readiness check of the CURRENT owned tab ($TAB). Lists
# the browser's tabs (`browser tabs` → pure chrome.tabs metadata: id/url/title/
# active/windowId; NO chrome.scripting injection, NO page content) and asserts
# $TAB is present.
#
# ⚠ WHY NOT `eval '1'` (what this used to do): that made `browser agent`
# IMPOSSIBLE to run — an unconditional, 100%-of-the-time hard failure before the
# model was ever invoked. The agent's tab is deliberately opened at about:blank
# (a neutral start; navigating it somewhere on startup would leak a request the
# caller never asked for and could trip --allow-domains), and chrome.scripting
# CANNOT inject into about:blank — it is not covered by the manifest's <all_urls>
# host permission. So every probe came back with Chrome's
#   Cannot access contents of url "about:blank". Extension manifest must request
#   permission to access this host.
# which is not owned_tab_gone → rc=2 → `die`. Readiness only ever needed to
# answer "does this tab exist and can the bridge see it" — the probe's own
# comment said as much ("NO page content"). `tabs` answers exactly that, for ANY
# url scheme, without needing page-content access at all.
#
# Returns:
#   0 → tab is live/usable (present in the tab list)
#   1 → tab is GONE (absent from the list, or the bridge said owned_tab_gone)
#   2 → some OTHER error (hard failure — surfaced via PROBE_OUT)
# The probe's stdout+stderr are captured into PROBE_OUT and NEVER reach the
# wrapper's own stdout, so neither an op-error dump nor a tab listing can pollute
# the final JSON result.
PROBE_OUT=""
_probe_tab() {
  PROBE_OUT="$("$BROWSER_BIN" "${bflags[@]}" tabs 2>&1)"
  local rc=$?
  if [ "$rc" != "0" ]; then
    # A non-zero `tabs` is a bridge/transport failure (no extension, rate limit,
    # ambiguous instance…) — hard. The owned_tab_gone shapes are kept for
    # robustness in case a future/older extension answers `tabs` per-tab.
    case "$PROBE_OUT" in
      *owned_tab_gone*|*"no tab with id"*|*"No tab with id"*) return 1 ;;
      *) return 2 ;;
    esac
  fi
  # rc=0 → parse the listing and look for $TAB. Reads stdin (never argv) so a
  # large listing can't blow the arg limit.
  local prc
  printf '%s' "$PROBE_OUT" | python3 -c '
import json, sys
# Locate the tabs array inside the CLI envelope ({"ok":…,"result":{…,"data":
# {"tabs":[…]}}}), tolerating any stderr noise around the JSON document.
# exit 0 = tab present, 1 = tab absent (gone), 3 = no parseable tab list.
want = sys.argv[1]
raw = sys.stdin.read()
dec = json.JSONDecoder()
obj = None
i = raw.find("{")
while i != -1:
    try:
        obj = dec.raw_decode(raw[i:])[0]
        break
    except ValueError:
        i = raw.find("{", i + 1)
def find_tabs(o):
    if isinstance(o, dict):
        t = o.get("tabs")
        if isinstance(t, list):
            return t
        for v in o.values():
            r = find_tabs(v)
            if r is not None:
                return r
    elif isinstance(o, list):
        for v in o:
            r = find_tabs(v)
            if r is not None:
                return r
    return None
tabs = find_tabs(obj) if obj is not None else None
if tabs is None:
    sys.exit(3)
sys.exit(0 if any(str(t.get("id")) == want
                  for t in tabs if isinstance(t, dict)) else 1)
' "$TAB"
  prc=$?
  case "$prc" in
    0) return 0 ;;
    1) return 1 ;;
    # Unparseable: replace PROBE_OUT with a SHORT diagnostic — the raw value can
    # be the operator's whole tab list (every url + title), which must not land
    # in a stderr error dump.
    *) PROBE_OUT="could not find a tab list in the \`browser tabs\` response (first 200 bytes: $(printf '%.200s' "$PROBE_OUT"))"
       return 2 ;;
  esac
}

_open_tab
_attempt=1
while : ; do
  _probe_tab; _prc=$?
  [ "$_prc" = "0" ] && break                    # tab is ready — proceed
  if [ "$_prc" = "2" ]; then                     # a non-tab-gone probe error is hard
    die "readiness probe failed unexpectedly on tab $TAB: ${PROBE_OUT}"
  fi
  # _prc == 1: the freshly-opened tab is already gone (post-reload transient).
  if [ "$_attempt" -ge "$READY_ATTEMPTS" ]; then
    die "browser tab not ready after ${READY_ATTEMPTS} attempts — is the extension loaded/connected? try again"
  fi
  # Close the stale (gone) tab best-effort, then re-open a fresh one after a
  # short backoff so the service worker's tab-tracking can settle.
  "$BROWSER_BIN" "${bflags[@]}" --tab "$TAB" close >/dev/null 2>&1 || true
  _attempt=$((_attempt + 1))
  sleep "$READY_BACKOFF" 2>/dev/null || true
  _open_tab
done

TRANSCRIPT1="$SCRATCH/opencode-transcript.jsonl"
TRANSCRIPT2="$SCRATCH/opencode-transcript.retry.jsonl"
ERRLOG="$SCRATCH/opencode.err"
AUDIT_LOG="$SCRATCH/tool-audit.jsonl"
TIMED_OUT_MARKER="$SCRATCH/.timed_out"

# The stable per-session id the tool sends as X-Session-Id (matches the id our
# `open` used; routing is overridden by the forced tab anyway — this is only for
# audit-trail consistency). Sanitize: drop anything that isn't a plain id (a fake
# browser in tests may echo JSON here).
SESSION_ID="$("$BROWSER_BIN" --print-session-id 2>/dev/null || true)"
case "$SESSION_ID" in (*[[:space:]{}\"]*|"") SESSION_ID="" ;; esac

# The per-run task message: goal + the tab constraint + domain rules + the schema
# reminder. (The static harness — single-tool contract, prefer `text`, schema —
# lives in the agent md body.)
MSG="$(cat <<EOF
Goal: $GOAL

You have ONE tool: \`browser\`. Call it with a TYPED op (never a shell command):
  browser(op="text"[, selector])  — read the page's visible text (PREFER THIS)
  browser(op="html")              — raw HTML (huge; last resort)
  browser(op="eval", js="…")      — evaluate a small JS expression
  browser(op="nav", url="…")      — navigate your tab
  browser(op="screenshot")        — capture your tab
Your tab is FIXED — you cannot choose it. Allowed domains: ${ALLOW:-<any>}. Denied: ${DENY:-<none>}.
Hard budget: $STEPS steps. When finished, reply with ONLY the JSON object:
{"answer":"<concise>","evidence":["<quote-or-url>"],"steps_used":<int>,"status":"ok|partial|blocked"}
EOF
)"

run_opencode() {  # <transcript-out> [continue] — returns opencode's exit code (124 on timeout)
  local out="$1" cont="${2:-}"
  local -a oc=(run --format json -m "$MODEL" --agent browser-agent --auto --dir "$SCRATCH")
  [ "$cont" = "continue" ] && oc+=(--continue)
  local -a msg=("$MSG")
  [ "$cont" = "continue" ] && msg=("Return ONLY the required JSON schema object and nothing else: {\"answer\":\"…\",\"evidence\":[…],\"steps_used\":<int>,\"status\":\"ok|partial|blocked\"}")
  rm -f "$TIMED_OUT_MARKER"
  # The model's ONLY action surface is the custom `browser` tool; it reads these
  # from env and FORCES them (the model cannot set the tab/instance/domain policy).
  # BROWSER_BRIDGE_* are inherited so the tool hits the same loopback bridge.
  # Run opencode as its OWN session/process-group leader (setsid) so a --timeout
  # can reap the WHOLE group — opencode may spawn helper children, and killing
  # only the direct pid (what `timeout` does) can orphan them.
  BROWSER_AGENT_TAB="$TAB" BROWSER_AGENT_INSTANCE="$INSTANCE" \
  BROWSER_AGENT_ALLOW_DOMAINS="$ALLOW" BROWSER_AGENT_DENY_DOMAINS="$DENY" \
  BROWSER_AGENT_DRY_RUN="$DRYRUN" BROWSER_AGENT_AUDIT="$AUDIT_LOG" \
  BROWSER_AGENT_SESSION_ID="$SESSION_ID" BROWSER_AGENT_STEPS="$STEPS" \
    setsid "$OPENCODE_BIN" "${oc[@]}" "${msg[@]}" >"$out" 2>>"$ERRLOG" </dev/null &
  local leader=$!               # setsid makes opencode the group leader → PGID == leader
  # Watchdog: after $TIMEOUT, mark + TERM opencode's whole group, then (grace) KILL
  # it. Run the watchdog itself under `setsid` (its own group) with stdio to
  # /dev/null so (a) it never holds this wrapper's stdout pipe — a leaked `sleep`
  # holding the pipe would hang the caller's capture — and (b) we can reap the
  # watchdog AND its inner `sleep` as one group when opencode exits normally.
  setsid bash -c '
    sleep "$1"; : > "$2"
    kill -TERM -"$3" 2>/dev/null; sleep 5; kill -KILL -"$3" 2>/dev/null
  ' _ "$TIMEOUT" "$TIMED_OUT_MARKER" "$leader" >/dev/null 2>&1 </dev/null &
  local wd=$!                   # watchdog group leader → PGID == wd
  wait "$leader" 2>/dev/null; local rc=$?
  # Normal exit: reap the watchdog's whole group (incl. its pending `sleep`).
  # Either way, defensively reap any straggler still in OPENCODE's group (a
  # detached child), so nothing survives this run.
  kill -KILL -"$wd" 2>/dev/null; wait "$wd" 2>/dev/null || true
  kill -KILL -"$leader" 2>/dev/null || true
  # Report a timeout only when the watchdog fired AND the process died by signal
  # (rc>128) — this avoids a race calling a clean/near-simultaneous exit a timeout.
  if [ -f "$TIMED_OUT_MARKER" ] && [ "$rc" -gt 128 ]; then return 124; fi
  return "$rc"
}

# --- attempt 1 --------------------------------------------------------------- #
run_opencode "$TRANSCRIPT1"; rc1=$?
if [ "$rc1" = "124" ]; then
  blocked "opencode timed out after ${TIMEOUT}s" "$STEPS"
fi
if schema="$(python3 "$PARSER" "$TRANSCRIPT1" 2>/dev/null)"; then
  emit_result "$schema"
fi
# A non-zero (non-timeout) opencode exit with no parseable schema is a hard error
# — surface it as `blocked`, no retry (the retry is only for a COMPLETED run whose
# final message was malformed).
if [ "$rc1" != "0" ]; then
  blocked "opencode exited $rc1 without a valid result (see $ERRLOG)" "$STEPS"
fi

# --- attempt 2 (retry once on malformed-but-completed) ----------------------- #
run_opencode "$TRANSCRIPT2" continue; rc2=$?
if [ "$rc2" != "124" ] && schema="$(python3 "$PARSER" "$TRANSCRIPT2" 2>/dev/null)"; then
  emit_result "$schema"
fi
blocked "opencode returned no valid schema after one retry" "$STEPS"
