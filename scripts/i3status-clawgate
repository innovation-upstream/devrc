#!/usr/bin/env python3
"""i3status-rust custom block: clawgate operator-pending task count.

Reads the cache file written by scripts/bar-status-poll and emits ONE
i3status-rust JSON line. This is INSTANT (a local file read) and never touches
the network, so it can never block the bar.

CALM rendering (colour == "look at me"):
  count == 0, measured           -> empty, invisible block (hide-at-zero)
  count > 0                      -> `tasks` icon + count, coloured (state from
                                     the cache; default Warning)
  stuck_count > 0                -> `<count>!<stuck>`, Critical from cache
  stuck_count absent (old cache) -> `<count>?` — NOT measured, not zero
  cache missing/stale/error/OLD  -> `?` (or `!<stuck>?`), VISIBLE — the board
                                     could not be read, which is not an empty one
Click (wired in graphical.nix) opens the clawgate UI.

Text grammar, one rule each: `!N` is "N stuck dispatches"; a TRAILING `?` is
"this reading is not a current measurement". They compose (`!2?` = two stuck as
of the last reading we could take, and that reading is not current).

🔴 WHY THE TEXT IS NOT JUST THE COUNT. It was, and `2 open` rendered byte-for-byte
identically to `2 open + 1 STUCK` (`text 3`, state Warning) — so of the three
surfaces the stuck predicate was built for, the bar could not show a stuck
dispatch at all. The count alone is the number the operator already expects to be
non-zero; the stuck half is the part that is rare and urgent, and it needs its own
glyph, not a shared one.

🔴 WHY AN UNREADABLE CACHE IS NOT AN EMPTY ONE, which is the newer half of this
module. Measured 2026-08-14 against the shipped block: a `stale` payload, an
`error` marker and a missing file ALL rendered `{"text": "", "state": "Idle"}` —
byte-identical to the measured all-clear that hide-at-zero produces for an empty
board. So the pill went dark in exactly the two situations where a wedged
dispatch is least visible elsewhere: the clawgate API being unreachable (the
poller writes `stale`), and the poller itself being dead (the cache simply stops
moving). The second was invisible to this module twice over, because `render`
never read `ts` at all — a cache frozen days ago rendered a confident, current-
looking count. This block is the ONE surface for a stuck dispatch that nothing
can dismiss: the toast is one-shot and destroyed by any dunst restart, the
notification badge clears on `seen`, and `session-manager` is on-demand. A
surface with that job must not answer "I cannot tell" with the same pixels it
uses for "nothing is wrong".

⚠ WHAT THIS DOES NOT CLAIM. The 24-hour wedge of 2026-08-13/14 was NOT this bug:
the cache was fresh throughout, and the pill did render `!2` Critical (verified
against the deployed copy in HM generation 450, 08-13 18:29, i.e. for ~21 of
those 24 hours). This closes the compound case — a wedge during a measurement
outage — not that incident. See the PR.
"""
import importlib.machinery
import importlib.util
import json
import os
import sys
import time

NAME = "clawgate"
ICON = "tasks"
_VALID_STATES = ("Idle", "Info", "Good", "Warning", "Critical")
_EMPTY = {"text": "", "state": "Idle"}


def _load_freshness():
    """Load the co-located `bar_freshness.py` sibling by EXPLICIT PATH.

    Extensionless block scripts cannot be a package, so this is the repo's
    standard sibling-module shape (cf. `notif-center` loading `i3status-notifs`,
    `bar-status-poll` loading `scripts/lib/`). Deliberately NOT wrapped in a
    try: a block that cannot load the freshness predicate cannot know whether
    its cache is current, and `__main__` below turns that into the VISIBLE `?`
    pill rather than a confident count. `dont_write_bytecode` keeps a
    `__pycache__` out of the operator's ~/.config/i3status-rust/scripts.
    """
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "bar_freshness.py")
    loader = importlib.machinery.SourceFileLoader("_bar_freshness", path)
    spec = importlib.util.spec_from_loader("_bar_freshness", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


fresh = _load_freshness()

#: Re-exported so this module's public surface is unchanged by the extraction,
#: and so a reader of this file still finds the number it renders by. The
#: DEFINITION and its derivation from the systemd unit now live in
#: `bar_freshness.py`, which every block imports — the same gate was about to be
#: hand-copied into six more of them.
MAX_CACHE_AGE_SECS = fresh.MAX_CACHE_AGE_SECS


def cache_path() -> str:
    base = os.environ.get("BAR_STATUS_DIR") or os.path.join(
        os.path.expanduser("~"), ".cache", "bar-status")
    return os.path.join(base, NAME + ".json")


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


#: The no-coercion integer reading, now shared with every other block. Kept as a
#: module-level name because this file's own docstrings and tests refer to it: a
#: float `stuck_count` of 2.5 announcing "2 stuck dispatches" is worse than
#: announcing that it could not tell, and an absent key is None, not 0 — see
#: `stuck_suffix`.
_int_or_none = fresh.int_or_none


def stuck_suffix(payload) -> str:
    """The stuck half of the block text: `!N`, `?`, or empty.

    🔴 Three outcomes, not two. `stuck_count: 0` is a MEASURED all-clear and
    renders nothing; a MISSING `stuck_count` is a cache written by a poller that
    predates the predicate, and renders `?` — the count beside it was computed by
    the old status-only rule, so it is not merely missing the stuck half, it is a
    different number. Rendering that as a clean count is the substitution of an
    unread queue for an empty one that this whole module refuses.
    """
    stuck = _int_or_none(payload.get("stuck_count"))
    if stuck is None:
        return "?"
    return "!%d" % stuck if stuck > 0 else ""


#: Freshness, from the ONE definition (`bar_freshness.py`). Re-exported under the
#: names this module already published so nothing that reads the clawgate block
#: has to know the predicate moved.
cache_age_secs = fresh.cache_age_secs
is_current = fresh.is_current


def _unmeasured(payload, icon: str) -> dict:
    """The VISIBLE `?` pill: the board could not be read just now.

    🔴 It stays visible on purpose. Hide-at-zero is the convention for a count
    pill, but a hidden pill means "measured, and there is nothing" — so an
    unreadable cache may not borrow those pixels.

    🔴 AND IT NEVER GETS QUIETER THAN WHAT THE CACHE STILL RECORDS. If the
    payload in front of us carries stuck dispatches, they are still shown
    (`!N?`) and the pill stays Critical: a measurement outage is a reason to
    trust a reading less, never a reason to downgrade an alarm it already
    raised. `parse_telemetry` draws the same line — an UNKNOWN verdict with a
    non-zero count stays Critical and keeps the count.

    ⚠ THE SCOPE OF THAT CLAIM IS EXACTLY THE CACHE, and it took a poller change
    to make it true on the primary path. Two of the three outage shapes reach
    here holding the last known `stuck_count`:
      * the poller FROZE (nobody rewrote the file) — the old payload is still on
        disk, stuck_count and all, and the `ts` gate is what makes it `!N?`;
      * clawgate is UNREACHABLE — `bar-status-poll.stale()` reports `count: 0`
        and nothing else, so this used to drop `24!2`/Critical to a bare
        `?`/Warning, i.e. QUIETER, on the very path the module names as primary.
        `bar-status-poll.carry_stuck_forward` now copies the previous cache's
        `stuck_count` onto the marker, so it arrives here and renders `!2?`.
    The third shape — the file is MISSING or unparseable — carries nothing, and
    honestly renders a bare `?`: this module's whole memory is that one file, so
    when it is gone there is no last reading to be quieter than.
    """
    stuck = _int_or_none((payload or {}).get("stuck_count")) or 0
    if stuck > 0:
        text = "!%d?" % stuck
        return {"icon": icon, "text": text, "short_text": text,
                "state": "Critical"}
    return {"icon": icon, "text": "?", "short_text": "?", "state": "Warning"}


def render(payload, icon: str = ICON, now=None) -> dict:
    """Pure: cache payload (or None) -> i3status-rust block dict.

    Three outcomes, and the middle one is the whole point:
      * NOT MEASURED (None / malformed / stale / error / no or old `ts`)
        -> the visible `?` pill, never the empty one;
      * measured, count <= 0 -> the empty, invisible block (hide-at-zero);
      * measured, count > 0  -> the count, its stuck half, and a colour.

    `now` is injected rather than read here so the freshness gate is testable
    without sleeping; it defaults to the wall clock. Fail-safe throughout: it
    never raises, whatever the file contains.

    🔴 THAT LAST SENTENCE IS A CLAIM, AND IT IS TESTED HERE-AND-ONLY-HERE:
    `test_the_clawgate_render_FUNCTION_is_failsafe_AND_stays_visible` calls this
    function DIRECTLY. Nothing that drives the block as a subprocess can check
    it — `__main__` below catches every exception and prints a byte-identical
    `?` pill, so a `render` that raises unconditionally is invisible to every
    end-to-end test in the file. If you delete that test, this sentence becomes
    a comment again.
    """
    now = time.time() if now is None else now
    # 🔴 The non-dict case is handled SEPARATELY and passes `None` on purpose:
    # `_unmeasured` reads `(payload or {}).get(...)`, so a TRUTHY non-dict
    # (`["a", "list"]`, `"x"`, `3`) would raise there. `fresh.unmeasured` answers
    # for it too, but the payload must not travel.
    if not isinstance(payload, dict):
        return _unmeasured(None, icon)
    if fresh.unmeasured(payload, now):
        return _unmeasured(payload, icon)
    count = _int_or_none(payload.get("count", 0))
    if count is None:
        # A count we refuse to read is not a count of zero.
        return _unmeasured(payload, icon)
    if count <= 0:
        return dict(_EMPTY)
    text = "%d%s" % (count, stuck_suffix(payload))
    state = payload.get("state")
    if state not in _VALID_STATES or state == "Idle":
        state = "Warning"
    return {"icon": icon, "text": text,
            "short_text": text, "state": state}


def main() -> int:
    sys.stdout.write(json.dumps(render(load(cache_path()))) + "\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        # 🔴 The last-resort fallback is the `?` pill, NOT the empty one, for the
        # same reason `render` refuses it: a block that crashed measured nothing,
        # and the operator must be able to tell that from an empty board. Built
        # literally so this path cannot depend on anything that just failed.
        sys.stdout.write(
            '{"icon": "%s", "text": "?", "short_text": "?", '
            '"state": "Warning"}\n' % ICON)
        sys.exit(0)
