#!/usr/bin/env bash
# run3 — run a command with stdout and stderr captured to SEPARATE files.
#
# WHY THIS EXISTS
# ---------------
# Attributing output to the WRONG STREAM produces confident, wrong bug reports.
# Measured three times in one session: a `--json` payload correctly on stdout was
# reported as being on stderr and a subagent was dispatched to fix a bug that did
# not exist; twice more, advisory text on stderr was reported as "polluting
# stdout" after a plain `2>&1` had already erased the distinction.
#
# The idiom that caused it is the one everybody reaches for, and it does NOT do
# what it does in bash:
#
#   zsh  -c 'printf "PAYLOAD\n" 2>&1 >/dev/null | cat'   ->  PAYLOAD
#   bash -c 'printf "PAYLOAD\n" 2>&1 >/dev/null | cat'   ->  (nothing)
#
# zsh's MULTIOS option duplicates stdout onto the pipe as well, so the consumer
# sees STDOUT — the exact opposite of the intent. Reasoning about redirection
# order is therefore not a way to answer "which stream was that on"; only
# separate destinations are. That is all this script does.
#
# Exit status is the COMMAND's, never this wrapper's — a wrapper that swallows a
# non-zero status is how a failure gets read as a pass.
#
# Usage:
#   run3 [-o|--stdout] [-e|--stderr] [-b|--both] [--raw] [--dir DIR] [--] CMD [ARG...]
#
#     -o, --stdout   after the summary, echo the captured stdout
#     -e, --stderr   after the summary, echo the captured stderr
#     -b, --both     both of the above
#     --raw          with exactly one of -o/-e: print ONLY that stream, no
#                    summary and no header, so it can be piped cleanly
#     --dir DIR      create the capture directory under DIR (default: $TMPDIR)
#     -h, --help     this text
#
# Output (on run3's own stdout — the command's streams are in the files):
#   run3: rc=0
#   run3: stdout   1234 B  /tmp/run3.XXXXXXXX/stdout
#   run3: stderr      0 B  /tmp/run3.XXXXXXXX/stderr
#
# The capture directory is created with `mktemp -d` and is NOT removed: reading
# the two files afterwards is the point. It is per-invocation on purpose — a
# fixed shared path like /tmp/out.txt is racy, and a concurrent agent overwrote
# exactly such a path on 2026-08-20.
#
# See claude/RULES.md → "Shell & Tooling Gotchas" (the zsh-is-not-bash bullet).
set -uo pipefail

PROG=run3

die() {
  printf '%s: %s\n' "$PROG" "$*" >&2
  exit 2
}

show_help() {
  # Printed on stdout for -h (a requested help text is not an error), on stderr
  # from die()'s callers. Kept in sync with the header comment by hand; it is
  # short enough that a generator would cost more than it saves.
  printf '%s\n' \
    "usage: $PROG [-o|--stdout] [-e|--stderr] [-b|--both] [--raw] [--dir DIR] [--] CMD [ARG...]" \
    "" \
    "Runs CMD with stdout and stderr captured to SEPARATE files — never merged —" \
    "prints each stream's byte count and path, and exits with CMD's exit code." \
    "" \
    "  -o, --stdout   echo the captured stdout after the summary" \
    "  -e, --stderr   echo the captured stderr after the summary" \
    "  -b, --both     both of the above" \
    "  --raw          with exactly one of -o/-e: print ONLY that stream (no summary)" \
    "  --dir DIR      create the capture directory under DIR (default: \$TMPDIR)" \
    "  -h, --help     this text"
}

echo_out=0
echo_err=0
raw=0
dir=""

while [ $# -gt 0 ]; do
  case "$1" in
    -o|--stdout) echo_out=1; shift ;;
    -e|--stderr) echo_err=1; shift ;;
    -b|--both)   echo_out=1; echo_err=1; shift ;;
    --raw)       raw=1; shift ;;
    --dir)       [ $# -ge 2 ] || die "--dir needs an argument"; dir="$2"; shift 2 ;;
    --dir=*)     dir="${1#--dir=}"; shift ;;
    -h|--help)   show_help; exit 0 ;;
    --)          shift; break ;;
    -*)          die "unknown option: $1 (put -- before a command starting with '-')" ;;
    *)           break ;;
  esac
done

[ $# -ge 1 ] || die "no command given (see $PROG --help)"

if [ "$raw" = 1 ] && [ $((echo_out + echo_err)) -ne 1 ]; then
  die "--raw needs exactly one of -o/--stdout or -e/--stderr"
fi

if [ -n "$dir" ]; then
  mkdir -p -- "$dir" || die "cannot create --dir: $dir"
  capdir=$(mktemp -d -- "$dir/$PROG.XXXXXXXX") || die "mktemp -d failed under $dir"
else
  capdir=$(mktemp -d -- "${TMPDIR:-/tmp}/$PROG.XXXXXXXX") || die "mktemp -d failed"
fi

outf="$capdir/stdout"
errf="$capdir/stderr"

# 🔴 THE WHOLE POINT: two destinations, in two separate redirections. There is
# deliberately no `2>&1` anywhere in this file — merging is the defect it exists
# to prevent, and `scripts/tests/test_run3.py` asserts the source stays clean.
"$@" >"$outf" 2>"$errf"
rc=$?

# `wc -c < file` can pad with leading spaces; the arithmetic expansion normalises
# it to a bare integer so the summary is machine-readable.
out_b=$(( $(wc -c <"$outf") ))
err_b=$(( $(wc -c <"$errf") ))

if [ "$raw" = 1 ]; then
  if [ "$echo_out" = 1 ]; then cat -- "$outf"; else cat -- "$errf"; fi
  exit "$rc"
fi

printf '%s: rc=%d\n' "$PROG" "$rc"
printf '%s: stdout %8d B  %s\n' "$PROG" "$out_b" "$outf"
printf '%s: stderr %8d B  %s\n' "$PROG" "$err_b" "$errf"

if [ "$echo_out" = 1 ]; then
  printf -- '--- stdout (%d B) ---\n' "$out_b"
  cat -- "$outf"
fi
if [ "$echo_err" = 1 ]; then
  printf -- '--- stderr (%d B) ---\n' "$err_b"
  cat -- "$errf"
fi

exit "$rc"
