#!/usr/bin/env python3
"""i3status-rust custom block: firing civitai-prod alert count (CLIENT cluster).

Reads the cache file written by scripts/bar-status-poll (the `civitai` source)
and emits ONE i3status-rust JSON line. INSTANT local file read — never touches
the network, never blocks the bar.

Kept a SEPARATE block from i3status-alerts (homelab) by design, and made VISUALLY
DISTINCT from it — a `civ` text label prefixes the count (`civ 317`) so civitai
prod can be told apart from the homelab alert count at a glance.

CALM rendering (colour == "look at me"):
  measured, count <= 0                -> empty, invisible block (hide-at-zero)
  measured, count > 0                 -> `󰀪` alert glyph + `civ <count>`,
                                          coloured (Critical if any critical is
                                          firing, else the cache's state)
  UNMEASURED (missing / corrupt /     -> `󰀪 civ ?`, VISIBLE (Warning) — CLIENT
   stale / error / stopped refreshing)   PROD could not be read, which is not a
                                         healthy client prod
Click (wired in graphical.nix) opens the civitai Grafana.

🔴 WHY AN UNREADABLE CACHE IS NOT A HEALTHY ONE, AND WHY THIS BLOCK CARES MOST.
It rendered as one, measured 2026-08-14: a `stale` payload, an `error` marker, a
missing file and a cache the poller had stopped refreshing ALL produced
`{"text": "", "state": "Idle"}` — byte-identical to the measured all-clear. This
is a CLIENT PROD cluster reached through its own kubeconfig and its own
port-forward, i.e. the source most likely of the seven to fail on its own while
everything else on the bar stays green, and the one whose silence is most
expensive. "Red is CORRECT when real" is the standing rule for this pill; a
blackout that renders as no-red-at-all is the same claim made without a
measurement. And nothing here read the `ts` the poller stamps, so a cache nobody
had rewritten for days rendered a confident, present-tense count.

The leading glyph is the nf-md-alert triangle (rendered from the bar font),
deliberately DISTINCT from the notifications-pill bell so a firing alert never
reads as an unseen notification. Same glyph as the homelab alerts block; the
`civ` label is what tells the two count blocks apart. Text grammar, shared with
the rest of the bar: a TRAILING `?` is "this reading is not a current
measurement".
"""
import importlib.machinery
import importlib.util
import json
import os
import sys
import time

NAME = "civitai"
# nf-md-alert 󰀪 (U+F002A) — a warning triangle, rendered in the bar's
# JetBrainsMono Nerd Font. Prepended to the text (not the i3status-rust `icon`
# field) because the material-nf icon set has no alert/warning glyph. Same
# glyph as i3status-alerts (differentiated by the `civ` LABEL below).
ALERT_GLYPH = "\U000f002a"
LABEL = "civ"
_VALID_STATES = ("Idle", "Info", "Good", "Warning", "Critical")
_EMPTY = {"text": "", "state": "Idle"}


def _load_freshness():
    """Load the co-located `bar_freshness.py` sibling by EXPLICIT PATH.

    Extensionless block scripts cannot be a package, so this is the repo's
    standard sibling-module shape (cf. `notif-center` loading `i3status-notifs`,
    `bar-status-poll` loading `scripts/lib/`). Deliberately NOT wrapped in a
    try: a block that cannot load the freshness predicate cannot know whether
    its cache is current, and `__main__` below turns that into the VISIBLE `?`
    pill rather than a confident count. `dont_write_bytecode` keeps a
    `__pycache__` out of the operator's ~/.config/i3status-rust/scripts.
    """
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "bar_freshness.py")
    loader = importlib.machinery.SourceFileLoader("_bar_freshness", path)
    spec = importlib.util.spec_from_loader("_bar_freshness", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


fresh = _load_freshness()


def unknown_pill(glyph: str = ALERT_GLYPH) -> dict:
    """The VISIBLE "could not be read" pill: glyph, `civ`, then a bare `?`.

    Carries the SAME `civ` label the measured pill does, so an operator seeing a
    `?` knows which of the two alert pills lost its measurement — the homelab
    one renders `󰀪 ?` with no label. Warning rather than Critical because
    "cannot tell" is not a confirmed fire; it must never be the empty block,
    which means "measured, and nothing is firing".
    """
    text = "%s %s ?" % (glyph, LABEL)
    return {"text": text, "short_text": text, "state": "Warning"}


def cache_path() -> str:
    base = os.environ.get("BAR_STATUS_DIR") or os.path.join(
        os.path.expanduser("~"), ".cache", "bar-status")
    return os.path.join(base, NAME + ".json")


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def render(payload, glyph: str = ALERT_GLYPH, red_above: int = 0,
           now=None) -> dict:
    """Pure: cache payload (or None) -> i3status-rust block dict.

    Three outcomes, and the first is the one this module gained:
      * NOT MEASURED (None / malformed / stale / error / no or old `ts`)
        -> the visible `?` pill, never the empty one;
      * measured, count <= 0 -> the empty, invisible block (hide-at-zero);
      * measured, count > 0  -> glyph, `civ`, the count, and a colour.

    Visible text always carries the `civ ` label so it reads distinctly from the
    homelab alerts block — including on the `?` pill, where knowing WHICH prod
    cluster went unreadable is the whole content of the message.

    red_above: the standing-backlog baseline. count <= red_above shows the count
    but NEUTRAL (no colour); red is reserved for the count climbing ABOVE the
    known backlog. red_above=0 => colour whenever >0. 🔴 It applies to a MEASURED
    count only — a backlog baseline is a statement about how many alerts are
    boring, and says nothing about a reading that does not exist.

    `now` is injected rather than read here so the freshness gate is testable
    without sleeping; it defaults to the wall clock. Fail-safe throughout: it
    never raises, whatever the file contains — a claim only a DIRECT call can
    test, since `__main__` below prints a `?` pill for any exception.
    """
    now = time.time() if now is None else now
    if fresh.unmeasured(payload, now):
        return unknown_pill(glyph)
    count = fresh.int_or_none(payload.get("count", 0))
    if count is None:
        # A count we refuse to read is not a count of zero. `int()` would coerce
        # `"2"`, `2.5` and `True` into confident numbers nobody measured.
        return unknown_pill(glyph)
    if count <= 0:
        return dict(_EMPTY)
    if count <= red_above:
        state = "Idle"
    else:
        state = payload.get("state")
        if state not in _VALID_STATES or state == "Idle":
            state = "Critical"
    text = "%s %s %d" % (glyph, LABEL, count)
    return {"text": text, "short_text": text, "state": state}


def _red_above_arg() -> int:
    """Parse `--red-above N` from argv (default 0 = colour whenever count>0)."""
    argv = sys.argv[1:]
    if "--red-above" in argv:
        try:
            return int(argv[argv.index("--red-above") + 1])
        except (IndexError, ValueError):
            return 0
    return 0


def main() -> int:
    sys.stdout.write(
        json.dumps(render(load(cache_path()), red_above=_red_above_arg())) + "\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        # 🔴 The last-resort fallback is the `?` pill, NOT the empty one: a block
        # that crashed measured nothing, and that must not look like a healthy
        # client prod. Built literally so it cannot depend on anything that just
        # failed — including the sibling module the import above may not have
        # found.
        sys.stdout.write(
            '{"text": "%s %s ?", "short_text": "%s %s ?", "state": "Warning"}\n'
            % (ALERT_GLYPH, LABEL, ALERT_GLYPH, LABEL))
        sys.exit(0)
