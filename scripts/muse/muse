#!/usr/bin/env bash
# muse — one command surface over the user's Meta Muse personal agent.
#
# Channels (design: homelab-talos claudedocs/muse-agent-integration-design.md):
#   B1  browser   — browser-bridge flows/muse.ai.md. PRIMARY (operator's call
#                   2026-10-01: Brave's remote-debugging toggle is unavailable
#                   for the muse-cli cookie export, and B1 is the design's
#                   default channel anyway).
#   B2  muse-cli  — programmatic (cookies -> HTTPS -> Noise-XX WS). Behind
#                   --cli; blocked on the cookie-export step working on Brave.
#   A   muse-bridge — READ-ONLY cluster status (public HTTPS + bearer token).
#
# THREAD ROUTING (B1, mapped live 2026-10-01): the sidebar's thread rows are
# the routing contract — "Main chat" plus the side chats, active row marked
# aria-current=page, titles CLEANED of "Unread updates" and relative-time
# suffixes before matching. Thread ids live nowhere readable (row DOM, localStorage)
# — routes are title-resolved, click-landed, and landing-VERIFIED. Default
# send/poll stay on Main chat; --thread "<name>" routes explicitly.
#
# Cookie handling is muse-cli's OWN storage only (~/.config/muse-cli/cookies.txt,
# mode 600). This wrapper never reads, copies, echoes or logs cookies. The
# browser-bridge deliberately has no cookie op — never add one. Never commit or
# send a cookie or the bridge token anywhere.
#
# Pacing: sends are human-paced (a few/hour, design §4-B2). The wrapper refuses
# a second send within $MUSE_MIN_SEND_GAP_MIN minutes (default 10) unless
# --force; the guard is a reminder, not a rate limiter.
#
# Muse's per-host APPROVAL prompts are the OPERATOR's security gate: this
# wrapper DETECTS a pending approval and stops (exit 5) rather than clicking
# Allow on Muse's behalf.
#
# Exit codes: 0 ok · 1 dispatch failed (B1 detail printed) · 2 usage · 3
# muse-cli auth needed · 4 bridge query failed · 5 operator approval pending.
set -euo pipefail

MUSE_CLI_BIN=${MUSE_CLI:-muse-cli}
BB_BIN=${MUSE_BB:-$HOME/workspace/devrc/scripts/browser-bridge/browser}
HOMELAB_REPO=${MUSE_HOMELAB_REPO:-$HOME/workspace/homelab-talos}
BRIDGE_URL=${MUSE_BRIDGE_URL:-https://muse-bridge.zacx.dev}
MIN_SEND_GAP_MIN=${MUSE_MIN_SEND_GAP_MIN:-10}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/muse
TOKEN_ENC_REL=clusters/homelab/apps/muse/muse-bridge-token.enc.yaml
B1_INSTANCE=${MUSE_B1_INSTANCE:-personal}

usage() {
  cat <<'EOF'
muse — dispatch/poll the user's Muse agent; cluster status via muse-bridge.

  muse send "<task>" [--wait N] [--force] [--cli]   dispatch + await the reply
                                   B1 browser flow by default (--wait default
                                   180); --cli routes through muse-cli (needs
                                   its one-time cookie export)
  muse send "<task>" --thread "<name>"              route the dispatch into a
                                   SIDE CHAT resolved by title (exact, then
                                   unique prefix; 0/2+ matches list candidates)
  muse poll [--cli] [--thread "<name>"]             latest assistant reply, scoped
                                   to the named side chat when --thread is given
  muse threads                                      the B1 thread list (JSON: Main
                                   chat + side chats, with unread/active flags)
  muse status [ns|nodes|workloads <ns>|flux <ns>]   CLUSTER snapshot (A)
  muse vm                                           Muse VM/session status (B2)
  muse auth [export|...]                            muse-cli auth passthrough
  muse b1                                           the browser-flow recipe
  muse setup                                        runbook pointers

Env: MUSE_CLI, MUSE_BB, MUSE_HOMELAB_REPO, MUSE_BRIDGE_URL,
MUSE_MIN_SEND_GAP_MIN (0 disables the pacing guard), MUSE_B1_INSTANCE.
EOF
}

die() { printf 'muse: %s\n' "$1" >&2; exit "${2:-2}"; }

b1_hint() {
  cat >&2 <<'EOF'
muse: muse-cli failed — falling back to the B1 browser flow:
  BB=~/workspace/devrc/scripts/browser-bridge/browser
  $BB --instance personal open https://muse.ai   # your OWN tab; never the user's
  then follow $DEVRC/scripts/browser-bridge/flows/muse.ai.md exactly
  (snapshot -> type -> assert len -> Enter -> confirm -> poll the DELTA).
  Run `muse b1` for the full recipe. If the failure was 403/API churn, the
  internal APIs moved: re-derive per muse-cli docs, do NOT debug the bridge.
EOF
}

need_muse_cli() {
  command -v "$MUSE_CLI_BIN" >/dev/null 2>&1 || die "muse-cli not found. Install: uv tool install muse-cli (or pipx install muse-cli). Then 'muse auth export' — see 'muse setup'." 3
}

# --- B1 plumbing ------------------------------------------------------------
# bb_js <expr>: run a js op on the B1 tab (wake'd) and print result.data.value.
# Prints nothing and returns non-zero on an op failure.
bb_js() {
  "$BB_BIN" "$B1_REF" js "$1" --wake=3000 2>/dev/null \
    | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(1)
r=d.get("result") or {}
print((r.get("data") or {}).get("value",""),end="")'
}

# b1_state: one read of the live chat state, as shell vars.
# Sets: COMPOSER(yes/no) ASST USER LASTID LEN APPROVAL
b1_state() {
  local v
  v=$(bb_js '(function(){var t=document.querySelector("textarea[placeholder=Message]");var a=document.querySelectorAll("[data-message-role=assistant]");var u=document.querySelectorAll("[data-message-role=user]");var l=a[a.length-1];var b=document.body.innerText;var na=b.indexOf("Needs approval")>=0||b.indexOf("Needs review")>=0;return JSON.stringify({c:!!t,tl:t?t.value.length:-1,a:a.length,u:u.length,id:l?l.getAttribute("data-message-id"):"none",len:l?(l.innerText||"").length:0,ap:na})})()') || return 1
  [ -n "$v" ] || return 1
  # Parse via argv (the value is never interpolated into code text); read the
  # six fields from a HERESTRING — a pipe's read block would run in a subshell
  # and lose every variable.
  local parsed
  parsed=$(python3 -c 'import json,sys
d=json.loads(sys.argv[1])
print("yes" if d["c"] else "no", d["tl"], d["a"], d["u"], d["id"], d["len"], "yes" if d["ap"] else "no")' "$v" 2>/dev/null) || return 1
  read -r COMPOSER TALEN ASST USER LASTID LEN APPROVAL <<<"$parsed"
}

b1_open() {
  local out rc=0 tab
  # 🔴 `open` exits 3 when its --wake FOLLOW-UP fails — the tab still opened
  # (rc 1 = the whole command failed; rc 2/4 = bridge/instance problems). Parse
  # the JSON regardless; die only when there is no tabId.
  out=$("$BB_BIN" --instance "$B1_INSTANCE" open https://muse.ai --wake=4000 2>/dev/null) || rc=$?
  tab=$(printf '%s' "$out" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    print((d.get("result") or {}).get("data",{}).get("tabId",""))
except Exception:
    print("")') || tab=""
  if [ -z "$tab" ]; then
    die "browser-bridge could not open muse.ai on instance '$B1_INSTANCE' (\$BB whoami first). Is the bridge up? rc=${rc}" 1
  fi
  B1_REF="bw://laptop/$B1_INSTANCE/$tab"
  B1_TAB=$tab
}

b1_close() { [ -n "${B1_TAB:-}" ] && "$BB_BIN" "$B1_REF" close >/dev/null 2>&1 || true; }

# --- B1 thread plumbing (mapped live 2026-10-01) ----------------------------
# The sidebar carries one row per thread: row 0 "Main chat" (alone in a
# div.grow-1 container), the side chats as siblings in a div.gap-px container.
# The ACTIVE thread is the row with aria-current=page. Row text = title +
# optional "Unread updates" + optional lowercase relative time ("10m", "1h",
# clock) — titles must be CLEANED before matching; raw text never matches.
# Thread ids are NOT in the row DOM and NOT in localStorage (checked:
# hatch:* keys carry none) — cleaned TITLES are the routing contract. A
# thread page lands at https://muse.ai/thread/<uuid>; main chat is /.
# A JS IIFE (the js op evaluates ONE expression; multi-statement bodies
# return null with no error).
# Suffix vocabulary measured on rows 2026-10-01: "just now", "10m"/"1h"
# (lowercase \d+[smhd] ONLY — case-sensitive, so a title ending "3D" is
# safe), clock times ("2:48 PM", case-insensitive). The time suffix can
# APPEAR BETWEEN reads (rows render it after hydration), so the cleaner runs
# at every read and the landing verify tolerates it (see b1_route).
clean_title_js='function(t){t=(t||"").replace(/\s+/g," ").trim().replace(/unread updates/ig,"").replace(/\s+/g," ").trim();t=t.replace(/ (just now)$/i,"").replace(/ (\d{1,2}:\d{2}( ?am| ?pm)?)$/i,"").replace(/ (\d+[smhd]|am|pm)$/,"").trim();return t}'

threads_read_js="(function(){var f=${clean_title_js};var rows=document.querySelectorAll('[data-testid=hatch-thread-row]');var out=[];for(var i=0;i<rows.length;i++){var e=rows[i];var p=e.parentElement,pos=0;for(var j=0;j<p.children.length;j++){if(p.children[j]===e){pos=j+1;break}}var pcls=(p.className||'').toString();var pc=pcls.indexOf('grow-1')>=0?'grow-1':(pcls.indexOf('gap-px')>=0?'gap-px':'');var raw=(e.innerText||'');out.push({sel:pc?('div.'+pc+' > [data-testid=\"hatch-thread-row\"]:nth-child('+pos+')'):'',title:f(raw),unread:raw.toLowerCase().indexOf('unread updates')>=0,active:e.getAttribute('aria-current')==='page'})}return JSON.stringify(out)})()"

active_thread_js="(function(){var f=${clean_title_js};var c=document.querySelectorAll('[data-testid=hatch-thread-row][aria-current=page]');return JSON.stringify({active:c.length?f(c[0].innerText||''):'',path:location.pathname})})()"

# b1_threads_read: one read of the sidebar rows. Sets THREADS_JSON (an array of
# {sel,title,unread,active}). Returns non-zero when the read fails or is empty.
b1_threads_read() {
  local v
  v=$(bb_js "$threads_read_js") || return 1
  [ -n "$v" ] || return 1
  THREADS_JSON=$v
}

# b1_wait_sidebar: wait for the sidebar to render (fresh tabs hydrate the
# shell DOM first — rows are part of the sidebar, not the feed).
b1_wait_sidebar() {
  local deadline=$((SECONDS + 12))
  while :; do
    if b1_threads_read && [ "$(printf '%s' "$THREADS_JSON" | python3 -c 'import json,sys
try: print(len(json.load(sys.stdin)))
except Exception: print(0)')" -gt 0 ] 2>/dev/null; then
      return 0
    fi
    [ $SECONDS -lt $deadline ] || return 1
    sleep 2
    "$BB_BIN" "$B1_REF" wake --wait 3000 >/dev/null 2>&1 || true
  done
}

# b1_route <name>: resolve a thread by cleaned title and OPEN it in the B1 tab.
# Resolution: exact cleaned-title match, then unique prefix. 0/2+ matches die
# LISTING candidates — a silent guess would dispatch into the wrong
# conversation. The landing is VERIFIED (aria-current title equality + page
# shape) — the click is a trusted CDP op (a JS .click() is not trusted here).
b1_route() {
  local name="$1"
  b1_wait_sidebar || die "B1: the thread sidebar never rendered (no rows after 12s) — see 'muse b1' to drive it by hand." 1
  local outcome sel title
  outcome=$(python3 - "$THREADS_JSON" "$name" <<'PYEOF'
import json, sys
rows = json.loads(sys.argv[1])
req = sys.argv[2].strip().lower()
exact = [r for r in rows if r["title"].lower() == req]
cands = exact or [r for r in rows if r["title"].lower().startswith(req)]
if not cands:
    print("NOMATCH " + json.dumps([r["title"] for r in rows]))
elif len(cands) > 1:
    print("AMBIG " + json.dumps([r["title"] for r in cands]))
else:
    print("MATCH " + json.dumps(cands[0]))
PYEOF
) || die "B1: thread match failed (unreadable sidebar JSON)" 1
  case "$outcome" in
    MATCH*)  outcome=${outcome#MATCH } ;;
    NOMATCH*) die "B1: no thread matching '$name'. Available: ${outcome#NOMATCH }" 1 ;;
    AMBIG*)  die "B1: '$name' matches several threads: ${outcome#AMBIG }" 1 ;;
    *)       die "B1: thread match returned an unknown outcome" 1 ;;
  esac
  sel=$(printf '%s' "$outcome" | python3 -c 'import json,sys
print(json.load(sys.stdin).get("sel",""))')
  title=$(printf '%s' "$outcome" | python3 -c 'import json,sys
print(json.load(sys.stdin).get("title",""))')
  [ -n "$sel" ] || die "B1: thread row '$title' has no clickable selector" 1
  "$BB_BIN" "$B1_REF" click "$sel" >/dev/null 2>&1 || die "B1: the thread-row click failed (selector '$sel')" 1
  sleep 3
  local landed atitle apath
  landed=$(bb_js "$active_thread_js") || die "B1: cannot read the active thread after routing" 1
  atitle=$(printf '%s' "$landed" | python3 -c 'import json,sys
print(json.load(sys.stdin).get("active",""))')
  apath=$(printf '%s' "$landed" | python3 -c 'import json,sys
print(json.load(sys.stdin).get("path",""))')
  # Landing verify is PREFIX-tolerant: the time suffix vocabulary can render a
  # label the cleaner has never seen ("just now" was measured only because a
  # verify run caught it) — the route guarantees WHICH row was clicked, so the
  # verify detects landing, not re-matching.
  case "$atitle" in
    "$title"|"$title "*) : ;;
    *) die "B1: routing did not land on '$title' (active: '$atitle') — stopping instead of dispatching into the wrong conversation." 1 ;;
  esac
  if [ "$title" = "Main chat" ]; then
    [ "$apath" = "/" ] || die "B1: expected the main-chat page (/) after routing — got $apath." 1
  else
    case "$apath" in /thread/*) : ;; *) die "B1: expected a /thread/<id> page after routing to '$title' — got $apath." 1 ;; esac
  fi
  ROUTED_TITLE=$title
  ROUTED_PATH=$apath
}

# cmd_threads: the B1 thread list (read-only). Open a tab, read the sidebar,
# print JSON, close. This is the resolver surface callers use to pick a
# --thread value; it never needs the feed and never types.
cmd_threads() {
  b1_open
  trap 'b1_close' EXIT
  sleep 2
  b1_wait_sidebar || die "B1: the thread sidebar never rendered (no rows after 12s) — see 'muse b1' to drive it by hand." 1
  python3 - "$THREADS_JSON" <<'PYEOF'
import json, sys
print(json.dumps({"threads": json.loads(sys.argv[1])}))
PYEOF
}

# --- pacing guard -----------------------------------------------------------
pace_check() {
  [ "$MIN_SEND_GAP_MIN" -eq 0 ] 2>/dev/null && return 0
  mkdir -p "$STATE_DIR"
  local stamp="$STATE_DIR/last-send"
  if [ -f "$stamp" ]; then
    local last now diff_min
    last=$(stat -c %Y "$stamp" 2>/dev/null || echo 0)
    now=$(date +%s)
    diff_min=$(( (now - last) / 60 ))
    if [ "$diff_min" -lt "$MIN_SEND_GAP_MIN" ]; then
      die "last send was ${diff_min}m ago (pacing: >=${MIN_SEND_GAP_MIN}m between sends, human-paced per design §4-B2). Use --force to override deliberately." 2
    fi
  fi
}

pace_mark() { mkdir -p "$STATE_DIR"; date +%s > "$STATE_DIR/last-send"; }

# --- verbs ------------------------------------------------------------------
cmd_send() {
  local wait=180 force=0 use_cli=0 thread=""
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait)   wait="$2"; shift 2 ;;
      --thread) thread="$2"; shift 2 ;;
      --force)  force=1; shift ;;
      --cli)    use_cli=1; shift ;;
      *)        args+=("$1"); shift ;;
    esac
  done
  [ ${#args[@]} -gt 0 ] || die "send needs task text: muse send \"<task>\"" 2
  [ "$force" -eq 1 ] || pace_check
  if [ "$use_cli" -eq 1 ]; then cmd_send_cli "${args[@]}" --wait "$wait" ${thread:+--thread "$thread"}; return; fi
  cmd_send_b1 "${args[@]}" "$wait" "$thread"
}

# B1 send: open own tab -> [route to the named side chat] -> gate checks ->
# type/assert -> Enter/confirm -> poll the delta -> close. Routing happens
# BEFORE the hydrate gate so the feed gates apply to the ROUTED page (the
# composer/feed contract is identical on thread pages — mapped live
# 2026-10-01). Never auto-approves: a pending Muse approval is the operator's
# security gate and stops the wrapper (exit 5).
cmd_send_b1() {
  local task="$1"; shift
  local wait="${1:-180}"
  local thread="${2:-}"
  ROUTED_TITLE="" ROUTED_PATH=""
  b1_open
  trap 'b1_close' EXIT
  if [ -n "$thread" ]; then b1_route "$thread"; fi
  # 🔴 The composer mounts BEFORE the feed hydrates: a fresh hidden tab can
  # read composer=yes with a skeleton feed (measured 2026-10-01), and Enter
  # into that shell does nothing. Gate the send on the FEED having nodes.
  sleep 2
  if ! b1_state; then
    "$BB_BIN" "$B1_REF" wake --wait 4000 >/dev/null 2>&1 || true
    b1_state || die "B1: cannot read the muse.ai chat state (composer/feed) in the new tab — see 'muse b1' to drive it by hand. Tab left open: $B1_REF" 1
  fi
  local hydrate_deadline=$((SECONDS + 20))
  while [ "$ASST" -eq 0 ] && [ "$USER" -eq 0 ] && [ $SECONDS -lt $hydrate_deadline ]; do
    sleep 3
    "$BB_BIN" "$B1_REF" wake --wait 3000 >/dev/null 2>&1 || true
    b1_state || true
  done
  if [ "$ASST" -eq 0 ] && [ "$USER" -eq 0 ]; then
    trap - EXIT
    die "B1: the feed never hydrated (0 messages after 20s) — the tab is stuck on a shell DOM. Tab left open: $B1_REF (wake it / reload, then re-run)." 1
  fi
  if ! b1_state; then
    "$BB_BIN" "$B1_REF" wake --wait 4000 >/dev/null 2>&1 || true
    b1_state || die "B1: cannot read the muse.ai chat state (composer/feed) in the new tab — see 'muse b1' to drive it by hand." 1
  fi
  if [ "$APPROVAL" = "yes" ]; then
    trap - EXIT
    die "B1: a Muse APPROVAL is pending (the chat shows 'Needs approval'). The composer is gated while it waits — review it in the Muse UI (your security gate; this wrapper never clicks Allow), then re-run. Tab left open: $B1_REF" 5
  fi
  if [ "$COMPOSER" != "yes" ]; then
    "$BB_BIN" "$B1_REF" wake --wait 5000 >/dev/null 2>&1 || true
    b1_state || true
    trap - EXIT
    [ "$COMPOSER" = "yes" ] || die "B1: no composer mounted (the app may be in an error state — reload https://muse.ai in tab $B1_REF and re-run)." 1
  fi
  local base_asst=$ASST base_user=$USER base_id=$LASTID base_len=$LEN
  "$BB_BIN" "$B1_REF" type "$task" --selector 'textarea[placeholder="Message"]' >/dev/null 2>&1 || die "B1: the type op failed" 1
  local got rc=1
  for attempt in 1 2; do
    got=$(bb_js '(function(){var t=document.querySelector("textarea[placeholder=Message]");return t?("len="+t.value.length):"gone"})()') || got="gone"
    [ "$got" = "len=${#task}" ] && rc=0 && break
    "$BB_BIN" "$B1_REF" wake --wait 3000 >/dev/null 2>&1 || true
    "$BB_BIN" "$B1_REF" type "$task" --selector 'textarea[placeholder="Message"]' >/dev/null 2>&1 || true
  done
  trap - EXIT
  [ "$rc" -eq 0 ] || die "B1: the composer did not take the typed text after retry (got '${got:-?}', wanted len=${#task}). Re-throttled tab or a UI change — see 'muse b1'." 1
  "$BB_BIN" "$B1_REF" key Enter --selector 'textarea[placeholder="Message"]' >/dev/null 2>&1 || true
  sleep 4
  if ! b1_state; then "$BB_BIN" "$B1_REF" wake --wait 3000 >/dev/null 2>&1 || true; b1_state || die "B1: state unreadable right after submit" 1; fi
  # "Cleared" = the composer VALUE is empty (the element itself always stays
  # mounted — checking its existence is how Enter #1 was misread as inert,
  # measured 2026-10-01) AND a new user node appeared.
  if [ "$TALEN" -ne 0 ] || [ "$USER" -le "$base_user" ] 2>/dev/null; then
    # Inert Enter (re-throttled tab) — re-wake and submit once more.
    "$BB_BIN" "$B1_REF" wake --wait 3000 >/dev/null 2>&1 || true
    "$BB_BIN" "$B1_REF" key Enter --selector 'textarea[placeholder="Message"]' >/dev/null 2>&1 || true
    sleep 4
    trap - EXIT
    b1_state || die "B1: state unreadable after submit retry" 1
    trap - EXIT
    [ "$COMPOSER" = "no" ] || die "B1: the composer did not clear — Enter was inert twice. Check the tab by hand ($B1_REF); if an approval card is pending, review it in the Muse UI." 1
  fi
  # Poll the delta: lastId+len stable twice wins; cap at $wait.
  local deadline=$((SECONDS + wait)) prev="" started=$SECONDS
  while [ $SECONDS -lt $deadline ]; do
    sleep 8
    if ! b1_state; then continue; fi
    if [ "$APPROVAL" = "yes" ]; then
      printf 'muse: note — a Muse approval appeared mid-reply; Muse may pause. Still waiting (max %ss total).\n' "$wait" >&2
    fi
    if [ -n "$prev" ] && [ "$LASTID" = "${prev%%|*}" ] && [ "$LEN" = "${prev##*|}" ] && [ "$LASTID" != "$base_id" ]; then
      break
    fi
    prev="$LASTID|$LEN"
  done
  if [ "$LASTID" = "$base_id" ]; then
    trap - EXIT
    die "B1: no reply within ${wait}s (submit WAS confirmed). The reply may still land — 'muse poll' re-reads the latest turn." 1
  fi
  local reply
  reply=$(bb_js '(function(){var a=document.querySelectorAll("[data-message-role=assistant]");var l=a[a.length-1];var turn=l.getAttribute("data-message-turn-id");var p=[];for(var i=0;i<a.length;i++){if(a[i].getAttribute("data-message-turn-id")===turn)p.push((a[i].innerText||"").trim())}return p.join("\n---\n")})()') || reply=""
  pace_mark
  b1_close
  trap - EXIT
  python3 - "$reply" "${ROUTED_TITLE:-Main chat}" "${ROUTED_PATH:-/}" <<'PYEOF'
import json, sys
print(json.dumps({"sent": True, "channel": "b1", "thread": sys.argv[2], "path": sys.argv[3], "reply": sys.argv[1]}))
PYEOF
}

# B1 poll: open a fresh tab, [route to the named side chat], read the LATEST
# assistant turn of THAT thread, close. Without --thread this reads Main chat
# (the open lands at https://muse.ai/ = Main chat, mapped live 2026-10-01).
cmd_poll_b1() {
  local thread="${1:-}"
  ROUTED_TITLE="" ROUTED_PATH=""
  b1_open
  trap 'b1_close' EXIT
  if [ -n "$thread" ]; then b1_route "$thread"; fi
  sleep 2
  b1_state || { "$BB_BIN" "$B1_REF" wake --wait 4000 >/dev/null 2>&1 || true; b1_state || die "B1: cannot read the chat state for a poll" 1; }
  if [ "$LASTID" = "none" ] || [ "$LEN" -eq 0 ] 2>/dev/null; then
    die "B1: no assistant messages readable in the feed${thread:+ (thread '$thread')}" 1
  fi
  local reply
  reply=$(bb_js '(function(){var a=document.querySelectorAll("[data-message-role=assistant]");var l=a[a.length-1];var turn=l.getAttribute("data-message-turn-id");var p=[];for(var i=0;i<a.length;i++){if(a[i].getAttribute("data-message-turn-id")===turn)p.push((a[i].innerText||"").trim())}return p.join("\n---\n")})()') || reply=""
  b1_close
  trap - EXIT
  python3 - "$LASTID" "$reply" "${ROUTED_TITLE:-Main chat}" "${ROUTED_PATH:-/}" <<'PYEOF'
import json, sys
print(json.dumps({"channel": "b1", "thread": sys.argv[3], "path": sys.argv[4], "lastId": sys.argv[1], "reply": sys.argv[2]}))
PYEOF
}

cmd_send_cli() {
  need_muse_cli
  local wait=120 thread="" force=0
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait)   wait="$2"; shift 2 ;;
      --thread) thread="$2"; shift 2 ;;
      --force)  force=1; shift ;;
      *)        args+=("$1"); shift ;;
    esac
  done
  [ ${#args[@]} -gt 0 ] || die "send needs task text: muse send \"<task>\"" 2
  [ "$force" -eq 1 ] || pace_check
  local task
  task=$(printf '%s ' "${args[@]}")
  local rc=0
  "$MUSE_CLI_BIN" send "$task" --wait "$wait" ${thread:+--thread "$thread"} || rc=$?
  if [ "$rc" -ne 0 ]; then
    b1_hint
    case $rc in 3) exit 3 ;; *) exit 1 ;; esac
  fi
  pace_mark
}

cmd_poll() {
  local use_cli=0 thread="" limit=3
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --thread) thread="$2"; shift 2 ;;
      --limit)  limit="$2"; shift 2 ;;
      --cli)    use_cli=1; shift ;;
      *)        args+=("$1"); shift ;;
    esac
  done
  if [ "$use_cli" -eq 1 ]; then
    need_muse_cli
    local rc=0
    "$MUSE_CLI_BIN" history --limit "$limit" ${thread:+--thread "$thread"} || rc=$?
    [ "$rc" -eq 0 ] || { b1_hint; exit 1; }
    return
  fi
  cmd_poll_b1 "$thread"
}

cmd_vm()   { need_muse_cli; exec "$MUSE_CLI_BIN" status; }

cmd_auth() {
  need_muse_cli
  local rc=0
  "$MUSE_CLI_BIN" auth "$@" || rc=$?
  if [ "$rc" -ne 0 ]; then
    cat >&2 <<'EOF'
muse: auth export failed. The one-time steps (muse-cli README "Log in once"):
  1. In the browser profile that holds the muse.ai login, enable remote
     debugging: open chrome://inspect/#remote-debugging (Brave honours the
     same switch) and tick "Allow remote debugging for this browser instance".
  2. In THAT window, open https://muse.ai/ and leave the tab focused.
  3. Run: muse-cli auth export   (cookies land in ~/.config/muse-cli/cookies.txt,
     mode 600 — muse-cli's own storage; nothing is echoed).
  4. Verify: muse vm   (JSON with your VM id == auth works).
  No-Node fallback: copy hatch_sess by hand from DevTools -> Application ->
  Cookies -> https://muse.ai into ~/.config/muse-cli/cookies.txt as
  "hatch_sess=<value>" (one line). Never paste it into chat, logs or a commit.
EOF
    exit 3
  fi
}

# --- cluster status (channel A) ---------------------------------------------
sops_bin() {
  if command -v sops >/dev/null 2>&1; then echo sops; return; fi
  mkdir -p "$STATE_DIR"
  local cache="$STATE_DIR/sops-bin"
  if [ ! -x "$cache" ]; then
    local out
    out=$(nix build nixpkgs#sops --print-out-paths 2>/dev/null | tail -1) || die "sops unavailable: install it or set SOPS_AGE_KEY_FILE with a sops on PATH" 4
    ln -sf "$out/bin/sops" "$cache"
  fi
  echo "$cache"
}

bridge_token() {
  local enc="$HOMELAB_REPO/$TOKEN_ENC_REL"
  [ -f "$enc" ] || die "bridge token secret not found at $enc (set MUSE_HOMELAB_REPO)" 4
  local key_file="$HOMELAB_REPO/.secrets/age.key"
  [ -f "$key_file" ] || die "age key not found at $key_file" 4
  local sb; sb=$(sops_bin)
  # The age key must reach sops as an env var — a bare sops call fails with
  # "no key" even though the key file exists (measured 2026-10-01).
  SOPS_AGE_KEY_FILE="$key_file" "$sb" -d --extract '["stringData"]["token"]' "$enc" 2>/dev/null
}

cmd_status() {
  local what="health" ns="muse"
  if [ $# -gt 0 ]; then
    case "$1" in
      health)    what="health" ;;
      nodes)     what="nodes" ;;
      pods)      what="pods"; [ $# -gt 1 ] && ns="$2" ;;
      workloads) what="workloads"; [ $# -gt 1 ] && ns="$2" ;;
      flux)      what="flux"; [ $# -gt 1 ] && ns="$2" ;;
      *)         what="pods"; ns="$1" ;;
    esac
  fi
  local url="$BRIDGE_URL/v1/$what"
  case "$what" in pods|workloads|flux) url="$url?ns=$ns" ;; esac
  local token; token=$(bridge_token) || die "could not decrypt bridge token" 4
  [ -n "$token" ] || die "bridge token decrypted empty" 4
  local rc=0
  curl -sS -m 15 -H "Authorization: Bearer $token" "$url" -w '\n[%{http_code}]' || rc=$?
  echo >&2
  [ "$rc" -eq 0 ] || die "bridge query failed (network)" 4
  # 401 = token rejected; 404 = route gone (API churn); both are answers, not outages.
}

