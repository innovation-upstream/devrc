#!/usr/bin/env bash
# muse — one command surface over the user's Meta Muse personal agent.
#
# Channels (design: homelab-talos claudedocs/muse-agent-integration-design.md):
#   B1  browser   — browser-bridge flows/muse.ai.md. PRIMARY (operator's call
#                   2026-10-01: Brave's remote-debugging toggle is unavailable
#                   for the muse-cli cookie export, and B1 is the design's
#                   default channel anyway).
#   B2  muse-cli  — programmatic (cookies -> HTTPS -> Noise-XX WS). Behind
#                   --cli; blocked on the cookie-export step working on Brave.
#   A   muse-bridge — READ-ONLY cluster status (public HTTPS + bearer token).
#
# Cookie handling is muse-cli's OWN storage only (~/.config/muse-cli/cookies.txt,
# mode 600). This wrapper never reads, copies, echoes or logs cookies. The
# browser-bridge deliberately has no cookie op — never add one. Never commit or
# send a cookie or the bridge token anywhere.
#
# Pacing: sends are human-paced (a few/hour, design §4-B2). The wrapper refuses
# a second send within $MUSE_MIN_SEND_GAP_MIN minutes (default 10) unless
# --force; the guard is a reminder, not a rate limiter. On BOTH channels it
# stamps as soon as delivery is POSSIBLE — B1 right after the first Enter, B2
# right after muse-cli returns, before either branches on success — so a
# failure after that point cannot leave a delivered message unstamped. The
# COST differs per channel and both halves are deliberate: on B1 a genuinely
# inert Enter also stamps; on B2 every failure stamps EXCEPT muse-cli's rc 2
# (AuthError — cookies expired), carved out because it provably never left
# this machine. ⚠ rc 2, NOT rc 3: rc 3 is GatewayError and MAY have sent.
# Read muse_cli/cli.py:713-721 before changing this; round 2 of #1976 had it
# backwards from the legend below, which is why that legend now says so. It
# refuses a non-integer gap rather than failing open, and is still bypassable
# by anything that can write $STATE_DIR/last-send — it is read from the
# stamp's MTIME, not its contents.
#
# Muse's per-host APPROVAL prompts are the OPERATOR's security gate. This
# wrapper never clicks Allow on any path, and ATTEMPTS to detect a pending
# approval and stop (exit 5).
# 🔴 THAT DETECTION IS NOT TRUSTWORTHY AND THIS COMMENT USED TO SAY IT WAS.
# b1_state (below) matches "Needs approval"/"Needs review"; the approval UI
# emits neither -- it shows "Allow Muse to access <host>?" and the toast
# "Review the approval request in chat to continue", and all four strings were
# measured ABSENT from the live DOM on 2026-10-01. So it has never been
# positive-controlled: no approval card has ever been observed to trip it.
# It also scans the ENTIRE transcript, so a conversation ABOUT approvals can
# pin exit 5 on permanently (2 "approv" hits were measured in the live feed).
# Rebuilding it structurally -- branching on a data-message-* attribute rather
# than on words -- needs one live approval card to map, so it stays open.
#
# Exit codes (THIS wrapper's, not muse-cli's): 0 ok · 1 dispatch failed (B1
# detail printed) · 2 usage/paced · 3 muse-cli auth needed · 4 bridge query
# failed · 5 operator approval pending.
# ⚠ muse-cli's OWN codes are DIFFERENT and this header was read as if they
# matched: muse-cli exits 2 on AuthError, 3 on GatewayError, 4 on Timeout
# (muse_cli/cli.py:713-721, v0.3.2). The wrapper maps muse-cli 2 -> its own
# 3. Do not assume the numbers line up — #1976 round 2 did, and shipped a
# pacing carve-out on the wrong failure class.
set -euo pipefail

MUSE_CLI_BIN=${MUSE_CLI:-muse-cli}
BB_BIN=${MUSE_BB:-$HOME/workspace/devrc/scripts/browser-bridge/browser}
HOMELAB_REPO=${MUSE_HOMELAB_REPO:-$HOME/workspace/homelab-talos}
BRIDGE_URL=${MUSE_BRIDGE_URL:-https://muse-bridge.zacx.dev}
MIN_SEND_GAP_MIN=${MUSE_MIN_SEND_GAP_MIN:-10}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/muse
TOKEN_ENC_REL=clusters/homelab/apps/muse/muse-bridge-token.enc.yaml
B1_INSTANCE=${MUSE_B1_INSTANCE:-personal}

usage() {
  cat <<'EOF'
muse — dispatch/poll the user's Muse agent; cluster status via muse-bridge.

  muse send "<task>" [--wait N] [--force] [--cli]   dispatch + await the reply
                                   B1 browser flow by default (--wait default
                                   180); --cli routes through muse-cli (needs
                                   its one-time cookie export) with --thread
  muse poll [--cli] [--limit N]                     latest assistant reply
                                   (--limit is the muse-cli path only; there is
                                   deliberately no --wait — poll reads once)
  muse status [ns|nodes|workloads <ns>|flux <ns>]   CLUSTER snapshot (A)
  muse vm                                           Muse VM/session status (B2)
  muse auth [export|...]                            muse-cli auth passthrough
  muse b1                                           the browser-flow recipe
  muse setup                                        runbook pointers

Env: MUSE_CLI, MUSE_BB, MUSE_HOMELAB_REPO, MUSE_BRIDGE_URL,
MUSE_MIN_SEND_GAP_MIN (0 disables the pacing guard), MUSE_B1_INSTANCE.
EOF
}

die() { printf 'muse: %s\n' "$1" >&2; exit "${2:-2}"; }

b1_hint() {
  cat >&2 <<'EOF'
muse: muse-cli failed — falling back to the B1 browser flow:
  BB=~/workspace/devrc/scripts/browser-bridge/browser
  $BB --instance personal open https://muse.ai   # your OWN tab; never the user's
  then follow $DEVRC/scripts/browser-bridge/flows/muse.ai.md exactly
  (snapshot -> type -> assert len -> Enter -> confirm -> poll the DELTA).
  Run `muse b1` for the full recipe. If the failure was 403/API churn, the
  internal APIs moved: re-derive per muse-cli docs, do NOT debug the bridge.
EOF
}

need_muse_cli() {
  command -v "$MUSE_CLI_BIN" >/dev/null 2>&1 || die "muse-cli not found. Install: uv tool install muse-cli (or pipx install muse-cli). Then 'muse auth export' — see 'muse setup'." 3
}

# --- B1 plumbing ------------------------------------------------------------
# bb_js <expr>: run a js op on the B1 tab (wake'd) and print result.data.value.
# Prints nothing and returns non-zero on an op failure.
bb_js() {
  "$BB_BIN" "$B1_REF" js "$1" --wake=3000 2>/dev/null \
    | python3 -c 'import json,sys
d=json.load(sys.stdin)
r=d.get("result") or {}
print((r.get("data") or {}).get("value",""),end="")'
}

# b1_state: one read of the live chat state, as shell vars.
# Sets: COMPOSER(yes/no) TALEN ASST UMSGS LASTID LEN APPROVAL
# 🔴 UMSGS, never USER: reading the user-message COUNT into `USER` clobbers the
# login-name env var, and assignment to an already-exported name KEEPS the
# export — so every subsequent $BB_BIN child inherited `USER=<a number>`.
# b1_state runs up to a dozen times per send. Measured 2026-10-01.
b1_state() {
  local v
  v=$(bb_js '(function(){var t=document.querySelector("textarea[placeholder=Message]");var a=document.querySelectorAll("[data-message-role=assistant]");var u=document.querySelectorAll("[data-message-role=user]");var l=a[a.length-1];var b=document.body.innerText;var na=b.indexOf("Needs approval")>=0||b.indexOf("Needs review")>=0;return JSON.stringify({c:!!t,tl:t?t.value.length:-1,a:a.length,u:u.length,id:l?l.getAttribute("data-message-id"):"none",len:l?(l.innerText||"").length:0,ap:na})})()') || return 1
  [ -n "$v" ] || return 1
  # Parse via argv (the value is never interpolated into code text); read the
  # six fields from a HERESTRING — a pipe's read block would run in a subshell
  # and lose every variable.
  local parsed
  parsed=$(python3 -c 'import json,sys
d=json.loads(sys.argv[1])
print("yes" if d["c"] else "no", d["tl"], d["a"], d["u"], d["id"], d["len"], "yes" if d["ap"] else "no")' "$v" 2>/dev/null) || return 1
  read -r COMPOSER TALEN ASST UMSGS LASTID LEN APPROVAL <<<"$parsed"
}

b1_open() {
  local out rc=0 tab
  # 🔴 `open` exits 3 when its --wake FOLLOW-UP fails — the tab still opened
  # (rc 1 = the whole command failed; rc 2/4 = bridge/instance problems). Parse
  # the JSON regardless; die only when there is no tabId.
  out=$("$BB_BIN" --instance "$B1_INSTANCE" open https://muse.ai --wake=4000 2>/dev/null) || rc=$?
  tab=$(printf '%s' "$out" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    print((d.get("result") or {}).get("data",{}).get("tabId",""))
except Exception:
    print("")') || tab=""
  if [ -z "$tab" ]; then
    die "browser-bridge could not open muse.ai on instance '$B1_INSTANCE' (\$BB whoami first). Is the bridge up? rc=${rc}" 1
  fi
  B1_REF="bw://laptop/$B1_INSTANCE/$tab"
  B1_TAB=$tab
}

b1_close() { [ -n "${B1_TAB:-}" ] && "$BB_BIN" "$B1_REF" close >/dev/null 2>&1 || true; }

# --- pacing guard -----------------------------------------------------------
pace_check() {
  # 🔴 FAIL CLOSED on a gap that is not an integer. Both tests below are
  # `[ … -eq/-lt … ]`, and a non-numeric operand makes `[` ERROR — which, inside
  # an `if`, is simply FALSE, so the guard fell through and ALLOWED the send.
  # Measured 2026-10-01: MUSE_MIN_SEND_GAP_MIN=10m printed "integer expected" on
  # stderr and then sent. Validated here, on the send path only, so a bad value
  # cannot also break `muse --help` / `b1` / `setup`.
  case "$MIN_SEND_GAP_MIN" in
    ''|*[!0-9]*) die "MUSE_MIN_SEND_GAP_MIN must be a non-negative integer (minutes); got '$MIN_SEND_GAP_MIN'. Use 0 to disable the pacing guard deliberately." 2 ;;
  esac
  [ "$MIN_SEND_GAP_MIN" -eq 0 ] && return 0
  mkdir -p "$STATE_DIR"
  local stamp="$STATE_DIR/last-send"
  if [ -f "$stamp" ]; then
    local last now diff_min
    last=$(stat -c %Y "$stamp" 2>/dev/null || echo 0)
    now=$(date +%s)
    diff_min=$(( (now - last) / 60 ))
    if [ "$diff_min" -lt "$MIN_SEND_GAP_MIN" ]; then
      die "last send was ${diff_min}m ago (pacing: >=${MIN_SEND_GAP_MIN}m between sends, human-paced per design §4-B2). Use --force to override deliberately." 2
    fi
  fi
}

pace_mark() { mkdir -p "$STATE_DIR"; date +%s > "$STATE_DIR/last-send"; }

# --- verbs ------------------------------------------------------------------
cmd_send() {
  local wait=180 force=0 use_cli=0
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait)   wait="$2"; shift 2 ;;
      --thread) use_cli=1; thread="$2"; shift 2 ;;
      --force)  force=1; shift ;;
      --cli)    use_cli=1; shift ;;
      *)        args+=("$1"); shift ;;
    esac
  done
  [ ${#args[@]} -gt 0 ] || die "send needs task text: muse send \"<task>\"" 2
  [ "$force" -eq 1 ] || pace_check
  # 🔴 Forward --force. It used to be consumed here and NOT passed on, so
  # cmd_send_cli re-initialised force=0 and ran pace_check a SECOND time:
  # `muse send --force --cli "x"` was refused with exit 2 despite the
  # documented override, while the un-forced --cli path paced twice. Found by
  # #1976 round 1.
  # ⚠ An explicit test, NOT `${force:+--force}`: force is the STRING "0" or
  # "1", and `:+` expands on non-EMPTY, so the `:+` form passes --force when
  # force=0 — inverting the flag it was meant to forward.
  #
  # ⚠ NO TEST KILLS THAT INVERSION, AND THAT IS CORRECT — it is an EQUIVALENT
  # MUTANT, measured in #1976 round 2: swapping this to `[ -n "$force" ]`
  # produces identical rc AND identical muse-cli reachability on all four
  # (stamp × --force) combinations. The reason is that cmd_send's own
  # pace_check above is AUTHORITATIVE — by the time we get here a force=0 call
  # has already been gated — so cmd_send_cli's second pace_check is redundant
  # and skipping it changes nothing. Keep the correct spelling anyway: the
  # redundancy is not guaranteed to survive a refactor, and the next reader
  # should not learn the wrong idiom from working code. Do NOT add a test to
  # force a kill here; it would be asserting an implementation detail that has
  # no observable consequence. The duplicated gate is a "one rule, one place"
  # smell worth consolidating separately.
  # ⚠ if/fi, not `[ … ] && fwd=(…)`: a failing `&&` list as a function's last
  # statement returns non-zero. And `${fwd[@]+…}` guards an EMPTY array under
  # `set -u` on bash < 4.4.
  local fwd=()
  if [ "$force" -eq 1 ]; then fwd=(--force); fi
  if [ "$use_cli" -eq 1 ]; then cmd_send_cli "${args[@]}" --wait "$wait" ${fwd[@]+"${fwd[@]}"} ${thread:+--thread "$thread"}; return; fi
  cmd_send_b1 "${args[@]}" "$wait"
}

# B1 send: open own tab -> gate checks -> type/assert -> Enter/confirm -> poll
# the delta -> close. Never auto-approves: a pending Muse approval is the
# operator's security gate and stops the wrapper (exit 5).
cmd_send_b1() {
  local task="$1"; shift
  local wait="${1:-180}"
  b1_open
  trap 'b1_close' EXIT
  # 🔴 The composer mounts BEFORE the feed hydrates: a fresh hidden tab can
  # read composer=yes with a skeleton feed (measured 2026-10-01), and Enter
  # into that shell does nothing. Gate the send on the FEED having nodes.
  sleep 2
  if ! b1_state; then
    "$BB_BIN" "$B1_REF" wake --wait 4000 >/dev/null 2>&1 || true
    b1_state || die "B1: cannot read the muse.ai chat state (composer/feed) in the new tab — see 'muse b1' to drive it by hand. Tab left open: $B1_REF" 1
  fi
  local hydrate_deadline=$((SECONDS + 20))
  while [ "$ASST" -eq 0 ] && [ "$UMSGS" -eq 0 ] && [ $SECONDS -lt $hydrate_deadline ]; do
    sleep 3
    "$BB_BIN" "$B1_REF" wake --wait 3000 >/dev/null 2>&1 || true
    b1_state || true
  done
  if [ "$ASST" -eq 0 ] && [ "$UMSGS" -eq 0 ]; then
    trap - EXIT
    die "B1: the feed never hydrated (0 messages after 20s) — the tab is stuck on a shell DOM. Tab left open: $B1_REF (wake it / reload, then re-run)." 1
  fi
  if ! b1_state; then
    "$BB_BIN" "$B1_REF" wake --wait 4000 >/dev/null 2>&1 || true
    b1_state || die "B1: cannot read the muse.ai chat state (composer/feed) in the new tab — see 'muse b1' to drive it by hand." 1
  fi
  if [ "$APPROVAL" = "yes" ]; then
    trap - EXIT
    die "B1: a Muse APPROVAL is pending (the chat shows 'Needs approval'). The composer is gated while it waits — review it in the Muse UI (your security gate; this wrapper never clicks Allow), then re-run. Tab left open: $B1_REF" 5
  fi
  if [ "$COMPOSER" != "yes" ]; then
    "$BB_BIN" "$B1_REF" wake --wait 5000 >/dev/null 2>&1 || true
    b1_state || true
    trap - EXIT
    [ "$COMPOSER" = "yes" ] || die "B1: no composer mounted (the app may be in an error state — reload https://muse.ai in tab $B1_REF and re-run)." 1
  fi
  local base_asst=$ASST base_umsgs=$UMSGS base_id=$LASTID base_len=$LEN
  "$BB_BIN" "$B1_REF" type "$task" --selector 'textarea[placeholder="Message"]' >/dev/null 2>&1 || die "B1: the type op failed" 1
  local got rc=1
  for attempt in 1 2; do
    got=$(bb_js '(function(){var t=document.querySelector("textarea[placeholder=Message]");return t?("len="+t.value.length):"gone"})()') || got="gone"
    [ "$got" = "len=${#task}" ] && rc=0 && break
    "$BB_BIN" "$B1_REF" wake --wait 3000 >/dev/null 2>&1 || true
    "$BB_BIN" "$B1_REF" type "$task" --selector 'textarea[placeholder="Message"]' >/dev/null 2>&1 || true
  done
  trap - EXIT
  [ "$rc" -eq 0 ] || die "B1: the composer did not take the typed text after retry (got '${got:-?}', wanted len=${#task}). Re-throttled tab or a UI change — see 'muse b1'." 1
  "$BB_BIN" "$B1_REF" key Enter --selector 'textarea[placeholder="Message"]' >/dev/null 2>&1 || true
  # 🔴 STAMP THE MOMENT DELIVERY BECOMES POSSIBLE — i.e. right after the first
  # Enter, not after the submit is CONFIRMED. Everything between here and the
  # confirmation can `die`, and two paths did: the two `state unreadable`
  # exits below both leave a possibly-delivered message unstamped, so a caller
  # retrying on exit 1 re-sends with no gap. #1976 round 1 found that the
  # previous placement's own comment asserted an invariant — "a send that
  # submits has still DELIVERED" — that those paths broke.
  # ⚠ THE TRADE IS DELIBERATE AND COSTS SOMETHING: an Enter that really was
  # inert now also stamps, so a legitimate immediate retry is refused for
  # $MIN_SEND_GAP_MIN. That is the correct direction for a guard whose whole
  # job is to stop a loop spamming the operator's account — fail CLOSED — and
  # --force is the documented override (which now actually works on both
  # channels; it did not before this round).
  pace_mark
  sleep 4
  if ! b1_state; then "$BB_BIN" "$B1_REF" wake --wait 3000 >/dev/null 2>&1 || true; b1_state || die "B1: state unreadable right after submit" 1; fi
  # "Cleared" = the composer VALUE is empty (the element itself always stays
  # mounted — checking its existence is how Enter #1 was misread as inert,
  # measured 2026-10-01) AND a new user node appeared.
  if [ "$TALEN" -ne 0 ] || [ "$UMSGS" -le "$base_umsgs" ] 2>/dev/null; then
    # Inert Enter (re-throttled tab) — re-wake and submit once more.
    "$BB_BIN" "$B1_REF" wake --wait 3000 >/dev/null 2>&1 || true
    "$BB_BIN" "$B1_REF" key Enter --selector 'textarea[placeholder="Message"]' >/dev/null 2>&1 || true
    sleep 4
    trap - EXIT
    b1_state || die "B1: state unreadable after submit retry" 1
    # 🔴 Re-check the SAME two signals the first check used (value emptied AND a
    # new user node). This line used to test `[ "$COMPOSER" = "no" ]` — whether
    # the textarea ELEMENT was gone — which the comment above says never
    # happens, so it could only ever fail: every send that took the retry path
    # died claiming "inert twice" even when the retry had worked. The 2026-10-01
    # fix was applied to the first check and not to this one.
    if [ "$TALEN" -ne 0 ] || [ "$UMSGS" -le "$base_umsgs" ] 2>/dev/null; then
      die "B1: the composer did not clear — Enter was inert twice. Check the tab by hand ($B1_REF); if an approval card is pending, review it in the Muse UI." 1
    fi
  fi
  # (The pacing stamp already fired, right after the first Enter above — see
  # the note there for why it is keyed to POSSIBLE delivery rather than to a
  # confirmed submit or a successful round-trip.)
  # Poll the delta: lastId+len stable twice wins; cap at $wait.
  local deadline=$((SECONDS + wait)) prev="" started=$SECONDS
  while [ $SECONDS -lt $deadline ]; do
    sleep 8
    if ! b1_state; then continue; fi
    if [ "$APPROVAL" = "yes" ]; then
      printf 'muse: note — a Muse approval appeared mid-reply; Muse may pause. Still waiting (max %ss total).\n' "$wait" >&2
    fi
    if [ -n "$prev" ] && [ "$LASTID" = "${prev%%|*}" ] && [ "$LEN" = "${prev##*|}" ] && [ "$LASTID" != "$base_id" ]; then
      break
    fi
    prev="$LASTID|$LEN"
  done
  if [ "$LASTID" = "$base_id" ]; then
    trap - EXIT
    die "B1: no reply within ${wait}s (submit WAS confirmed). The reply may still land — 'muse poll' re-reads the latest turn." 1
  fi
  local reply
  reply=$(bb_js '(function(){var a=document.querySelectorAll("[data-message-role=assistant]");var l=a[a.length-1];var turn=l.getAttribute("data-message-turn-id");var p=[];for(var i=0;i<a.length;i++){if(a[i].getAttribute("data-message-turn-id")===turn)p.push((a[i].innerText||"").trim())}return p.join("\n---\n")})()') || reply=""
  b1_close
  trap - EXIT
  python3 - "$reply" <<'PYEOF'
import json, sys
print(json.dumps({"sent": True, "channel": "b1", "reply": sys.argv[1]}))
PYEOF
}

# B1 poll: open a fresh tab, read the LATEST assistant turn, close.
cmd_poll_b1() {
  b1_open
  trap 'b1_close' EXIT
  sleep 2
  b1_state || { "$BB_BIN" "$B1_REF" wake --wait 4000 >/dev/null 2>&1 || true; b1_state || die "B1: cannot read the chat state for a poll" 1; }
  if [ "$LASTID" = "none" ] || [ "$LEN" -eq 0 ] 2>/dev/null; then
    die "B1: no assistant messages readable in the feed" 1
  fi
  local reply
  reply=$(bb_js '(function(){var a=document.querySelectorAll("[data-message-role=assistant]");var l=a[a.length-1];var turn=l.getAttribute("data-message-turn-id");var p=[];for(var i=0;i<a.length;i++){if(a[i].getAttribute("data-message-turn-id")===turn)p.push((a[i].innerText||"").trim())}return p.join("\n---\n")})()') || reply=""
  b1_close
  trap - EXIT
  python3 - "$LASTID" "$reply" <<'PYEOF'
import json, sys
print(json.dumps({"channel": "b1", "lastId": sys.argv[1], "reply": sys.argv[2]}))
PYEOF
}

cmd_send_cli() {
  need_muse_cli
  local wait=120 thread="" force=0
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait)   wait="$2"; shift 2 ;;
      --thread) thread="$2"; shift 2 ;;
      --force)  force=1; shift ;;
      *)        args+=("$1"); shift ;;
    esac
  done
  [ ${#args[@]} -gt 0 ] || die "send needs task text: muse send \"<task>\"" 2
  [ "$force" -eq 1 ] || pace_check
  local task
  task=$(printf '%s ' "${args[@]}")
  local rc=0
  "$MUSE_CLI_BIN" send "$task" --wait "$wait" ${thread:+--thread "$thread"} || rc=$?
  # 🔴 Stamp on ATTEMPT, before branching on rc — EXCEPT rc 3. muse-cli's
  # `send` combines delivery and the reply wait, so MOST non-zero rcs cannot
  # distinguish "never sent" from "sent, then the wait failed", and in the
  # second case a message HAS reached Meta. Stamping only on rc==0 left the
  # gate unmarked there, so a caller retrying on exit 1 re-sent with no gap:
  # the same defect this PR fixed on B1, still live on B2 (#1976 round 1).
  #
  # ⚠ ONE rc IS distinguishable — the AUTH one — and it is rc 2, NOT rc 3.
  # 🔴 READ FROM muse-cli's SOURCE, not from its exit-code folklore
  # (muse_cli/cli.py:713-721, muse-cli 0.3.2):
  #     except AuthError    -> sys.exit(2)      cookies expired; NEVER sent
  #     except GatewayError -> sys.exit(3)      stream reset / non-2xx / api
  #                                             error; MAY have sent
  #     except TimeoutError -> sys.exit(4)      MAY have sent
  # gateway.py raises AuthError for exactly the motivating case ("cookies
  # expired? re-export") and GatewayError for VM-unavailable, commented
  # "Not an auth problem, so say so" — muse-cli draws the distinction we need.
  #
  # Round 2 carved out rc 3 believing it was auth. That was backwards and
  # measured so by #1976 round 3: the expired cookie (rc 2) still stamped —
  # the exact regression round 2 said it had removed — while a gateway error,
  # which is in the AMBIGUOUS class that must stamp, did not. Both halves
  # wrong, from one mislabel. The `3 muse-cli auth needed` legend in this
  # file's header predates the PR and is what the mislabel was read from;
  # it is corrected above, because round 2 made it load-bearing.
  if [ "$rc" -ne 2 ]; then pace_mark; fi
  if [ "$rc" -ne 0 ]; then
    b1_hint
    # Surface auth as the wrapper's own exit 3 ("muse-cli auth needed"), which
    # is what `muse auth export` answers. Everything else is exit 1.
    case $rc in 2) exit 3 ;; *) exit 1 ;; esac
  fi
}

cmd_poll() {
  local use_cli=0 thread="" limit=3
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --thread) use_cli=1; thread="$2"; shift 2 ;;
      --limit)  limit="$2"; shift 2 ;;
      --cli)    use_cli=1; shift ;;
      *)        args+=("$1"); shift ;;
    esac
  done
  if [ "$use_cli" -eq 1 ]; then
    need_muse_cli
    local rc=0
    "$MUSE_CLI_BIN" history --limit "$limit" ${thread:+--thread "$thread"} || rc=$?
    [ "$rc" -eq 0 ] || { b1_hint; exit 1; }
    return
  fi
  cmd_poll_b1
}

cmd_vm()   { need_muse_cli; exec "$MUSE_CLI_BIN" status; }

cmd_auth() {
  need_muse_cli
  local rc=0
  "$MUSE_CLI_BIN" auth "$@" || rc=$?
  if [ "$rc" -ne 0 ]; then
    cat >&2 <<'EOF'
muse: auth export failed. The one-time steps (muse-cli README "Log in once"):
  1. In the browser profile that holds the muse.ai login, enable remote
     debugging: open chrome://inspect/#remote-debugging (Brave honours the
     same switch) and tick "Allow remote debugging for this browser instance".
  2. In THAT window, open https://muse.ai/ and leave the tab focused.
  3. Run: muse-cli auth export   (cookies land in ~/.config/muse-cli/cookies.txt,
     mode 600 — muse-cli's own storage; nothing is echoed).
  4. Verify: muse vm   (JSON with your VM id == auth works).
  No-Node fallback: copy hatch_sess by hand from DevTools -> Application ->
  Cookies -> https://muse.ai into ~/.config/muse-cli/cookies.txt as
  "hatch_sess=<value>" (one line). Never paste it into chat, logs or a commit.
EOF
    exit 3
  fi
}

# --- cluster status (channel A) ---------------------------------------------
sops_bin() {
  if command -v sops >/dev/null 2>&1; then echo sops; return; fi
  mkdir -p "$STATE_DIR"
  local cache="$STATE_DIR/sops-bin"
  if [ ! -x "$cache" ]; then
    local out
    out=$(nix build nixpkgs#sops --print-out-paths 2>/dev/null | tail -1) || die "sops unavailable: install it or set SOPS_AGE_KEY_FILE with a sops on PATH" 4
    ln -sf "$out/bin/sops" "$cache"
  fi
  echo "$cache"
}

bridge_token() {
  local enc="$HOMELAB_REPO/$TOKEN_ENC_REL"
  [ -f "$enc" ] || die "bridge token secret not found at $enc (set MUSE_HOMELAB_REPO)" 4
  local key_file="$HOMELAB_REPO/.secrets/age.key"
  [ -f "$key_file" ] || die "age key not found at $key_file" 4
  local sb; sb=$(sops_bin)
  # The age key must reach sops as an env var — a bare sops call fails with
  # "no key" even though the key file exists (measured 2026-10-01).
  SOPS_AGE_KEY_FILE="$key_file" "$sb" -d --extract '["stringData"]["token"]' "$enc" 2>/dev/null
}

cmd_status() {
  local what="health" ns="muse"
  if [ $# -gt 0 ]; then
    case "$1" in
      health)    what="health" ;;
      nodes)     what="nodes" ;;
      pods)      what="pods"; [ $# -gt 1 ] && ns="$2" ;;
      workloads) what="workloads"; [ $# -gt 1 ] && ns="$2" ;;
      flux)      what="flux"; [ $# -gt 1 ] && ns="$2" ;;
      *)         what="pods"; ns="$1" ;;
    esac
  fi
  local url="$BRIDGE_URL/v1/$what"
  case "$what" in pods|workloads|flux) url="$url?ns=$ns" ;; esac
  local token; token=$(bridge_token) || die "could not decrypt bridge token" 4
  [ -n "$token" ] || die "bridge token decrypted empty" 4
  local rc=0
  # 🔴 The header goes in on STDIN, never as argv. `-H "Authorization: Bearer
  # $token"` put the bearer token in curl's command line, and MEASURED on this
  # host /proc is mounted without `hidepid` with /proc/<pid>/cmdline mode 0444 —
  # so for up to 15s per call ANY local process under ANY user could read a
  # token that grants cluster-wide read. Measured 2026-10-01.
  #
  # 🔴 `-H @-`, NOT `--config -`. Both keep the token off argv, but `--config`
  # applies C-ESCAPE PROCESSING inside a quoted value, so it CORRUPTS the token
  # it is protecting: measured against a loopback echo server (curl 8.21.0), a
  # token containing `"` is SILENTLY TRUNCATED at the quote (`aaa"bbb` sends
  # `Bearer aaa`), a `\` is swallowed, and `\t` becomes a literal tab. rc stays
  # 0 and the bridge answers 401 — which the comment below reads as "token
  # rejected", sending the next reader after a credential problem that does not
  # exist. `-H @-` passes the line VERBATIM. Found by #1976 round 1.
  # ⚠ The unquoted `--config` spelling (`header = Authorization: …`) sends NO
  # header at all — also measured. Do not "simplify" back to either form.
  printf 'Authorization: Bearer %s\n' "$token" \
    | curl -sS -m 15 -H @- "$url" -w '\n[%{http_code}]' || rc=$?
  echo >&2
  [ "$rc" -eq 0 ] || die "bridge query failed (network)" 4
  # 401 = token rejected; 404 = route gone (API churn); both are answers, not outages.
}

cmd_setup() {
  cat <<'EOF'
muse setup — runbook pointers
  design + phases ........ $MUSE_HOMELAB_REPO/claudedocs/muse-agent-integration-design.md
  current state .......... $MUSE_HOMELAB_REPO/claudedocs/handoff-muse-agent-integration.md
  public path + DNS ...... $MUSE_HOMELAB_REPO/claudedocs/nebula-production-to-homelab-routing.md
  B1 browser flow ........ $DEVRC/scripts/browser-bridge/flows/muse.ai.md
  B2 install ............. uv tool install muse-cli   (command is `muse-cli`)
  B2 auth (one-time) ..... muse auth export  (steps in `muse auth` failure output)
  bridge token ........... sops in $MUSE_HOMELAB_REPO/$TOKEN_ENC_REL (never echo)
  connector (Muse side) .. wired 2026-10-01: custom.homelab-bridge, live test passed
EOF
}

cmd_b1() {
  cat <<'EOF'
muse B1 — browser-flow fallback (when muse-cli is broken: 403, API churn, cookie expiry)

BB=~/workspace/devrc/scripts/browser-bridge/browser
$BB --instance personal open https://muse.ai      # OWN tab; close it when done
REF=bw://laptop/personal/<tabId>

# 0. baseline (delta discriminator: id + len, NEVER the node count alone —
#    the feed re-keys nodes and keeps counts flat)
$BB $REF js '(function(){var a=document.querySelectorAll("[data-message-role=assistant]");var l=a[a.length-1];return "asst="+a.length+" lastId="+(l?l.getAttribute("data-message-id"):"none")})()' --wake=3000

# 1. type + ASSERT it took
$BB $REF type "<task>" --selector 'textarea[placeholder="Message"]'
$BB $REF js '(function(){var t=document.querySelector("textarea[placeholder=Message]");return "len="+(t?t.value.length:"gone")})()' --wake=3000

# 2. submit + confirm (no form/button exists — Enter only)
$BB $REF key Enter --selector 'textarea[placeholder="Message"]'
sleep 4
$BB $REF js '(function(){var t=document.querySelector("textarea[placeholder=Message]");return "taLen="+(t?t.value.length:"gone")})()' --wake=3000

# 3. poll the newest TURN only; stable (same id+len) twice = done
# 4. extract delta: assistant nodes sharing the last data-message-turn-id

🔴 Gotchas measured 2026-10-01:
- Muse's per-host APPROVAL GATES block the composer: while a "Needs approval"
  card is pending, Enter is INERT (toast: "Review the approval request in
  chat to continue"). Open the review panel / inline card and Allow first,
  or the send will silently not happen. "Always allow this site" covers the
  host's subdomains.
- A re-throttled background tab reads exactly like silence: re-wake, re-type,
  re-Enter before concluding Muse failed.
- Full details + re-map procedure: flows/muse.ai.md.
EOF
}

case "${1:-}" in
  send)   shift; cmd_send "$@" ;;
  poll)   shift; cmd_poll "$@" ;;
  status) shift; cmd_status "$@" ;;
  vm)     shift; cmd_vm ;;
  auth)   shift; cmd_auth "$@" ;;
  b1)     cmd_b1 ;;
  setup)  cmd_setup ;;
  help|--help|-h) usage ;;
  "")     usage ;;
  *)      die "unknown verb: $1 (see: muse help)" 2 ;;
esac
