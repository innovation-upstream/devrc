# route_core.js once shipped with literal NUL bytes, so git classified it as
# binary and `gh pr diff` printed "Binary files differ" instead of the module
# holding the suggest() ladder. tests/source_hygiene.test.mjs now rejects a
# control byte in any extension source; this belt-and-braces attribute makes
# git diff these as text regardless, so a regression is visible in review
# rather than hidden by it.
*.js    text diff
*.mjs   text diff
*.py    text diff
*.md    text diff
*.toml  text diff
*.json  text diff
