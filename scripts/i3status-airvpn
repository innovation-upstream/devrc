#!/usr/bin/env python3
"""i3status-rust custom block: the HOST-level AirVPN WireGuard tunnel.

Reads the cache file written by scripts/bar-status-poll (the `airvpn` source) and
emits ONE i3status-rust JSON line. INSTANT local file read — CREDENTIAL-FREE,
never touches the network, never blocks the bar. All the fetch/verify lives in the
poller; this block only renders the FACTS parse_airvpn wrote.

This is the WHOLE-HOST AirVPN tunnel (the workbench routes through AirVPN),
REPLACING the decommissioned host Mullvad block. It is SEPARATE from the qBit-pod
AirVPN tunnel (that is the `media` block) — do not confuse the two.

Display philosophy: a MINIMAL icon button that matches the rest of the bar's
icon+token blocks — the `net_vpn` glyph carries the identity, a short token carries
the state, and colour is reserved for things that need ATTENTION (a deliberately-
toggled tunnel is NOT an alarm). No prose ("VPN off"/"AirVPN …") on the pill; the
full status line lives in the menu header + the detail TUI.
  tunnel DOWN (the default-off steady state)      -> dim NEUTRAL icon ONLY (no text)
      (deliberately rendered, NOT hidden: the icon is the left-click target that
       opens the menu to Connect — a hidden pill can't be clicked.)
  tunnel UP + exit-IP verified as the tunnel      -> NEUTRAL `<icon> CC` (e.g. `CA`)
  tunnel UP + exit-IP could not be verified        -> NEUTRAL `<icon> CC?`
       (unknown != leak; don't cry wolf on a transient ipinfo failure)
  tunnel UP + LEAK detected (exit IP is the host's real ISP IP / home country)
                                                   -> RED (Critical) `<icon> LEAK`
       (a leak IS worth crying about — the whole point of the killswitch)
  tunnel UP + forwarded port configured but DOWN   -> YELLOW (Warning) `<icon> CC!`
  poller stale / error / missing / corrupt cache   -> soft-yellow icon ONLY (Warning),
       never red (avoid crying wolf on a transient poller hiccup)
  a cache the poller STOPPED REFRESHING            -> the same soft-yellow icon

The left-click (airvpn-menu) and right-click (airvpn-detail float term) are wired
in graphical.nix, not here.

🔴 THE LAST OF THOSE IS NEW, AND IT WAS THE INVISIBLE ONE. This block always
alarmed rather than hid on a stale marker, so it looked immune to the bar-wide
"an outage renders as healthy" defect — but nothing here read the `ts` the poller
stamps on every payload. When `bar-status-poll` stopped, the last reading simply
stayed on screen. That is worse here than on a count pill: the steady state is
`up: false` -> a dim neutral icon, so a dead poller pins this block to "tunnel
deliberately off" — and the state it is pinned AWAY from is `LEAK`, the one
condition the killswitch exists to make loud.
"""
import importlib.machinery
import importlib.util
import json
import os
import sys
import time

NAME = "airvpn"
ICON = "net_vpn"          # deliberately DIFFERS from the media block's net_down
_VALID_STATES = ("Idle", "Info", "Good", "Warning", "Critical")
# Soft-yellow "status unknown" pill: the poller couldn't determine tunnel state,
# OR the cache is missing/corrupt/stale. NOT red (transient), NOT hidden.
# Icon-ONLY pills (minimal, match the rest of the bar): the glyph is the whole
# button — off is dim/neutral, stale is soft-yellow. Empty text renders just the icon.
_STALE = {"icon": ICON, "text": "", "short_text": "", "state": "Warning"}
_OFF = {"icon": ICON, "text": "", "short_text": "", "state": "Idle"}


def _load_freshness():
    """Load the co-located `bar_freshness.py` sibling by EXPLICIT PATH.

    Extensionless block scripts cannot be a package, so this is the repo's
    standard sibling-module shape (cf. `notif-center` loading `i3status-notifs`,
    `bar-status-poll` loading `scripts/lib/`). Deliberately NOT wrapped in a
    try: a block that cannot load the freshness predicate cannot know whether
    its cache is current, and `__main__` below turns that into the VISIBLE
    soft-yellow pill rather than a confident tunnel state. `dont_write_bytecode`
    keeps a `__pycache__` out of the operator's ~/.config/i3status-rust/scripts.
    """
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "bar_freshness.py")
    loader = importlib.machinery.SourceFileLoader("_bar_freshness", path)
    spec = importlib.util.spec_from_loader("_bar_freshness", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


fresh = _load_freshness()


def cache_path() -> str:
    base = os.environ.get("BAR_STATUS_DIR") or os.path.join(
        os.path.expanduser("~"), ".cache", "bar-status")
    return os.path.join(base, NAME + ".json")


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def _cc(payload) -> str:
    """Short country label for the pill: the connected SERVER's country_code (else
    its name), falling back to the observed EXIT country when the server's is unknown
    (a hostname endpoint like `ca3.vpn.airdns.org` doesn't map to a manifest server,
    so `country_code` is null while ipinfo still gives us `exit_country`). Without the
    fallback the active pill renders a useless `??`."""
    cc = payload.get("country_code")
    if isinstance(cc, str) and cc.strip():
        return cc.strip().upper()[:3]
    name = payload.get("country")
    if isinstance(name, str) and name.strip():
        return name.strip()[:2].upper()
    exit_cc = payload.get("exit_country")
    if isinstance(exit_cc, str) and exit_cc.strip():
        return exit_cc.strip().upper()[:3]
    return "??"


def render(payload, now=None) -> dict:
    """Pure: cache payload (facts written by parse_airvpn) -> i3status-rust block.

    A MINIMAL icon button. NOT MEASURED — None / malformed / stale / error / a
    `ts` that is absent, junk or older than `bar_freshness.MAX_CACHE_AGE_SECS`
    -> soft-yellow icon only. Tunnel down -> dim icon only. Up: neutral `CC`
    (verified) / `CC?` (unknown), RED `LEAK`, yellow `CC!` on a down forwarded
    port. Colour is reserved for the leak (critical) + port-down (warning)
    attention cases; the verbose status line lives in the menu header + detail
    TUI, not the pill.

    🔴 THE FRESHNESS GATE COMES BEFORE THE `up` CHECK, and the order is the whole
    point: `not up` is the DIM NEUTRAL steady state, so a stale cache falling
    through to it would render "deliberately off" for a tunnel nobody has
    measured — including one that is up and leaking.

    `now` is injected rather than read here so the gate is testable without
    sleeping; it defaults to the wall clock. Fail-safe throughout: it never
    raises, whatever the file contains — a claim only a DIRECT call can test,
    since `__main__` below prints the soft-yellow pill for any exception.
    """
    now = time.time() if now is None else now
    # missing / corrupt cache, a poller that ran but could not decide, and a
    # poller that stopped writing altogether — one predicate, one answer.
    # `state == "error"` is kept as its own term: `bar_freshness.is_marker`
    # matches `stale` plus a truthy `error` KEY, and narrowing this block to
    # that would be a behaviour change smuggled in as a refactor.
    if fresh.unmeasured(payload, now) or payload.get("state") == "error":
        return dict(_STALE)
    if not payload.get("up"):
        return dict(_OFF)                          # default-off steady state

    cc = _cc(payload)
    verdict = payload.get("verdict")
    if verdict == "leak":
        return {"icon": ICON, "text": "LEAK",
                "short_text": "LEAK", "state": "Critical"}

    fwd = payload.get("fwd_verdict")
    if fwd == "down":
        return {"icon": ICON, "text": "%s!" % cc,
                "short_text": "%s!" % cc, "state": "Warning"}

    # verified or unknown -> neutral. Unknown gets a subtle '?' but stays calm.
    mark = "" if verdict == "verified" else "?"
    text = "%s%s" % (cc, mark)
    return {"icon": ICON, "text": text, "short_text": text, "state": "Idle"}


def main() -> int:
    sys.stdout.write(json.dumps(render(load(cache_path()))) + "\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        # A bar block must never crash loudly — fall back to the soft-yellow pill.
        sys.stdout.write(json.dumps(_STALE) + "\n")
        sys.exit(0)
